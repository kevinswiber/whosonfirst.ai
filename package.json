{
  "name": "whosonfirst-ai",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN README.md",
  "repository": "github:kevinswiber/whosonfirst.ai",
  "homepage": "https://whosonfirst.ai",
  "description": "Who’s on First: a field guide to agent authentication and authorization.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "biome check",
    "fmt": "biome check --write",
    "test": "astro check && node scripts/rating-check.mjs && node scripts/contrast-check.mjs",
    "check:types": "astro check",
    "check:rating": "node scripts/rating-check.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:rendered": "node scripts/rendered-check.mjs",
    "readme:figure": "node scripts/readme-figure.mjs",
    "social:assets": "node scripts/social-assets.mjs",
    "sources:changed": "node scripts/source-changes.mjs",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/mdx": "^8.1.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.8",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "axe-core": "4.14.0",
    "playwright": "1.63.0",
    "wrangler": "^4.160.0"
  }
}
