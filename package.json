{
  "name": "whosonfirst-ai",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN README.md",
  "repository": "github:kevinswiber/whosonfirst.ai",
  "homepage": "https://whosonfirst.ai",
  "description": "Who’s on First: a field guide to agent authentication and authorization.",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "preview": "npm run build && astro preview --port 8787",
    "check": "biome check",
    "fmt": "biome check --write",
    "test": "astro check && node --test --test-reporter=spec \"test/unit/*.test.mjs\"",
    "check:types": "astro check",
    "check:rating": "node --test --test-reporter=spec test/unit/rating.test.mjs",
    "check:contrast": "node --test --test-reporter=spec test/unit/contrast.test.mjs",
    "check:sources": "node --test --test-reporter=spec test/unit/sources.test.mjs",
    "check:rendered": "node scripts/built-site.mjs && node --test --test-reporter=spec \"test/build/*.test.mjs\" \"test/browser/*.test.mjs\" \"test/worker/*.test.mjs\"",
    "readme:figure": "node scripts/readme-figure.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "sources:changed": "node scripts/source-changes.mjs",
    "standards:citations": "node scripts/citations.mjs",
    "implementations:coverage": "node scripts/implementation-coverage.mjs",
    "implementations:check": "node scripts/implementation-check.mjs",
    "generate-types": "cf workers types",
    "deploy": "cf deploy",
    "search:sync": "node scripts/sync-search.mjs",
    "search:build": "npm --prefix workers/search run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^15.0.0-beta.6",
    "@astrojs/mdx": "^8.1.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.13",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.0 || ^26.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@mmds/wasm": "2.6.1",
    "axe-core": "4.14.0",
    "cf": "^1.0.0-rc.1",
    "playwright": "1.63.0"
  }
}
