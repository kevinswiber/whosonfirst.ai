{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "whosonfirst-ai",
  // Every page is built ahead of time, so the adapter deploys files and leaves
  // this entry out. The Worker the site is deployed with is src/worker.ts, added
  // to the deployed configuration by src/integrations/markdown-worker.mjs.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
