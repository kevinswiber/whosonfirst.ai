---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/400-italic.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/tokens.css";
import "../styles/global.css";
// The four faces every first screen uses: body text,
// bold, labels and titles. Preloading them starts the downloads with the page
// instead of after the stylesheet, so the text does not paint in a fallback
// font first. These resolve to the same files the @fontsource CSS points at.
import plexMono500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";
import plexMono600 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url";
import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import plexSans600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import Here from "../components/Here.astro";
import {
  AUTHOR,
  CONTENT_LICENSE,
  REVIEWED,
  REVIEWED_ISO,
  SOURCE,
} from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Where the reader is, for the line under the bar on a long page. */
  here?: {
    trail?: { label: string; short?: string; href?: string }[];
    current: string;
  };
  /** A page that explains one thing at length: a lesson, a flow, a guide. */
  article?: boolean;
  /** Keep the page out of search results. For the "not found" page. */
  noindex?: boolean;
  /** Whether the page has a copy in Markdown beside it. Off where there is nothing to read as text. */
  markdown?: boolean;
  /** Further schema.org nodes about this page, added to the ones every page carries. */
  schema?: Record<string, unknown>[];
}

// The publication's name is "Who’s on First". whosonfirst.ai is its address, and
// appears only where an address is meant.
const SITE = "Who’s on First";
const DESCRIPTOR = "A field guide to agent authentication and authorization";
const {
  title,
  here,
  article = false,
  noindex = false,
  markdown = !noindex,
  schema = [],
  description = `${DESCRIPTOR}: the flows, the deployments and the standards, with and without a human in the loop.`,
} = Astro.props;
// Seen outside the site, a title has to say what the page is about and where it is from.
const fullTitle = title ? `${title} — ${SITE}` : `${SITE} — ${DESCRIPTOR}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Two files are written for every page when the site is built, both named
// after its address: /flows/dpop/ has /og/flows/dpop.png, the card shown where a
// link to it is shared, and /flows/dpop/index.md, the page as Markdown for a
// program that reads. src/integrations/ makes them from the built page.
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "") || "index";
const card = new URL(`/og/${noindex ? "index" : slug}.png`, Astro.site);
const cardAlt = `${title ?? SITE}. ${SITE}: ${DESCRIPTOR.toLowerCase()}.`;
const markdownHref = `${Astro.url.pathname}index.md`;

// What the page is, for a search engine or an answer engine: the site, who makes
// it, this page and when it was last checked, and the trail to it.
const home = new URL("/", Astro.site).href;
const siteId = `${home}#website`;
const authorId = `${new URL("/about/", Astro.site).href}#who-makes-it`;
const crumbs = here
  ? [
      { label: SITE, href: "/" },
      ...(here.trail ?? []).filter((t) => t.href),
      { label: title ?? here.current, href: Astro.url.pathname },
    ]
  : [];
const graph = [
  {
    "@type": "WebSite",
    "@id": siteId,
    url: home,
    name: SITE,
    alternateName: "whosonfirst.ai",
    description: `${DESCRIPTOR}.`,
    inLanguage: "en",
    publisher: { "@id": authorId },
    license: CONTENT_LICENSE,
  },
  {
    "@type": "Person",
    "@id": authorId,
    name: AUTHOR.name,
    url: AUTHOR.url,
    sameAs: AUTHOR.profiles.map((p) => p.href),
  },
  {
    "@type": "WebPage",
    "@id": canonical.href,
    url: canonical.href,
    name: title ?? SITE,
    description,
    inLanguage: "en",
    isPartOf: { "@id": siteId },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: card.href,
      width: 1200,
      height: 630,
    },
    lastReviewed: REVIEWED_ISO,
    reviewedBy: { "@id": authorId },
    ...(crumbs.length
      ? { breadcrumb: { "@id": `${canonical.href}#breadcrumb` } }
      : {}),
  },
  ...(article
    ? [
        {
          "@type": "TechArticle",
          "@id": `${canonical.href}#article`,
          headline: title,
          description,
          inLanguage: "en",
          image: card.href,
          author: { "@id": authorId },
          publisher: { "@id": authorId },
          isPartOf: { "@id": siteId },
          mainEntityOfPage: { "@id": canonical.href },
        },
      ]
    : []),
  ...(crumbs.length
    ? [
        {
          "@type": "BreadcrumbList",
          "@id": `${canonical.href}#breadcrumb`,
          itemListElement: crumbs.map((c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.label,
            item: new URL(c.href ?? "/", Astro.site).href,
          })),
        },
      ]
    : []),
  ...schema,
];
// "<" is written as an escape so that nothing in the data can close the script element.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");

// In the order a reader new to the subject needs them: learn it, choose with it,
// then look things up. The first stays in reach on a phone, where the rest wait
// behind the menu. Concepts, the one-page version of the lessons, is reached
// from them and from the footer.
const QUICK = { href: "/learn/", label: "Learn" };
const nav = [
  QUICK,
  { href: "/guide/", label: "Choose a flow" },
  { href: "/flows/", label: "Flows" },
  { href: "/deployments/", label: "Deployments" },
  { href: "/standards/", label: "Standards" },
  { href: "/glossary/", label: "Glossary" },
];
const path = Astro.url.pathname;
const preloadFonts = [plexSans400, plexSans600, plexMono500, plexMono600];
---

<!doctype html>
<html lang="en" data-here={here ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <meta name="robots" content="max-image-preview:large" />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdownHref} title="This page as Markdown" />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={card} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <meta name="twitter:image:alt" content={cardAlt} />
    <meta name="twitter:creator" content={AUTHOR.x} />
    {!noindex && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // The page follows the system's light or dark setting through CSS alone.
      // A theme picked with the header button is kept only while it differs
      // from the system's; once they agree, the page is simply following again.
      (() => {
        try {
          const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          const picked = localStorage.getItem('theme');
          if (picked !== 'light' && picked !== 'dark') return;
          if (picked === system) localStorage.removeItem('theme');
          else document.documentElement.dataset.theme = picked;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${SITE}, home`}>
          <span class="wordmark">{SITE}</span>
        </a>
        <a class="quick" href={QUICK.href} aria-current={path.startsWith(QUICK.href) ? 'page' : undefined}>
          {QUICK.label}
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
        <nav id="site-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="theme" type="button" title="Switch color theme">
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
          </svg>
          <span class="theme-text">Switch color theme</span>
        </button>
      </div>
      {
        here && (
          <div class="here">
            <div class="wrap">
              <Here trail={here.trail} current={here.current} />
            </div>
          </div>
        )
      }
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <a class="brand" href="/">
            <span class="wordmark">{SITE}</span>
          </a>
          <p>
            {DESCRIPTOR}. Who is acting, for whom, and who said they could?
          </p>
          <p class="by">
            Made by <a href={AUTHOR.url} rel="author">{AUTHOR.name}</a>. The <a href={SOURCE}>source is on GitHub</a>.
            Found something wrong or out of date? <a href="/about/#corrections">Say so</a>.
          </p>
        </div>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/concepts/">Concepts</a></li>
          <li><a href="/styleguide/">Style guide</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
        <p class="fine">
          <a href="/">whosonfirst.ai</a> · Standards status last reviewed {REVIEWED}. Drafts move quickly: check the linked source before you build
          on one.
        </p>
      </div>
    </footer>

    <script>
      // The "you are here" line names the section the reader has scrolled to: the
      // last heading to have passed under the header. It is a button, and pressing
      // it lists the page's sections, on every page that has the line.
      {
        const sec = document.querySelector<HTMLButtonElement>('.site-header .here-sec');
        const menu = document.querySelector<HTMLElement>('.site-header .here-menu');
        const bar = document.querySelector<HTMLElement>('.site-header');
        const heads = [...document.querySelectorAll<HTMLElement>('main h2')].filter((h) => h.offsetParent);
        // the list is a popover: where a browser has none, the button stays hidden
        const popovers = 'showPopover' in HTMLElement.prototype;
        if (sec && menu && bar && heads.length > 1 && popovers) {
          const name = sec.querySelector<HTMLElement>('.here-sec-name')!;
          const list = menu.querySelector('ol')!;
          const used = new Set([...document.querySelectorAll('[id]')].map((e) => e.id));
          const links = heads.map((h) => {
            if (!h.id) {
              const base =
                (h.textContent ?? '')
                  .toLowerCase()
                  .replace(/[^a-z0-9]+/g, '-')
                  .replace(/^-|-$/g, '') || 'section';
              let id = base;
              for (let n = 2; used.has(id); n++) id = `${base}-${n}`;
              used.add(id);
              h.id = id;
            }
            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = (h.textContent ?? '').trim();
            a.addEventListener('click', () => menu.hidePopover());
            const li = document.createElement('li');
            li.append(a);
            list.append(li);
            return a;
          });
          sec.hidden = false;
          let queued = false;
          const update = () => {
            queued = false;
            // a section jumped to lands a little below the header, so the line it has
            // to have passed is lower still: otherwise the one before stays marked
            const line = bar.getBoundingClientRect().bottom + 48;
            let at = -1;
            heads.forEach((h, i) => {
              if (h.getBoundingClientRect().top <= line) at = i;
            });
            const current = at < 0 ? '' : links[at].textContent!;
            if (name.textContent !== current) name.textContent = current;
            links.forEach((a, i) => a.toggleAttribute('aria-current', i === at));
          };
          menu.addEventListener('beforetoggle', () => {
            const r = sec.getBoundingClientRect();
            menu.style.setProperty('--here-menu-top', `${Math.round(bar.getBoundingClientRect().bottom + 4)}px`);
            menu.style.setProperty(
              '--here-menu-left',
              `${Math.round(Math.max(16, Math.min(r.left, innerWidth - 16 - Math.min(374, innerWidth - 32))))}px`,
            );
          });
          menu.addEventListener('toggle', (e) =>
            sec.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')),
          );
          addEventListener(
            'scroll',
            () => {
              if (!queued) {
                queued = true;
                requestAnimationFrame(update);
              }
            },
            { passive: true },
          );
          update();
        } else if (menu && !popovers) {
          // without popovers the list would sit open on the page: put it away
          menu.hidden = true;
        }
      }

      // The phone menu. Without this script the navigation is simply shown in full.
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const setOpen = (open: boolean) => {
        header.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Close' : 'Menu';
      };
      toggle.hidden = false;
      header.dataset.js = '';
      toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header.hasAttribute('data-open')) {
          setOpen(false);
          toggle.focus();
        }
      });
      header.querySelector('nav')!.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setOpen(false);
      });
      document.addEventListener('click', (e) => {
        if (!header.contains(e.target as Node)) setOpen(false);
      });
      window.matchMedia('(min-width: 62.01rem)').addEventListener('change', () => setOpen(false));

      // Color theme. With no choice made, CSS follows the system setting, and
      // keeps following it when it changes. The button picks the other theme;
      // that choice lasts until the system setting next changes.
      const root = document.documentElement;
      const dark = window.matchMedia('(prefers-color-scheme: dark)');
      const system = () => (dark.matches ? 'dark' : 'light');
      const follow = () => {
        delete root.dataset.theme;
        try {
          localStorage.removeItem('theme');
        } catch {}
      };
      document.querySelector<HTMLButtonElement>('.theme')?.addEventListener('click', () => {
        const next = (root.dataset.theme ?? system()) === 'dark' ? 'light' : 'dark';
        if (next === system()) return follow();
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
      dark.addEventListener('change', follow);

      // Glossary terms in running text. Each is a link to its entry that carries the
      // definition with it. Where the browser can show a popover, activating one
      // shows the definition in place; otherwise it stays a link. Click, tap, Enter
      // or Space: a definition that needs a hover is no use on a phone.
      const tip = document.createElement('span');
      if ('showPopover' in tip) {
        tip.className = 'term-tip';
        tip.id = 'term-tip';
        tip.setAttribute('popover', 'auto');
        tip.setAttribute('role', 'note');
        let from: HTMLElement | null = null;
        // the term that was showing its definition when a press on it began
        let pressed: HTMLElement | null = null;
        // the term whose definition is showing now, if any
        const showing = () => (tip.matches(':popover-open') ? from : null);
        const shut = () => {
          from?.setAttribute('aria-expanded', 'false');
          if (tip.matches(':popover-open')) tip.hidePopover();
          from = null;
        };
        // it now opens something in place, which is what a button does
        document.querySelectorAll<HTMLElement>('a.term').forEach((a) => {
          a.setAttribute('role', 'button');
          a.setAttribute('aria-expanded', 'false');
        });
        // closed by Escape or by a press elsewhere: the browser does that, and says so here
        tip.addEventListener('toggle', (e) => {
          if ((e as ToggleEvent).newState === 'closed' && !tip.matches(':popover-open')) shut();
        });
        const place = (a: HTMLElement) => {
          const r = a.getBoundingClientRect();
          const box = tip.getBoundingClientRect();
          const left = Math.max(12, Math.min(r.left, innerWidth - box.width - 12));
          const below = r.bottom + 8;
          const top = below + box.height > innerHeight - 8 && r.top - box.height - 8 > 8 ? r.top - box.height - 8 : below;
          tip.style.left = `${left}px`;
          tip.style.top = `${top}px`;
        };
        const open = (a: HTMLElement) => {
          shut();
          tip.replaceChildren();
          const name = document.createElement('span');
          name.className = 'term-tip-name';
          name.textContent = a.dataset.term ?? '';
          const def = document.createElement('span');
          def.className = 'term-tip-def';
          def.textContent = a.dataset.def ?? '';
          const more = document.createElement('a');
          more.className = 'term-tip-more';
          more.href = a.getAttribute('href') ?? '/glossary/';
          more.textContent = 'In the glossary →';
          tip.append(name, def, more);
          // straight after the term, so that Tab goes from the term to the link in its definition
          a.after(tip);
          tip.showPopover();
          from = a;
          a.setAttribute('aria-expanded', 'true');
          place(a);
        };
        // A press outside an open definition closes it, and the term itself is outside.
        // Note whether this press began on the term whose definition was open, so
        // that the click it ends in is taken as closing it and does not open it again.
        document.addEventListener(
          'pointerdown',
          (e) => {
            const a = (e.target as Element).closest<HTMLElement>('a.term');
            pressed = a && a === showing() ? a : null;
          },
          true,
        );
        document.addEventListener('click', (e) => {
          const a = (e.target as Element).closest<HTMLElement>('a.term');
          // a modified click is a request to open the glossary itself
          if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          const closing = pressed === a || showing() === a;
          pressed = null;
          if (closing) shut();
          else open(a);
        });
        document.addEventListener('keydown', (e) => {
          const a = (e.target as Element).closest?.<HTMLElement>('a.term');
          if (a && e.key === ' ') {
            e.preventDefault();
            a.click();
          }
        });
        // it is placed against the term once; if the page moves, it goes
        const away = () => {
          if (showing()) shut();
        };
        window.addEventListener('scroll', away, { passive: true, capture: true });
        window.addEventListener('resize', away);
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    z-index: 100;
    background: var(--fg);
    color: var(--bg);
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius);
  }
  .skip:focus {
    top: 0.5rem;
  }

  /* On paper there is nothing to press: the name of the site and where the page
     sits stay, the menu, the shortcut and the theme switch go. */
  @media print {
    .skip,
    .menu-toggle,
    .quick,
    nav,
    .theme {
      display: none !important;
    }
    .site-header {
      position: static;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  /* Where the reader is, on the long pages: a line under the bar that stays with it
     when the page's own title has scrolled away. Its height is --here in global.css,
     which everything that sticks or scrolls into place below the header adds on. */
  .here {
    border-top: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.5rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
    padding-block: 0.6rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-style: var(--display-italic);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav li {
    margin: 0;
  }
  nav a {
    display: block;
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-muted);
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius);
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--fg);
    background: var(--bg-sunken);
  }
  nav a[aria-current='page'] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    flex: none;
  }
  .theme:hover {
    background: var(--bg-sunken);
  }

  .quick,
  .menu-toggle {
    display: none;
  }
  /* beside the navigation the theme button is an icon; its name is still there to be read */
  .theme-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Phone and tablet: the brand, the one task link and a menu button. Every
