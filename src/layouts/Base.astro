---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/400-italic.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/tokens.css";
import "../styles/global.css";
// The four faces every first screen uses: body text,
// bold, labels and titles. Preloading them starts the downloads with the page
// instead of after the stylesheet, so the text does not paint in a fallback
// font first. These resolve to the same files the @fontsource CSS points at.
import plexMono500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";
import plexMono600 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url";
import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import plexSans600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import markFile from "../../public/favicon.svg?raw";
import Here from "../components/Here.astro";
import SearchDialog from "../components/SearchDialog.astro";
import SectionLinks from "../components/SectionLinks.astro";
import { longDate, pageDates } from "../lib/page-dates";
import { linkSections } from "../lib/section-links";
import { places } from "../data/deployments";
import { flows } from "../data/flows";
import { glossary } from "../data/glossary";
import { lessons, totalMinutes } from "../data/learn/lessons";
import { standards } from "../data/standards";
import {
  AUTHOR,
  CHANNEL,
  CONTENT_LICENSE,
  REVIEWED,
  REVIEWED_ISO,
  SOURCE,
} from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Where the reader is, for the line under the bar on a long page. */
  here?: {
    trail?: { label: string; short?: string; href?: string }[];
    current: string;
  };
  /** A page that explains one thing at length: a lesson, a flow, a guide. */
  article?: boolean;
  /** Keep the page out of search results. For the "not found" page. */
  noindex?: boolean;
  /** Whether the page has a copy in Markdown beside it. Off where there is nothing to read as text. */
  markdown?: boolean;
  /** Omit whole-page reviewer claims where only separately dated records were checked. */
  reviewMetadata?: boolean;
  /** Further schema.org nodes about this page, added to the ones every page carries. */
  schema?: Record<string, unknown>[];
  /** A feed of what this page lists, at this origin, for a reader that follows one. */
  feed?: { href: string; title: string };
}

// The publication's name is "Who’s on First". whosonfirst.ai is its address, and
// appears only where an address is meant.
const SITE = "Who’s on First";
const DESCRIPTOR = "A field guide to agent authentication and authorization";
const {
  title,
  here,
  article = false,
  noindex = false,
  markdown = !noindex,
  schema = [],
  feed,
  reviewMetadata = true,
  description = `${DESCRIPTOR}: the flows, the deployments and the standards, with and without a human in the loop.`,
} = Astro.props;
// Seen outside the site, a title has to say what the page is about and where it is from.
const fullTitle = title ? `${title} - ${SITE}` : `${SITE} - ${DESCRIPTOR}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Each section heading gets a link to its own address, made here and not by
// the page that has the heading, so that every page has them. The search page
// and the "not found" page are tools, not text, and have none.
const body = await Astro.slots.render("default");
const sections = !noindex && Astro.url.pathname !== "/search/";

// Two files are written for every page when the site is built, both named
// after its address: /flows/dpop/ has /og/flows/dpop.png, the card shown where a
// link to it is shared, and /flows/dpop/index.md, the page as Markdown for a
// program that reads. src/integrations/ makes them from the built page.
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "") || "index";
const card = new URL(`/og/${noindex ? "index" : slug}.png`, Astro.site);
const cardAlt = `${title ?? SITE}. ${SITE}: ${DESCRIPTOR.toLowerCase()}.`;
const markdownHref = `${Astro.url.pathname}index.md`;

// When the page was first published and when it last changed, where the build
// could read the repository's history. A search engine is told both, in the
// words schema.org has for them. Without the history a page says neither.
const history = pageDates(Astro.url.pathname);
// A reader is told the same date, in the footer, with the history it was read
// from.
const changed = history &&
  !noindex && {
    iso: history.modified,
    day: longDate(history.modified),
    log: `${SOURCE}/commits/main/${history.source}`,
  };
const dates: { datePublished?: string; dateModified?: string } = history
  ? { datePublished: history.published, dateModified: history.modified }
  : {};

// What the page is, for a search engine or an answer engine: the site, who makes
// it, this page and when it was last checked, and the trail to it.
const home = new URL("/", Astro.site).href;
const siteId = `${home}#website`;
const authorId = `${new URL("/about/", Astro.site).href}#who-makes-it`;
const crumbs = here
  ? [
      { label: SITE, href: "/" },
      ...(here.trail ?? []).filter((t) => t.href),
      { label: title ?? here.current, href: Astro.url.pathname },
    ]
  : [];
const graph = [
  {
    "@type": "WebSite",
    "@id": siteId,
    url: home,
    name: SITE,
    alternateName: "whosonfirst.ai",
    description: `${DESCRIPTOR}.`,
    inLanguage: "en",
    publisher: { "@id": authorId },
    license: CONTENT_LICENSE,
    sameAs: [CHANNEL.url],
  },
  {
    "@type": "Person",
    "@id": authorId,
    name: AUTHOR.name,
    url: AUTHOR.url,
    sameAs: AUTHOR.profiles.map((p) => p.href),
  },
  {
    "@type": "WebPage",
    "@id": canonical.href,
    url: canonical.href,
    name: title ?? SITE,
    description,
    inLanguage: "en",
    isPartOf: { "@id": siteId },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: card.href,
      width: 1200,
      height: 630,
    },
    ...dates,
    ...(reviewMetadata
      ? { lastReviewed: REVIEWED_ISO, reviewedBy: { "@id": authorId } }
      : {}),
    ...(crumbs.length
      ? { breadcrumb: { "@id": `${canonical.href}#breadcrumb` } }
      : {}),
  },
  ...(article
    ? [
        {
          "@type": "TechArticle",
          "@id": `${canonical.href}#article`,
          headline: title,
          description,
          inLanguage: "en",
          image: card.href,
          ...dates,
          author: { "@id": authorId },
          publisher: { "@id": authorId },
          isPartOf: { "@id": siteId },
          mainEntityOfPage: { "@id": canonical.href },
        },
      ]
    : []),
  ...(crumbs.length
    ? [
        {
          "@type": "BreadcrumbList",
          "@id": `${canonical.href}#breadcrumb`,
          itemListElement: crumbs.map((c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.label,
            item: new URL(c.href ?? "/", Astro.site).href,
          })),
        },
      ]
    : []),
  ...schema,
];
// "<" is written as an escape so that nothing in the data can close the script element.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");

// The guide's sections, in the order a reader new to the subject needs them:
// start, then the flows in practice, then what to look things up in. The grouping is the one the home page opens with. The header shows it
// with a gap and a rule, and the menu and the footer, which have the room,
// name each group and say what each section holds. An entry marked `more` is
// in the menu and the footer only.
interface Section {
  href: string;
  label: string;
  note: string;
  more?: boolean;
}
const groups: { name: string; items: Section[] }[] = [
  {
    name: "Start here",
    items: [
      {
        href: "/learn/",
        label: "Learn",
        note: `${lessons.length} short lessons, about ${totalMinutes} minutes`,
      },
      {
        href: "/guide/",
        label: "Choose a flow",
        note: "Six questions about your agent",
      },
      {
        href: "/concepts/",
        label: "Concepts",
        note: "The ideas, on one page",
        more: true,
      },
      {
        href: "/compare/",
        label: "Comparisons",
        note: "Two flows, set against each other",
        more: true,
      },
    ],
  },
  {
    name: "In practice",
    items: [
      {
        href: "/flows/",
        label: "All flows",
        note: `${flows.length} flows, step by step`,
      },
      {
        href: "/deployments/",
        label: "Where agents run",
        note: `${places.length} guides, from your own machine to Kubernetes`,
      },
      {
        href: "/implementations/",
        label: "Implementations",
        note: "Products and production reports",
        more: true,
      },
    ],
  },
  {
    name: "Reference",
    items: [
      {
        href: "/standards/",
        label: "Standards",
        note: `${standards.length} specifications and where each stands`,
      },
      {
        href: "/glossary/",
        label: "Glossary",
        note: `${glossary.length} terms, each in a sentence or two`,
      },
      {
        href: "/standards/timeline/",
        label: "Timeline",
        note: "What has happened to the specifications, by date",
        more: true,
      },
    ],
  },
];
const nav = groups.flatMap((g) => g.items.filter((i) => !i.more));
// The three ways in that the home page opens with. They stay in the bar where
// the rest of the list waits behind the menu; a phone has room for the first.
const QUICK = [nav[0], nav[1], nav[2]];
// Where the reader is. One section is the current page: the one whose address
// reaches furthest into this page's. The timeline is under the standards, so on
// it the timeline is current and the standards are the section around it. The
// bar, which has no room for the timeline, draws its rule under the standards
// there; the menu, which lists both, marks the timeline alone.
const path = Astro.url.pathname;
const around = groups
  .flatMap((g) => g.items)
  .filter((i) => path.startsWith(i.href))
  .sort((a, b) => b.href.length - a.href.length);
const marked = (item: Section) => (item === around[0] ? "page" : undefined);
const within = (item: Section) => (around.indexOf(item) > 0 ? "" : undefined);

/**
 * The site's mark, drawn into the header from the icon's own file. Its style
 * sheet follows the system's color scheme, which is right for a tab; here the
 * classes are colored by the page.
 */
const MARK = markFile
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/<style>[\s\S]*?<\/style>/, "")
  .replace("<svg ", '<svg class="mark" aria-hidden="true" ');
const SPECULATION = JSON.stringify({
  prerender: [
    {
      where: {
        and: [{ href_matches: "/*" }, { not: { href_matches: "/*.*" } }],
      },
      eagerness: "moderate",
    },
  ],
});
const preloadFonts = [plexSans400, plexSans600, plexMono500, plexMono600];
---

<!doctype html>
<html lang="en" data-here={here ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <meta name="robots" content="max-image-preview:large" />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdownHref} title="This page as Markdown" />}
    {feed && <link rel="alternate" type="application/atom+xml" href={feed.href} title={feed.title} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {article && dates.datePublished && <meta property="article:published_time" content={dates.datePublished} />}
    {article && dates.dateModified && <meta property="article:modified_time" content={dates.dateModified} />}
    <meta property="og:image" content={card} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <meta name="twitter:image:alt" content={cardAlt} />
    <meta name="twitter:creator" content={AUTHOR.x} />
    {!noindex && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {/*
      A browser that reads these rules starts loading a page of the site when
      the reader's pointer rests on a link to it, so the page is there when the
      link is pressed. Only pages: a file, such as a page's Markdown copy, has a
      dot in its address. A browser that does not read them does nothing.
    */}
    <script is:inline type="speculationrules" set:html={SPECULATION} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // The page follows the system's light or dark setting through CSS alone.
      // A theme picked with the footer's button is kept only while it differs
      // from the system's; once they agree, the page is simply following again.
      (() => {
        try {
          const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          const picked = localStorage.getItem('theme');
          if (picked !== 'light' && picked !== 'dark') return;
          if (picked === system) localStorage.removeItem('theme');
          else document.documentElement.dataset.theme = picked;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${SITE}, home`}>
          <Fragment set:html={MARK} />
          <span class="wordmark">{SITE}</span>
        </a>
        <div class="quick">
          {
            QUICK.map((item) => (
              <a href={item.href} aria-current={marked(item)} data-within={within(item)}>
                {item.label}
              </a>
            ))
          }
        </div>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
        <nav id="site-nav" aria-label="Primary">
          <ul class="nav-groups">
            {
              groups.map((g, i) => (
                <li class="nav-group">
                  <span class="nav-group-name" id={`nav-group-${i}`}>
                    {g.name}
                  </span>
                  <ul aria-labelledby={`nav-group-${i}`}>
                    {g.items.map((item) => (
                      <li class:list={{ more: item.more }}>
                        <a href={item.href} aria-current={marked(item)} data-within={within(item)}>
                          <span class="nav-label">{item.label}</span>
                          <span class="nav-note">{item.note}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="search-launch" data-search-launch href="/search/" aria-labelledby="header-search-label header-search-key" aria-current={path === '/search/' ? 'page' : undefined}>
          <span class="search-glass" aria-hidden="true"></span>
          <span class="launch-label" id="header-search-label">Ask or search</span>
          <kbd class="launch-key" id="header-search-key" hidden></kbd>
        </a>
      </div>
      {
        here && (
          <div class="here">
            <div class="wrap">
              <Here trail={here.trail} current={here.current} />
            </div>
          </div>
        )
      }
    </header>

    <main id="main">
      <Fragment set:html={sections ? linkSections(body) : body} />
    </main>
    {sections && <SectionLinks />}

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <a class="brand" href="/">
            <span class="wordmark">{SITE}</span>
          </a>
          <p>
            {DESCRIPTOR}. Who is acting, for whom, and who said they could?
          </p>
          <p class="by">
            Made by <a href="/about/#who-makes-it" rel="author">{AUTHOR.name}</a>.
            Found something wrong or out of date? <a href="/about/#corrections">Say so</a>.
          </p>
          {
            markdown && (
              <p class="as-text">
                Reading with an assistant? <a href={markdownHref} type="text/markdown">This page as Markdown</a> is the
                same words without the layout, and <a href="/llms.txt">llms.txt</a> lists every page that way.
              </p>
              <p class="as-text-copy" hidden>
                <button class="btn small ghost" type="button" data-copy={markdownHref}>Copy this page as Markdown</button>{' '}
                <span class="as-text-said" aria-live="polite"></span>
              </p>
            )
          }
        </div>
        <nav class="foot-map" aria-label="All sections">
          {
            groups.map((g, i) => (
              <div>
                <p class="foot-head" id={`foot-group-${i}`}>
                  {g.name}
                </p>
                <ul aria-labelledby={`foot-group-${i}`}>
                  {g.items.map((item) => (
                    <li>
                      <a href={item.href}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div>
            <p class="foot-head" id="foot-group-site">This guide</p>
            <ul aria-labelledby="foot-group-site">
              <li><a href="/about/">About</a></li>
              <li><a href="/search/">Search the guide</a></li>
              <li><a href="/standards/changes/">Changelog</a></li>
              <li><a href={SOURCE}>Source on GitHub</a></li>
              <li><a href={CHANNEL.url}>Films on YouTube</a></li>
            </ul>
          </div>
        </nav>
        <div class="foot-end">
          <p class="fine">
            <a href="/">whosonfirst.ai</a> ·{' '}
            {
              changed && (
                <>
                  This page last changed <time datetime={changed.iso}>{changed.day}</time> (<a href={changed.log}>its history</a>).{' '}
                </>
              )
            }
            Standards status last reviewed {REVIEWED}. Drafts move quickly: check the linked source before you build
            on one.
          </p>
          <button class="theme" type="button">
            <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
            </svg>
            Switch color theme
          </button>
        </div>
      </div>
    </footer>
    {path !== '/search/' && <SearchDialog />}

    <script>
      // The "you are here" line names the section the reader has scrolled to: the
      // last heading to have passed under the header. It is a button, and pressing
      // it lists the page's sections, on every page that has the line.
      {
        const sec = document.querySelector<HTMLButtonElement>('.site-header .here-sec');
        const menu = document.querySelector<HTMLElement>('.site-header .here-menu');
        const bar = document.querySelector<HTMLElement>('.site-header');
        const heads = [...document.querySelectorAll<HTMLElement>('main h2')].filter((h) => h.offsetParent);
        // the list is a popover: where a browser has none, the button stays hidden
        const popovers = 'showPopover' in HTMLElement.prototype;
        if (sec && menu && bar && heads.length > 1 && popovers) {
          const name = sec.querySelector<HTMLElement>('.here-sec-name')!;
          const list = menu.querySelector('ol')!;
          const used = new Set([...document.querySelectorAll('[id]')].map((e) => e.id));
          const links = heads.map((h) => {
            if (!h.id) {
              const base =
                (h.textContent ?? '')
                  .toLowerCase()
                  .replace(/[^a-z0-9]+/g, '-')
                  .replace(/^-|-$/g, '') || 'section';
              let id = base;
              for (let n = 2; used.has(id); n++) id = `${base}-${n}`;
              used.add(id);
              h.id = id;
            }
            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = (h.textContent ?? '').trim();
            a.addEventListener('click', () => menu.hidePopover());
            const li = document.createElement('li');
            li.append(a);
            list.append(li);
            return a;
          });
          sec.hidden = false;
          let queued = false;
          const update = () => {
            queued = false;
            // a section jumped to lands a little below the header, so the line it has
            // to have passed is lower still: otherwise the one before stays marked
            const bottom = bar.getBoundingClientRect().bottom;
            const line = bottom + 48;
            let at = -1;
            let nearest = -Infinity;
            let targetAt = -1;
            heads.forEach((h, i) => {
              const top = h.getBoundingClientRect().top;
              if (top <= line && top >= nearest) {
                at = i;
                nearest = top;
              }
              // Side-by-side sections can share a row. Honor the fragment's
              // heading while it is at the header, including a jump with no scroll.
              if (h.id === location.hash.slice(1) && top >= bottom - 1 && top <= line) targetAt = i;
            });
            if (targetAt >= 0) at = targetAt;
            const current = at < 0 ? '' : links[at].textContent!;
            if (name.textContent !== current) name.textContent = current;
            links.forEach((a, i) => a.toggleAttribute('aria-current', i === at));
          };
          menu.addEventListener('beforetoggle', () => {
            const r = sec.getBoundingClientRect();
            menu.style.setProperty('--here-menu-top', `${Math.round(bar.getBoundingClientRect().bottom + 4)}px`);
            menu.style.setProperty(
              '--here-menu-left',
              `${Math.round(Math.max(16, Math.min(r.left, innerWidth - 16 - Math.min(374, innerWidth - 32))))}px`,
            );
          });
          menu.addEventListener('toggle', (e) =>
            sec.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')),
          );
          addEventListener(
            'scroll',
            () => {
              if (!queued) {
                queued = true;
                requestAnimationFrame(update);
              }
            },
            { passive: true },
          );
          addEventListener('hashchange', update);
          update();
        } else if (menu && !popovers) {
          // without popovers the list would sit open on the page: put it away
          menu.hidden = true;
        }
      }

      // The page as Markdown, copied, for pasting into an assistant. The link
      // beside the button leads to the same text, so the button appears only
      // where the browser can copy.
      {
        const button = document.querySelector<HTMLButtonElement>('.site-footer [data-copy]');
        const said = document.querySelector<HTMLElement>('.site-footer .as-text-said');
        if (button && said && navigator.clipboard) {
          button.parentElement!.hidden = false;
          button.addEventListener('click', async () => {
            try {
              const copy = await fetch(button.dataset.copy!);
              if (!copy.ok) throw new Error(String(copy.status));
              await navigator.clipboard.writeText(await copy.text());
              said.textContent = 'Copied';
            } catch {
              said.textContent = 'Not copied: the link has the same text';
            }
          });
        }
      }

      // The standalone search also answers the shortcut on a native form response.
      if (!document.getElementById('global-search')) {
        const input = document.querySelector<HTMLInputElement>('main guide-search input[name="q"]');
        if (input) {
          document.addEventListener('keydown', (event) => {
            if (event.defaultPrevented || event.isComposing || event.altKey || event.shiftKey) return;
            if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
              event.preventDefault();
              input.focus();
            }
          });
          document.querySelector('[data-search-launch]')?.addEventListener('click', (event) => {
            if (!(event instanceof MouseEvent) || event.button || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
            event.preventDefault();
            input.focus();
          });
        }
      }

      // The phone menu. Without this script the navigation is simply shown in full.
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const setOpen = (open: boolean) => {
        header.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Close' : 'Menu';
      };
      toggle.hidden = false;
      header.dataset.js = '';
      toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header.hasAttribute('data-open')) {
          setOpen(false);
          toggle.focus();
        }
      });
      header.querySelector('nav')!.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setOpen(false);
      });
      document.addEventListener('click', (e) => {
        if (!header.contains(e.target as Node)) setOpen(false);
      });
      // The open menu can cover the page. Focus that has moved on into the page
      // would be behind it, so the menu closes as focus leaves the header.
      document.addEventListener('focusin', (e) => {
        if (header.hasAttribute('data-open') && !header.contains(e.target as Node)) setOpen(false);
      });
      window.matchMedia('(width > 63rem)').addEventListener('change', () => setOpen(false));

      // Color theme. With no choice made, CSS follows the system setting, and
      // keeps following it when it changes. The button picks the other theme;
      // that choice lasts until the system setting next changes.
      const root = document.documentElement;
      const dark = window.matchMedia('(prefers-color-scheme: dark)');
      const system = () => (dark.matches ? 'dark' : 'light');
      const follow = () => {
        delete root.dataset.theme;
        try {
          localStorage.removeItem('theme');
        } catch {}
      };
      document.querySelector<HTMLButtonElement>('.theme')?.addEventListener('click', () => {
        const next = (root.dataset.theme ?? system()) === 'dark' ? 'light' : 'dark';
        if (next === system()) return follow();
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
      dark.addEventListener('change', follow);

      // Glossary terms and RFC numbers in running text. Each is a link to its entry,
      // in the glossary or the standards tracker, that carries what it is with it. Hover or keyboard focus previews the definition where
      // popovers are available. Activation always follows the link, including when
      // a reading mode sends that action back to this page. Touch needs no preview
      // to reach the definition, and the link also works without JavaScript.
      const tip = document.createElement('span');
      if ('showPopover' in tip) {
        tip.className = 'term-tip';
        tip.id = 'term-tip';
        tip.setAttribute('popover', 'auto');
        tip.setAttribute('role', 'note');
        let from: HTMLElement | null = null;
        // the term whose definition is showing now, if any
        const showing = () => (tip.matches(':popover-open') ? from : null);
        const shut = () => {
          from?.setAttribute('aria-expanded', 'false');
          if (tip.matches(':popover-open')) tip.hidePopover();
          from = null;
        };
        document.querySelectorAll<HTMLElement>('a.term, a.spec').forEach((a) => {
          a.setAttribute('aria-expanded', 'false');
        });
        // closed by Escape or by a press elsewhere: the browser does that, and says so here
        tip.addEventListener('toggle', (e) => {
          if ((e as ToggleEvent).newState === 'closed' && !tip.matches(':popover-open')) shut();
        });
        const place = (a: HTMLElement) => {
          const r = a.getBoundingClientRect();
          const box = tip.getBoundingClientRect();
          const left = Math.max(12, Math.min(r.left, innerWidth - box.width - 12));
          const below = r.bottom + 8;
          const top = below + box.height > innerHeight - 8 && r.top - box.height - 8 > 8 ? r.top - box.height - 8 : below;
          tip.style.left = `${left}px`;
          tip.style.top = `${top}px`;
        };
        const open = (a: HTMLElement) => {
          shut();
          tip.replaceChildren();
          const name = document.createElement('span');
          name.className = 'term-tip-name';
          name.textContent = a.dataset.term ?? '';
          const def = document.createElement('span');
          def.className = 'term-tip-def';
          def.textContent = a.dataset.def ?? '';
          const spec = a.classList.contains('spec');
          const more = document.createElement('a');
          more.className = 'term-tip-more';
          more.href = a.getAttribute('href') ?? (spec ? '/standards/' : '/glossary/');
          more.textContent = spec ? 'In the standards tracker →' : 'In the glossary →';
          tip.append(name);
          // a document, or a term that names one, says how settled it is, worded as the tracker words it
          if (a.dataset.status) {
            const meta = document.createElement('span');
            meta.className = 'term-tip-meta';
            const status = document.createElement('span');
            status.className = 'chip';
            status.dataset.tone = a.dataset.tone ?? '';
            status.textContent = a.dataset.status;
            meta.append(status);
            // the identifier, unless it is what the link already says
            if (a.dataset.ref && a.textContent?.trim() !== a.dataset.ref) {
              const ref = document.createElement('span');
              ref.className = 'term-tip-ref';
              ref.textContent = a.dataset.ref;
              meta.append(ref);
            }
            tip.append(meta);
          }
          tip.append(def, more);
          if (a.dataset.standard) {
            const entry = document.createElement('a');
            entry.className = 'term-tip-more';
            entry.href = a.dataset.standard;
            entry.textContent = 'In the standards tracker →';
            tip.append(entry);
          }
          // straight after the term, so that Tab goes from the term to the link in its definition
          a.after(tip);
          tip.showPopover();
          from = a;
          a.setAttribute('aria-expanded', 'true');
          place(a);
        };
        document.addEventListener('pointerover', (e) => {
          const a = (e.target as Element).closest<HTMLElement>('a.term, a.spec');
          // Do not replace a preview while someone is using its link with the keyboard.
          if (e.pointerType === 'mouse' && a && showing() !== a && !tip.contains(document.activeElement)) open(a);
        });
        document.addEventListener('focusin', (e) => {
          const target = e.target as Element;
          const a = target.closest<HTMLElement>('a.term, a.spec');
          if (a && showing() !== a) open(a);
          else if (!a && !tip.contains(target)) shut();
        });
        // it is placed against the term once; if the page moves, it goes
        const away = () => {
          if (showing()) shut();
        };
        window.addEventListener('scroll', away, { passive: true, capture: true });
        window.addEventListener('resize', away);
      }
    </script>
  </body>
</html>

<style>
