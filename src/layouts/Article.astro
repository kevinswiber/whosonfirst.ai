---
/**
 * Layout for long-form MDX pages. Set it with `layout:` in frontmatter.
 * Frontmatter: title, searchTitle, description, lede, section ({ label, href }).
 */
import Base from "./Base.astro";
import DocMeta from "../components/DocMeta.astro";
import Pager from "../components/Pager.astro";
import WayOn from "../components/WayOn.astro";
import { placeAt, places } from "../data/deployments";
import { REVIEWED } from "../data/site";
import { gloss, markHtml } from "../lib/gloss";
import { must } from "../lib/must";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  frontmatter: {
    title: string;
    /** The title where the page is read away from the site, when `title` needs its subject named. */
    searchTitle?: string;
    description?: string;
    lede?: string;
    section?: { label: string; href: string };
  };
  headings?: Heading[];
}

const { frontmatter: fm, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const KIND: Record<string, string> = { "/deployments/": "Deployment guide" };
const kind = fm.section && KIND[fm.section.href];
// A guide's text uses the vocabulary the lessons teach. The first use of each
// glossary term is marked, so its definition can be shown in place.
const body = await Astro.slots.render("default");
const article = kind ? markHtml(body, gloss(Astro.url.pathname)) : body;
const details = kind
  ? [
      {
        label: "This page",
        value: kind,
        note: "An explanation, not a specification",
      },
      {
        label: "Review",
        value: `Checked against sources in ${REVIEWED}`,
        note: "How it was checked",
        noteHref: "/about/#how-facts-were-checked",
      },
    ]
  : [];
// A deployment guide is one of a series, in the order its index page lists. The
// pager steps through that order, and the way on above it picks out the guides
// that go with this one.
const place = kind
  ? must(
      placeAt(Astro.url.pathname),
      `deployment guide ${Astro.url.pathname} in data/deployments.ts`,
    )
  : undefined;
const at = place ? places.indexOf(place) : -1;
const before = at > 0 ? places[at - 1] : undefined;
const after = at >= 0 ? places[at + 1] : undefined;
// Where the reader is, for the line under the site header. A page that is its
// own section, as About is, has no trail: the line is its name.
const here = fm.section
  ? fm.section.href === Astro.url.pathname
    ? { current: fm.section.label }
    : {
        trail: [{ label: fm.section.label, href: fm.section.href }],
        current: fm.title,
      }
  : undefined;
---

<Base
  title={fm.searchTitle ?? fm.title}
  description={fm.description ?? fm.lede}
  here={here}
  article={Boolean(kind)}
>
  <article>
    <div class="page-head">
      <div class="wrap">
        {!fm.section && <p class="eyebrow">Guide</p>}
        <h1>{fm.title}</h1>
        {
          kind && (
            <p class="primer">
              This guide uses the vocabulary of the <a href="/learn/">lessons</a>. If a term is new, press it for its
              definition, or start there.
            </p>
          )
        }
      </div>
    </div>

    <div class="wrap article-grid">
      {
        toc.length > 2 && (
          <nav class="article-toc" aria-label="On this page">
            <p>On this page</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="article-main">
        <div class="article">
          {fm.lede && <p class="lede">{fm.lede}</p>}
          {kind && <DocMeta reviewed={REVIEWED} subject="Guide" details={details} more="Review details" />}
          <Fragment set:html={article} />
        </div>
        {kind && <WayOn html={body} path={Astro.url.pathname} />}
        {
          kind && (
            <Pager
              label="More deployment guides"
              prev={before && { href: before.href, kicker: 'Previous guide', title: before.title }}
              next={after && { href: after.href, kicker: 'Next guide', title: after.title }}
            />
          )
        }
      </div>
    </div>
  </article>
</Base>

<script>
  // A checklist copied as a task list, for pasting into an issue or a pull
  // request. The list is read from the page's own Markdown copy, which the
  // build writes from this same list, so the two cannot differ. Without this
  // script, or where the browser cannot copy, there is no button.
  const markdown = document.querySelector<HTMLLinkElement>('link[rel="alternate"][type="text/markdown"]')?.href;
  const lists = document.querySelectorAll<HTMLUListElement>('.article ul.checklist');
  if (markdown && navigator.clipboard && lists.length) {
    const title = document.querySelector('h1')?.textContent?.trim() ?? document.title;
    const address = location.origin + location.pathname;
    lists.forEach((list, n) => {
      let heading: Element | null = list;
      while (heading && heading.tagName !== 'H2') heading = heading.previousElementSibling;
      const name = heading?.textContent?.trim() || 'Checklist';
      const row = document.createElement('p');
      row.className = 'checklist-copy';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'btn small ghost';
      button.textContent = 'Copy as a task list';
      const said = document.createElement('span');
      said.className = 'checklist-said';
      said.setAttribute('aria-live', 'polite');
      row.append(button, ' ', said);
      list.after(row);
      button.addEventListener('click', async () => {
        try {
          const response = await fetch(markdown);
          if (!response.ok) throw new Error(String(response.status));
          // The nth run of task lines is the nth list on the page.
          const runs: string[][] = [];
          let inRun = false;
          for (const line of (await response.text()).split('\n')) {
            const task = line.startsWith('- [ ] ');
            if (task && !inRun) runs.push([]);
            if (task) runs[runs.length - 1].push(line);
            inRun = task;
          }
          const items = runs[n];
          if (!items || items.length !== list.children.length) throw new Error('list not found');
          await navigator.clipboard.writeText(`**${name}**, from [${title}](${address})\n\n${items.join('\n')}\n`);
          said.textContent = 'Copied. Paste it into an issue or a pull request.';
        } catch {
          said.textContent = 'Not copied. The page as Markdown has the same list.';
        }
      });
    });
  }
</script>

<style>
  .primer {
    margin: 1rem 0 0;
    max-width: 42rem;
    color: var(--fg-muted);
  }
  .article-grid {
    display: grid;
    gap: 1.5rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    padding-top: clamp(1.6rem, 4vw, 2.6rem);
    align-items: start;
  }
  @media (min-width: 66rem) {
    .article-grid:has(.article-toc) {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    .article-toc {
      position: sticky;
      top: calc(4.8rem + var(--here, 0rem));
    }
  }
  .article-toc p {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1.5px solid var(--fg);
  }
  .article-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }
  .article-toc li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .article-toc a {
    display: block;
    padding: 0.4rem 0;
    text-decoration: none;
    color: var(--accent);
    line-height: 1.3;
  }
  .article-toc a:hover {
    color: var(--accent);
  }
  @media (max-width: 65.99rem) {
    .article-toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.2rem;
    }
    .article-toc li {
      border-bottom: 0;
    }
  }

  /* MDX output is not scoped, so these are global rules under .article */
  .article :global(:where(p, ul, ol, blockquote, h2, h3, h4, dl)) {
    max-width: var(--article-measure, 46rem);
  }
  .article :global(> :first-child) {
    margin-top: 0;
  }
  .article :global(h2) {
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    margin-top: 2.6em;
    padding-top: 1.1em;
    border-top: 1px solid var(--border);
    /* where the link to the section sits: level with the first line, below this */
    --section-link-top: 1.1em;
  }
  .article :global(h2:first-child),
  .article :global(.lede + h2) {
    border-top: 0;
    padding-top: 0;
    --section-link-top: 0px;
  }
  .article :global(.table-scroll) {
    margin-block: 1.4em 1.8em;
  }
  .article :global(.table-scroll table) {
    min-width: 32rem;
  }
  .article :global(td) {
    min-width: 9rem;
  }
  .article :global(td:first-child) {
    font-weight: 500;
  }
  .article :global(.wide) {
    max-width: none;
    margin-block: 1.6rem 2rem;
  }
  .article :global(li > p) {
    margin-bottom: 0.4em;
  }
  .article :global(.checklist) {
    list-style: none;
    padding: 0;
    border-top: 1.5px solid var(--fg);
  }
  .article :global(.checklist li) {
    position: relative;
    margin: 0;
    padding: 0.65rem 0 0.65rem 2rem;
    border-bottom: 1px solid var(--border);
  }
  .article :global(.checklist-copy) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0.75rem 0 0;
  }
  .article :global(.checklist-said) {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  @media print {
    .article :global(.checklist-copy) {
      display: none;
    }
  }
  .article :global(.checklist li::before) {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.95rem;
    width: 0.95rem;
    height: 0.95rem;
    border: 1.5px solid var(--fg);
    border-radius: 2px;
  }
</style>
