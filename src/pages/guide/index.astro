---
import Base from "../../layouts/Base.astro";
import { implementationProfile } from "../../data/implementations";
import {
  questions,
  rules,
  cautions,
  deployLinks,
  situations,
  ROLE_TITLE,
} from "../../data/guide";
import { flows, flow, maturityLabel } from "../../data/flows";

// Keep the chooser in sync with the catalog and the answers it offers.
const covered = new Set<string>();
for (const r of rules) {
  flow(r.flow);
  covered.add(r.flow);
  if (!Object.keys(r.when).length)
    throw new Error(`guide: "${r.flow}" has a rule with no conditions`);
  for (const [q, values] of Object.entries(r.when)) {
    const question = questions.find((x) => x.id === q);
    if (!question) throw new Error(`guide: unknown question "${q}"`);
    if (!values.length)
      throw new Error(`guide: "${r.flow}" has no answers for "${q}"`);
    for (const v of values) {
      if (!question.options.some((o) => o.value === v))
        throw new Error(`guide: unknown answer "${q}=${v}"`);
    }
  }
}
const missing = flows.filter((f) => !covered.has(f.slug));
if (missing.length)
  throw new Error(
    `guide: no rules for ${missing.map((f) => f.slug).join(", ")}`,
  );

// A situation is named from questions the guide asks, by one answer to each.
const label = (q: string, v: string) =>
  questions.find((x) => x.id === q)?.options.find((o) => o.value === v)?.label;
for (const s of situations) {
  for (const [q, values] of Object.entries(s.when)) {
    if (values.length !== 1 || !label(q, values[0]))
      throw new Error(
        `guide: situation "${s.slug}" needs one known answer to "${q}"`,
      );
  }
}

const data = {
  rules,
  cautions,
  deployLinks,
  situations: situations.map(({ slug, name, when, short }) => ({
    slug,
    name,
    when,
    short,
  })),
  roles: ROLE_TITLE,
  flows: Object.fromEntries(
    flows.map((f) => [
      f.slug,
      {
        short: f.short,
        maturity: maturityLabel(f),
        implementations: Boolean(implementationProfile(f.slug)),
      },
    ]),
  ),
};
---

<Base
  title="Choose an authorization flow for your agent"
  description="Answer six questions about your agent and get the authentication and authorization flows that fit, with reasons."
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Decision guide</p>
      <h1>Which flow fits your agent?</h1>
      <p class="lede">
        Six questions. Answer as many as you can; the recommendations update as you go and the address bar keeps your
        answers, so you can share the result. The first two answers also give the situation{' '}
        <a href="#situations">one of four names</a>. If the questions use words you have not met, <a href="/learn/">the
        lessons</a> teach them in about forty minutes.
        You can also <a href="/flows/">browse all {flows.length} flows</a>.
      </p>
    </div>
  </div>

  <div class="wrap">
    <decision-guide class="dg">
      <form class="dg-questions" id="questions" aria-label="About your agent">
        {
          questions.map((q, i) => (
            <fieldset>
              <legend>
                <span class="dg-num">{i + 1}</span>
                {q.title}
              </legend>
              {q.help && (
                <p class="dg-help">
                  {q.help}
                  {q.more && (
                    <>
                      {' '}
                      <a href={q.more.href}>{q.more.text}</a>.
                    </>
                  )}
                </p>
              )}
              <div class="dg-options">
                {q.options.map((o) => (
                  <label>
                    <input type="radio" name={q.id} value={o.value} data-fact={q.short} data-brief={o.brief} />
                    <span>
                      <strong>{o.label}</strong>
                      {o.hint && <em>{o.hint}</em>}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
        <p class="dg-foot">
          <button class="btn small ghost" type="reset">Start over</button>
          <a class="dg-jump" href="#results">View results<span class="dg-jump-n"></span></a>
        </p>
      </form>

      <aside class="dg-results" id="results" aria-live="polite" aria-label="Recommendations">
        <p class="dg-kicker">Recommendations</p>
        <div class="dg-out">
          <noscript>
            <p>
              The guide needs JavaScript to compute recommendations. Without it, the{' '}
              <a href="#situations">four situations</a> below each say where to start, and the <a href="/flows/"
                >flows page</a
              > groups every option by whether a human is involved.
            </p>
          </noscript>
        </div>
      </aside>

      <script type="application/json" class="dg-data" set:html={JSON.stringify(data)} />
    </decision-guide>
  </div>

  <section class="section" id="situations">
    <div class="wrap">
      <div class="section-head">
        <h2>Four situations, by name</h2>
        <p>
          The first two answers say whose authority a piece of access uses, and whether that person is there. Each
          pair has a name and a page. The names are this site’s own, not terms from a specification. A name describes
          one piece of access, not the agent: the same agent can act for a person in one call and on its own
          authority in the next.
        </p>
      </div>
      <div class="grid two">
        {
          situations.map((s) => (
            <a class="card" href={`/guide/${s.slug}/`}>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  import type { Rule } from '../../data/guide';
  import { type Answers, matches, recommend, situationFor } from '../../lib/guide-rules';

  interface Data {
    rules: Rule[];
    cautions: { when: Record<string, string[]>; text: string }[];
    situations: { slug: string; name: string; when: Record<string, string[]>; short: string }[];
    deployLinks: Record<string, { href: string; label: string }>;
    roles: Record<string, string>;
    flows: Record<string, { short: string; maturity: string; implementations: boolean }>;
  }

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  class DecisionGuide extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('form')!;
      const out = this.querySelector<HTMLElement>('.dg-out')!;
      const data: Data = JSON.parse(this.querySelector('.dg-data')!.textContent!);
      const jump = this.querySelector<HTMLElement>('.dg-jump-n');
      const names = [...new Set([...form.querySelectorAll<HTMLInputElement>('input[type=radio]')].map((i) => i.name))];

      const read = (): Answers => {
        const fd = new FormData(form);
        const a: Answers = {};
        for (const n of names) {
          const v = fd.get(n);
          if (typeof v === 'string') a[n] = v;
        }
        return a;
      };

      const render = (push = true) => {
        const a = read();
        const answered = Object.keys(a).length;

        if (push) {
          const qs = new URLSearchParams(a).toString();
          history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}`);
        }

        if (answered === 0) {
          if (jump) jump.textContent = '';
          out.innerHTML = `<p class="dg-empty">Pick an answer to any question. Start with the first: it decides whose name ends up on the token.</p>`;
          return;
        }

        // best rule per flow; a "start" beats an "add" beats a "consider"
        const groups = recommend(data.rules, a);

        let html = '';
        const total = groups.start.length + groups.add.length + groups.consider.length;
        const count = `${total} ${total === 1 ? 'match' : 'matches'}`;
        if (jump) jump.textContent = ` · ${count}`;
        // The address holds every answer. Where the browser can copy it, a button does.
        const copy = navigator.clipboard
          ? `<button class="btn small ghost dg-copy" type="button">Copy result link</button>`
          : '';
        html += `<div class="dg-top"><p class="dg-status">${answered} of ${names.length} answered · ${count}</p><p class="dg-tools"><a class="dg-edit" href="#questions">Edit answers</a>${copy}<span class="dg-copied"></span></p></div>`;

        // The name of the situation, once the questions it comes from are answered,
        // then every other answer as a fact with the word for its question: the name
        // stands for two of them, and a reader who repeats it should see the rest.
        const sit = situationFor(data.situations, a);
        const facts = names
          .filter((n) => a[n] != null && !(sit && n in sit.when))
          .map((n) => {
            const input = form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)!;
            return `<div><dt>${esc(input.dataset.fact ?? '')}</dt><dd>${esc(input.dataset.brief ?? '')}</dd></div>`;
          });
        // A section like the ones after it: a heading, then the name as those
        // list a flow, with what the name stands for where a flow has its status.
        html += `<section class="dg-group dg-answers"><h2>Your answers</h2>`;
        if (sit) {
          html += `<a class="dg-flow" href="/guide/${sit.slug}/"><strong>${esc(sit.name)}</strong><span class="dg-meta">${Object.keys(sit.when).length === 1 ? 'First answer' : 'First two answers'}</span></a>`;
        }
        if (facts.length) html += `<dl class="dg-facts">${facts.join('')}</dl>`;
        html += `</section>`;

        if (total === 0) {
          html += `<p class="dg-empty">No flow matches that exact combination. Try relaxing an answer, or browse <a href="/flows/">all flows</a>.</p>`;
        }

        for (const role of ['start', 'add', 'consider'] as const) {
          const list = groups[role];
          if (!list.length) continue;
          html += `<section class="dg-group dg-${role}"><h2>${esc(data.roles[role])}</h2><ul>`;
          for (const r of list) {
            const f = data.flows[r.flow];
            const evidence = f.implementations
              ? `<p class="dg-evidence"><a href="/implementations/${r.flow}/" aria-label="See implementations for ${esc(f.short)}">See implementations</a></p>`
              : '';
            html += `<li><a class="dg-flow" href="/flows/${r.flow}/"><strong>${esc(f.short)}</strong><span class="dg-meta">${esc(f.maturity)}</span></a><p>${esc(r.why)}</p>${evidence}</li>`;
          }
          html += `</ul></section>`;
        }

        const warn = data.cautions.filter((c) => matches(c.when, a, true));
        if (warn.length) {
          html += `<section class="dg-group dg-caution"><h2>Watch out</h2><ul>`;
          for (const c of warn) html += `<li><p>${esc(c.text)}</p></li>`;
          html += `</ul></section>`;
        }

        const dep = a.runtime ? data.deployLinks[a.runtime] : undefined;
        if (dep) {
          html += `<p class="dg-deploy">Deployment notes: <a href="${dep.href}">${esc(dep.label)} →</a></p>`;
        }

        out.innerHTML = html;
      };

      // restore from URL
      const params = new URLSearchParams(location.search);
      // Older shared links used "internal" as a target without naming an interface.
      if (params.get('target') === 'internal') {
        params.delete('target');
        if (!params.has('boundary')) params.set('boundary', 'same');
      }
      for (const n of names) {
        const v = params.get(n);
        if (!v) continue;
        const input = form.querySelector<HTMLInputElement>(`input[name="${n}"][value="${CSS.escape(v)}"]`);
        if (input) input.checked = true;
      }
      render(false);

      out.addEventListener('click', async (e) => {
        const button = (e.target as Element).closest('.dg-copy');
        if (!button) return;
        const said = out.querySelector('.dg-copied');
        try {
          await navigator.clipboard.writeText(location.href);
          if (said) said.textContent = 'Copied, with every answer';
        } catch {
          if (said) said.textContent = 'Not copied: the address bar has the same link';
        }
      });

      form.addEventListener('change', () => render());
      form.addEventListener('reset', () => {
        // the form forgets its answers, so the record of which one was selected has to go too:
        // otherwise the next click on a former answer is taken as clearing it
        form.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((i) => (i.dataset.was = 'false'));
        setTimeout(() => render(), 0);
      });
      // clicking a selected option again clears it
      form.addEventListener('click', (e) => {
        // A click on a label is followed by a synthesized click on its input.
        // Handle only that second event, so each selection is processed once.
        const input = e.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'radio') return;
        if (input.dataset.was === 'true') {
          e.preventDefault();
          setTimeout(() => {
            input.checked = false;
            input.dataset.was = 'false';
            render();
          }, 0);
        } else {
          form.querySelectorAll<HTMLInputElement>(`input[name="${input.name}"]`).forEach((i) => (i.dataset.was = 'false'));
          input.dataset.was = 'true';
        }
      });
      form.querySelectorAll<HTMLInputElement>('input:checked').forEach((i) => (i.dataset.was = 'true'));
    }
  }
  customElements.define('decision-guide', DecisionGuide);
</script>

<style>
  /* Questions on one side, recommendations on the other, with one quiet line
     between them. Nothing here is a box inside a box: groups are set apart by
     space and by a rule under a heading. The page scrolls as one. */
  .dg {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    padding-block: clamp(1.6rem, 4vw, 2.6rem);
  }
  @media (min-width: 62rem) {
    .dg {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
    .dg-results {
      padding-left: 3rem;
      border-left: 1px solid var(--border);
    }
    .dg-out :global(.dg-edit) {
      display: none;
    }
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 1.6rem;
  }
  legend {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-family: var(--font-heading);
    font-size: 1.32rem;
    font-weight: 560;
    line-height: 1.2;
    padding: 0;
    margin-bottom: 0.3rem;
  }
  /* The number is a number: which questions are answered shows in the radios. */
  .dg-num {
    flex: none;
    width: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg-muted);
  }
  .dg-help {
    margin: 0 0 0.3rem 1.9rem;
    font-size: 0.92rem;
    color: var(--fg-muted);
  }

  /* An answer is a row with a radio button, and the whole row is the target. */
  .dg-options {
    display: grid;
    margin: 0.5rem 0 0 1.9rem;
  }
  .dg-options label {
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: var(--radius);
  }
  .dg-options input {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.14rem 0 0;
    accent-color: var(--accent);
    cursor: pointer;
    /* reached with the keyboard, it stops clear of the strip at the foot */
    scroll-margin-bottom: 4.5rem;
  }
  .dg-options strong {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .dg-options em {
    display: block;
    font-style: normal;
    font-size: 0.82rem;
    color: var(--fg-muted);
    line-height: 1.35;
    margin-top: 0.1rem;
  }
  .dg-options label:hover {
    background: var(--bg-raised);
  }
  /* chosen: the filled radio, a heavier label, and the accent */
  .dg-options input:checked + span strong {
    font-weight: 600;
    color: var(--accent);
  }
  .dg-options label:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .dg-options input:focus-visible {
    outline: none;
  }

  /* Start over, and the way to the recommendations with how many there are.
     It stays at the foot of the window for as long as the questions are on
     screen: on a phone the recommendations are far below them, and beside
     them on a wide screen the top of the list has scrolled away. */
  .dg-foot {
    position: sticky;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin: 0;
    padding: 0.6rem 0;
    background: var(--bg);
    border-top: 1px solid var(--border-strong);
  }
  .dg-jump {
    font-weight: 500;
  }
  @media (max-width: 61.99rem) {
    .dg-foot {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
  }

  .dg-kicker {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 560;
    margin: 0 0 0.3rem;
  }
  .dg-out :global(.dg-top) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .dg-out :global(.dg-status) {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0;
  }
  .dg-out :global(.dg-tools) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: 0;
    font-size: 0.88rem;
  }
  .dg-out :global(.dg-copied) {
    color: var(--fg-muted);
  }
  .dg-out :global(.dg-copied:empty) {
    display: none;
  }
  .dg-out :global(.dg-answers .dg-flow) {
    padding-top: 0.7rem;
  }
  /* each answer on a line of its own: the word for the question, then the answer */
  .dg-out :global(.dg-facts) {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.15rem 1.6rem;
    margin: 0.5rem 0 0;
    font-size: 0.93rem;
    line-height: 1.5;
  }
  .dg-out :global(.dg-facts div) {
    display: contents;
  }
  .dg-out :global(.dg-facts dt) {
    color: var(--fg-muted);
  }
  .dg-out :global(.dg-facts dd) {
    margin: 0;
  }
  .dg-out :global(.dg-empty) {
    color: var(--fg-muted);
    margin: 0.4rem 0 0;
  }
  .dg-out :global(.dg-group) {
    margin-top: 1.4rem;
  }
  .dg-out :global(.dg-group h2) {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1.5px solid var(--fg);
    color: var(--fg);
  }
  .dg-out :global(.dg-start h2) {
    color: var(--green);
    border-color: var(--green);
  }
  .dg-out :global(.dg-caution h2) {
    color: var(--red);
    border-color: var(--red);
  }
  .dg-out :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dg-out :global(li) {
    margin: 0;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }
  .dg-out :global(li:last-child) {
    border-bottom: 0;
    padding-bottom: 0.2rem;
  }
  .dg-out :global(.dg-flow) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.8rem;
    text-decoration: none;
  }
  .dg-out :global(.dg-flow strong) {
    font-family: var(--font-heading);
    font-size: 1.16rem;
    font-weight: 560;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.18em;
  }
  .dg-out :global(.dg-meta) {
    font-family: var(--font-label);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .dg-out :global(li p) {
    margin: 0.25rem 0 0;
    font-size: 0.93rem;
    line-height: 1.5;
  }
  .dg-out :global(.dg-deploy) {
    margin: 1.1rem 0 0;
    padding-top: 0.8rem;
    border-top: 1.5px solid var(--fg);
    font-size: 0.93rem;
  }
</style>
