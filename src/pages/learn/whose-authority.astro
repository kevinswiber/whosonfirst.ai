---
import Lesson from "../../layouts/Lesson.astro";
import Check from "../../components/Check.astro";
import Mixup from "../../components/Mixup.astro";
import Scenario from "../../components/Scenario.astro";
import type {
  CheckQuestion,
  Scenario as ScenarioData,
} from "../../data/learn/types";

/*
 * What this lesson says about getting a token with no user restates
 * data/flows/client-credentials.ts and data/flows/workload-identity-federation.ts,
 * and must not contradict them. In particular the second was corrected against
 * saying that no credential exists: the credentials are short-lived, not absent.
 */
const PERSON = "A person’s";
const OWN = "Its own";

/** Five agents to sort. The fifth is the arrangement the lesson ends on. */
const sort: CheckQuestion[] = [
  {
    id: "sort-mail",
    question: "An assistant that summarizes your unread email each morning.",
    options: [
      {
        text: PERSON,
        correct: true,
        why: "Yours. It should be able to read your mailbox and nobody else’s, and a token that names you is what makes the mail service enforce that.",
      },
      {
        text: OWN,
        why: "Then it needs access to every mailbox it might ever summarize, and all that keeps it in yours is the agent itself: its code, and its word about whose request this is.",
      },
    ],
  },
  {
    id: "sort-invoices",
    question:
      "A nightly job that flags invoices that do not match a purchase order.",
    options: [
      {
        text: PERSON,
        why: "Nobody in particular asked for tonight’s run, and it should not stop working when one employee leaves. The work belongs to the organization.",
      },
      {
        text: OWN,
        correct: true,
        why: "No person is involved. An administrator decides once what this job may read and write, and the job runs as itself.",
      },
    ],
  },
  {
    id: "sort-support",
    question:
      "A support bot that tells each customer the status of their own orders, and must never show one customer another’s.",
    options: [
      {
        text: PERSON,
        correct: true,
        why: "Each customer’s. The answer depends on who is asking, so each request should carry that customer’s authority, and the order system can then refuse anything else.",
      },
      {
        text: OWN,
        why: "It is often built this way. But then the order system sees one caller for every customer, and whatever keeps customer A out of customer B’s orders rests on the bot’s word about who is asking. That is the API key problem from the first lesson.",
      },
    ],
  },
  {
    id: "sort-digest",
    question:
      "An agent that posts a digest of yesterday’s deploys to the team channel.",
    options: [
      {
        text: PERSON,
        why: "The digest is the same whoever is reading it, and it runs on a schedule. There is no one whose access it would be borrowing.",
      },
      {
        text: OWN,
        correct: true,
        why: "Scheduled, shared, and the same for everyone. It reads deploy records and posts to one channel, as itself.",
      },
    ],
  },
  {
    id: "sort-receipts",
    question:
      "Alice asks an agent to watch her inbox while she is on vacation and file her receipts.",
    options: [
      {
        text: PERSON,
        correct: true,
        why: "Alice’s. But notice that she will not be there. The agent holds her access, on a refresh token, with nobody watching. Keep reading: this combination has a section of its own.",
      },
      {
        text: OWN,
        why: "It is her mailbox, so it is her authority. An agent with its own standing access to mailboxes could read anyone’s.",
      },
    ],
  },
];

const vouch: ScenarioData = {
  id: "platform-identity",
  legend: "The agent’s identity",
  cast: [
    { label: "Platform", sub: "runs the job", role: "infra" },
    { label: "Agent", sub: "the invoice job", role: "agent" },
    { label: "Authorization server", role: "authz" },
    { label: "Billing API", role: "resource" },
  ],
  asks: "The same three questions",
  questions: ["Who is acting?", "For whom?", "Who said they could?"],
  options: [
    {
      id: "platform",
      name: "Issued by the platform",
      hops: [
        "a signed note: “this is the invoice job”",
        "trades the note for an access token",
        "access token",
      ],
      exhibits: [
        {
          caption: "What the access token says",
          lang: "yaml",
          text: `about:      invoice-job
issued to:  invoice-job
for:        billing.example
allows:     read invoices
expires:    in 10 minutes`,
        },
      ],
      findings: [
        {
          note: "The invoice job. The platform that started it vouches for that, so no long-lived secret had to be stored for the job.",
        },
        {
          note: "Nobody. The token is about the agent itself: the same name appears twice.",
        },
        {
          note: "An administrator, in advance, by writing a rule: this job may read invoices. Nobody approved tonight’s run.",
        },
      ],
      so: `Everything from the token lesson still holds: one audience, a narrow scope, a short life. What changes is who the token is about, and that **the only limit on this agent is the rule an administrator wrote.**`,
    },
  ],
};

const checks: CheckQuestion[] = [
  {
    id: "identity",
    question:
      "Your agent runs as a nightly job and calls an internal billing API. Security asks what identity it runs as. Which is the best answer?",
    options: [
      {
        text: "Its own: an identity the platform issues to that one job.",
        correct: true,
        why: "It names one workload, it is issued where the job runs so nothing long-lived has to be stored, and what it can reach is written down in one rule: here, billing and nothing else.",
      },
      {
        text: "A shared one: the API key we keep in an environment variable for our services.",
        why: "That is a credential, not an identity. It usually has no expiry, it has to be stored and replaced by hand, and anyone who copies it is the job.",
      },
      {
        text: "Mine: I set the job up, so it runs under my own account and permissions.",
        why: "Then the job can do everything you can, its actions are logged as yours, and it breaks or lingers when you change teams.",
      },
    ],
  },
  {
    id: "sub",
    question:
      "An agent gets a token as itself, with no user involved. Who does the token say it is about?",
    options: [
      {
        text: "The administrator who set the agent up.",
        why: "The administrator wrote the rule, but is not named in the token. The token is about whoever’s authority is being used: here, the agent’s own.",
      },
      {
        text: "The agent itself.",
        correct: true,
        why: "With no user, the agent is both the app the token was issued to and the subject it is about.",
      },
      {
        text: "Nobody. That part is left empty.",
        why: "A token is always about someone or something. Here it is the agent.",
      },
    ],
  },
  {
    id: "unattended",
    question:
      "Alice connects her mailbox to an agent and leaves for two weeks. The agent keeps working on a refresh token. What is the main risk?",
    options: [
      {
        text: "The refresh token may expire while she is away, and the agent will stop working.",
        why: "That would be an inconvenience. The risk is in what the agent can do while it keeps working.",
      },
      {
        text: "The mail service cannot tell which app is using Alice’s access.",
        why: "It can: the token names the client it was issued to. The trouble is how much that app can do while unsupervised.",
      },
      {
        text: "Whatever the agent is talked into doing, it does as Alice, and nobody is watching.",
        correct: true,
        why: "A person’s authority, and no person present to notice. Narrow the scope, keep a way to reach Alice for anything that cannot be undone, and know how the grant is revoked.",
      },
    ],
  },
];
---

<Lesson
  slug="whose-authority"
  lede="A nightly job has no Alice to click Allow. So whose access does it use? Settle that before you choose a protocol, because everything else follows from it."
  checks={checks}
  keep={[
    "Every request uses somebody’s authority: a person’s, or the agent’s own. Decide which first.",
    "**Acting for a person:** the token names the person, and what they can do is the ceiling.",
    "**Acting as itself:** the token names the agent, and the rule an administrator wrote is the only limit.",
    "An agent’s own identity is best issued by the platform it runs on and short-lived, not stored as a secret.",
    "A person’s access with no person watching needs a narrow scope, a way to reach the person, and a way to switch it off.",
  ]}
  names={[
    ["Whoever’s authority a request uses", "Principal"],
    ["An account that belongs to software", "Service account"],
    ["Getting a token as itself, with no user", "Client credentials"],
    ["A running piece of software, such as the invoice job", "Workload"],
    ["An identity the platform issues to it", "Workload identity"],
    ["One system accepting identities that another issued", "Federation"],
  ]}
>
  <h2>Two answers, and only two</h2>
  <p>Every request an agent makes uses somebody’s authority. There are two possibilities.</p>
  <ul>
    <li>
      <strong>A person’s.</strong> The token names that person. What the agent can do is capped by what the person
      can do, and by what they approved. This is what the previous lesson showed.
    </li>
    <li>
      <strong>Its own.</strong> The token names the agent. No person lent it their access. An administrator decided
      in advance what this agent is allowed to do.
    </li>
  </ul>
  <p>
    This guide calls whoever’s authority is being used the <strong>principal</strong>. Which of the two it should be
    is not a matter of taste. It follows from the work.
  </p>
  <p>
    Whose authority is one question. Which software is acting is another, and a token can answer both: one that
    names Alice also names the app it was issued to. The next lesson puts a second piece of software on the path.
  </p>

  <Check
    id="sort"
    title="Sort five agents"
    intro="For each one, whose authority should it use? Choose, then read why."
    questions={sort}
  />

  <p>
    The pattern in those five: the mail assistant, the support bot and the agent filing Alice’s receipts act for a
    person. The invoice job and the deploy digest act as themselves. A rule of thumb that covers most cases:
  </p>
  <ul>
    <li>If the right answer depends on who is asking, the agent acts for that person.</li>
    <li>If the work belongs to a team or a company, and runs on a schedule or a trigger, the agent acts as itself.</li>
  </ul>

  <h2>How an agent proves it is itself</h2>
  <p>
    Acting as itself, the agent still needs a token, and the routine is a shorter version of the previous lesson. It
    proves which software it is to the authorization server, gets a short-lived access token, and sends that to the
    API. There is no browser and no consent screen, because there is no user. OAuth calls this{' '}
    <strong>client credentials</strong>.
  </p>
  <p>
    Which service plays the authorization server depends on where the agent runs. Inside a company it is usually
    the sign-in system its services already trust. In a cloud it is the cloud’s own token service. On Kubernetes
    the cluster can play the part itself. The pod asks for a token addressed to the API it is going to call, and
    that API asks the cluster whether the token is good and was meant for it. The token a pod gets by default is
    addressed to the cluster itself: never send that one anywhere else.
  </p>
  <p>
    The interesting part is the first step. What does the agent prove itself <em>with</em>? There are three common
    answers, and they are not equally good.
  </p>

  <div class="table-scroll wide" tabindex="0" role="region" aria-label="Three ways an agent proves it is itself">
    <table class="ways">
      <thead>
        <tr>
          <th scope="col"></th>
          <th scope="col">A key it stores</th>
          <th scope="col">A secret it trades for tokens</th>
          <th scope="col">An identity from its platform</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">What the agent holds</th>
          <td>One long-lived API key, sent on every request</td>
          <td>A long-lived client secret or private key, and short-lived tokens</td>
          <td>Short-lived credentials only</td>
        </tr>
        <tr>
          <th scope="row">Who issues it</th>
          <td>Whoever runs the API</td>
          <td>The authorization server, for a secret. A key pair is your own, with the public half registered there</td>
          <td>The platform the agent runs on: a cloud, Kubernetes, a CI system</td>
        </tr>
        <tr>
          <th scope="row">If a copy leaks</th>
          <td>It works until someone notices and replaces it</td>
          <td>A token stops in minutes. The secret works until it is replaced</td>
          <td>It stops when it expires: minutes to hours, depending on the platform</td>
        </tr>
        <tr>
          <th scope="row">Who replaces it</th>
          <td>You, by hand</td>
          <td>You, by hand</td>
          <td>The platform, on its own</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    The third column is called <strong>workload identity</strong>. The platform that started the agent already
    knows exactly what it started, so it can vouch for it. It hands the job a short, signed note saying what the job
    is, and replaces the note before it expires. The job trades that note for access.
  </p>
  <p>
    Nothing had to be stored, but there is still something to take. Anything running inside the job can pick that
    note up, including a command or a web request the model was talked into making. Keep it, and the local address
    the platform hands it out from, out of reach of the model’s tools.
  </p>

  <Scenario scenario={vouch} title="An identity nobody had to store for the agent" />

  <p>
    In the figure the platform and the authorization server are two different systems, and the second has agreed to
    accept identities that the first one issues. That agreement is called <strong>federation</strong>. A cloud
    accepting a note from your CI system is the usual example. Where a platform’s own services accept its own notes,
    nothing is federated: it is all one system.
  </p>

  <Mixup belief="A service account is the safe choice, because no user’s access is involved.">
    <p>
      An agent acting as itself is limited only by what an administrator gave it. Review that grant when the job
      changes, so it does not keep access the work no longer needs. If it serves several people under that one
      identity, the API cannot tell them apart, which is the first lesson again. Acting as itself is right when the
      work is the organization’s. It is not a shortcut around sign-in.
    </p>
  </Mixup>

  <h2>The trap in the middle</h2>
  <p>
    The fifth agent in the exercise was neither one thing nor the other: Alice’s access, and no Alice. It can
    do whatever her grant allows, and nobody is there to notice a mistake or to stop it.
  </p>
  <p>Sometimes it is what the job needs. If you find yourself there:</p>
  <ul>
    <li>Ask for the narrowest scope that does the work. Filing receipts does not need permission to send mail.</li>
    <li>Find a way to reach the person for anything that cannot be undone. The final lesson shows how.</li>
    <li>Know how the access is switched off, and who can do it, before the agent runs for the first time.</li>
  </ul>
</Lesson>

