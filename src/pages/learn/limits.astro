---
import Lesson from "../../layouts/Lesson.astro";
import Mixup from "../../components/Mixup.astro";
import Scenario from "../../components/Scenario.astro";
import type {
  CheckQuestion,
  Scenario as ScenarioData,
} from "../../data/learn/types";

/**
 * Three things that go wrong, and five controls, each asked the same question:
 * does it help here? No control helps with all three, which is the point.
 * The controls are the flows DPoP, OAuth mTLS, credential broker, step-up and CIBA;
 * nothing here may contradict those pages.
 */
const failures: ScenarioData = {
  id: "failures",
  legend: "What goes wrong",
  cast: [
    { label: "Agent", sub: "holds Alice’s token", role: "agent" },
    { label: "Calendar API", role: "resource" },
  ],
  asks: "Does it help?",
  questions: [
    "A short-lived token",
    "A narrow scope",
    "A token bound to a key",
    "Credentials kept out of the model’s reach",
    "Asking a person first",
  ],
  options: [
    {
      id: "copied",
      name: "A token is copied from a log",
      cast: [
        { label: "Someone else", sub: "has a copy", role: "agent" },
        { label: "Calendar API", role: "resource" },
      ],
      hops: ["a request, with the copied token"],
      findings: [
        {
          verdict: "partly",
          note: "The copy works until the token expires. Minutes, not months.",
        },
        {
          verdict: "partly",
          note: "It limits the copy to reading one calendar. It does not stop it.",
        },
        {
          verdict: "yes",
          note: "An API that checks proof of the bound key refuses the token alone, and the key was never in the log. With DPoP, a captured proof may briefly be replayed at the same address unless the API detects it.",
        },
        {
          verdict: "partly",
          note: "It removes one place to leak from. Logs and proxies are others.",
        },
        {
          verdict: "no",
          note: "Reading a calendar is not a step anyone would be asked about.",
        },
      ],
      so: `A stolen token is a real token. Two things limit what it is worth: **time**, because it expires, and **proof**, because an API that checks the binding refuses a token that arrives without proof of the key.`,
    },
    {
      id: "misuse",
      name: "The agent is talked into doing something",
      cast: [
        { label: "Agent", sub: "read a poisoned page", role: "agent" },
        { label: "Calendar API", role: "resource" },
      ],
      hops: ["a request to delete every event, with its own token"],
      findings: [
        {
          verdict: "no",
          note: "The agent is using its own, valid token. Expiry is beside the point.",
        },
        {
          verdict: "partly",
          note: "A read-only token cannot delete, so this request is refused. Whatever the token does allow, the agent can still be talked into.",
        },
        {
          verdict: "no",
          note: "The agent holds the key. It is the agent that was fooled.",
        },
        {
          verdict: "no",
          note: "Nothing is being leaked. The agent is misusing access it really has.",
        },
        {
          verdict: "yes",
          note: "If the API will not delete without Alice’s approval, the request stops in front of her.",
        },
      ],
      so: `A tricked agent uses real credentials, so neither time nor proof helps. **What holds is what the token cannot do**, and a person standing in front of anything that cannot be undone.`,
    },
    {
      id: "leak",
      name: "The agent is talked into leaking its credentials",
      cast: [
        { label: "Agent", sub: "read a poisoned page", role: "agent" },
        { label: "Attacker’s server", role: "resource" },
      ],
      hops: ["a request carrying whatever it could read"],
      findings: [
        {
          verdict: "partly",
          note: "An access token works only for the minutes it has left. A refresh token or an API key keeps working.",
        },
        { verdict: "partly", note: "It limits what the thief gets." },
        {
          verdict: "yes",
          note: "A bound token is refused without its key, as long as the key is somewhere the model cannot read.",
        },
        {
          verdict: "yes",
          note: "The model cannot repeat a secret it was never shown. It must not be able to choose where your code sends that secret, either.",
        },
        { verdict: "no", note: "Nobody is asked before text is sent." },
      ],
      so: `**Anything the model can read, text on a web page can ask it to repeat.** So the strongest answer is about where things are kept: the credential never enters the model’s context, and ideally never enters its sandbox.`,
    },
  ],
};

const checks: CheckQuestion[] = [
  {
    id: "bound",
    question:
      "An attacker copies a token that is bound to a key. They do not have the key. What can they do with the token?",
    options: [
      {
        text: "Nothing, at an API that checks the binding: it wants proof of the key.",
        correct: true,
        why: "The caller must prove possession of the private key the token is bound to. A copy sent alone fails that check. The API must enforce the proof and binding: one that ignores them would accept the copy.",
      },
      {
        text: "Use it at that API until it expires, like any other token.",
        why: "That is true of a plain bearer token. A bound token also requires proof that the caller holds the associated private key.",
      },
      {
        text: "Use it once, since each proof is single-use.",
        why: "They cannot make a proof at all. That takes the private key, which was never sent anywhere.",
      },
    ],
  },
  {
    id: "delete",
    question:
      "An agent holding a read-only calendar token is tricked by a web page into trying to delete every event. What stops it?",
    options: [
      {
        text: "Its system prompt, which says never to delete anything.",
        why: "The page’s text is competing with the prompt, and may win. A prompt is an instruction to the model, not a limit on it.",
      },
      {
        text: "The token’s short lifetime, which is over within minutes.",
        why: "The token is valid when the agent uses it. A short life limits a thief, not the token’s rightful holder.",
      },
      {
        text: "The calendar API, which checks the token’s scope.",
        correct: true,
        why: "The token’s scope does not cover deleting, so the API refuses. It checks on every request, and it makes no difference why the agent tried.",
      },
    ],
  },
  {
    id: "where",
    question: "Where should an agent’s long-lived credentials be kept?",
    options: [
      {
        text: "In an environment variable inside the sandbox where the agent runs code.",
        why: "Code the agent runs there can read its environment, and so can anything that code was talked into running.",
      },
      {
        text: "Outside the model’s reach: held by the program around it, or behind a proxy.",
        correct: true,
        why: "The model asks for a tool to be called. Your code, or a proxy outside the sandbox, attaches the credential, and only for the address it was meant for. The model sees the result and never the secret.",
      },
      {
        text: "In each tool’s description, so the model knows which key goes with which tool.",
        why: "A tool’s description is part of what the model reads, so it can be repeated to anyone whose text the model reads.",
      },
    ],
  },
];
---

<Lesson
  slug="limits"
  lede="Sooner or later a token is copied, and sooner or later the agent is talked into something. A good design assumes both, and decides in advance how little each one costs."
  checks={checks}
  keep={[
    "Plan for two failures: a credential leaks, and the agent is talked into something.",
    "**Time and proof** limit a leak: short lives, and tokens bound to a key.",
    "**Scope and approval** limit a tricked agent: narrow tokens, and a person asked at the API’s insistence.",
    "Anything the model can read can be drawn out of it. Keep credentials where it cannot, and let your code decide where they are sent.",
    "No token setting stops an agent passing on what it was allowed to read. Limit where it can send.",
    "A limit in a prompt is a suggestion. A limit at the API is a control.",
  ]}
  names={[
    ["Text written to be taken as instructions", "Prompt injection"],
    ["A token only the holder of a key can use", "Sender-constrained token"],
    ["Showing that you hold the key the token is bound to", "Proof of possession"],
    ["One common way of doing that", "DPoP"],
    ["The API sending the agent back for a fresh sign-in or a wider approval", "Step-up"],
  ]}
>
  <h2>Two failures to plan for</h2>
  <p>Every lesson so far has ended on a caution. Here they are, side by side.</p>
  <ul>
    <li>
      <strong>A credential leaks.</strong> Tokens end up in logs, in error reports, in debugging sessions and in
      the memory of the agent that used them. A plain token works for whoever holds a copy.
    </li>
    <li>
      <strong>The agent is talked into something.</strong> An agent reads web pages, emails, documents and the
      output of tools, and any of them can contain text written to be taken as instructions. This is called{' '}
      <strong>prompt injection</strong>, and nobody has a way to rule it out.
    </li>
  </ul>
  <p>
    You cannot prevent either for certain. What you can decide is what each one costs. Five controls do most of
    that work. Before you look, guess: does any one of them help with everything that can go wrong?
  </p>

  <Scenario scenario={failures} glance="All three at a glance" />

  <p>
    Read the table down a column and no control says yes three times. That is why designs use several: each one
    covers a failure the others miss.
  </p>

  <h2>The five controls</h2>
  <p>
    <strong>Keep tokens short-lived.</strong> Minutes for an access token. A refresh token makes that painless for
    the agent, and the short life limits what a copy is worth. It is the cheapest control here, and the one already
    built in.
  </p>
  <p>
    <strong>Ask for little, and ask late.</strong> One audience and the narrowest scope that does the job, requested
    when a task needs it. An agent that holds only <code>calendar.read</code> cannot be talked into deleting
    anything. It can still be talked into reading, so a narrow scope shrinks the damage without removing it.
  </p>
  <p>
    And what it reads, it can be talked into sending somewhere else. No token setting stops that. Limit where the
    agent can send things, and take most care with an agent that can do all three: read private data, read text
    written by strangers, and send messages out.
  </p>
  <p>
    <strong>Bind the token to a key.</strong> A <strong>sender-constrained token</strong> requires the caller to prove
    it holds the associated private key. This is called <strong>proof of possession</strong>. With DPoP, every HTTP
    request carries a signed proof. With <a href="/flows/oauth-mtls/">OAuth mTLS</a>, the caller proves key possession
    during TLS, and the API matches the token’s binding to the certificate used on that connection. An API that checks
    the proof and binding refuses a copy of the token sent alone. The private key is held by your code or
    by the platform’s key store, never where the model can read it: a key the model could repeat would be no better
    than a token it could repeat.
  </p>
  <p>
    <strong>Keep credentials out of the model’s reach.</strong> The model decides which tool to call. Your code makes
    the call and attaches the token, and only to the API that token is for. The address comes from your code, never
    from the model: a model that can choose where a request goes can be talked into sending the token there without
    ever seeing it. Take secrets out of anything handed back to the model, error messages included. A stronger
    version puts the secret outside the agent’s sandbox altogether, behind a proxy that adds it to outgoing requests
    and only for the hosts it was meant for.
  </p>
  <p>
    <strong>Ask a person when it matters.</strong> For anything that cannot be undone, the API refuses the everyday
    token and says what it needs. The agent sends the person back to the authorization server, to sign in again or
    to approve more. This is called <strong>step-up</strong>. When the request also describes the one action, the
    token that comes back is good for exactly that. If the person is not at the keyboard, the authorization server
    can reach them on their phone instead.
  </p>

  <Mixup belief="My agent asks the user to confirm before doing anything risky, so risky actions are covered.">
    <p>
      An agent that asks is being polite. An agent that has been tricked may not ask, or may report an approval that
      was never given. The approval counts when the API demands it and the authorization server records it, because
      neither of those can be talked out of it.
    </p>
  </Mixup>

  <h2 id="no-other-way">When a password is the only way in</h2>
  <p>
    Lesson 3 said an agent never asks a user for their password. Some services leave no alternative: an old
    internal system that knows only usernames and passwords, or a website with a sign-in page and no API. Signing in
    there as a person is impersonation however carefully it is done. The service cannot tell the agent from the
    person and will not limit it. So the work is to limit what that costs.
  </p>
  <ul>
    <li>
      <strong>Give the agent an account of its own</strong>, where the service allows one, with only the access the
      job needs. Its actions are then recorded as the agent’s, and the account can be closed without locking a
      person out.
    </li>
    <li>
      <strong>Keep that account’s password away from the model.</strong> It lives in a secrets store. Your code, or
      a proxy outside the agent’s sandbox, fills it in. The model asks to be signed in and never sees what was
      typed. This is for the agent’s own account. A person’s password is never stored at all, as the next point
      says.
    </li>
    <li>
      <strong>If it has to be a person’s account, the person signs in.</strong> Show them the service’s own sign-in
      page, and let the password and any code from their phone go from them to the service. Nothing they type
      should pass through the model or be saved. What the agent holds afterward is a signed-in session, and while
      it lasts that session can do what the password could. Keep it short, keep it out of the model’s reach, and
      end it when the task is done.
    </li>
    <li>
      <strong>Put your own limits in front.</strong> The service will refuse the agent nothing the account can do.
      So the limit has to be in the code that drives the session, not in the prompt: which pages it may open, and
      which actions wait for a person to approve.
    </li>
  </ul>
  <p>
    None of this makes the arrangement good. It makes it smaller. Check that the service allows automated use at
    all, and where you have any say, ask its owner for the real thing: an API that accepts tokens with a scope.
  </p>

  <h2>One rule under all of it</h2>
  <p>
    The agent is the part of your system that reads untrusted text and acts on it. So nothing that matters should
    depend on the agent behaving. Put the limit in the token, enforce it at the API, keep the secret out of reach,
    and leave the agent free to be as helpful as it can within that.
  </p>
  <p>
    That is the last of the lessons. You have the model the rest of this guide is built on: what an API can see, what a
    token says, how an agent gets one for a person or for itself, what happens down a chain, and what limits the
    damage. The pages from here on are the same ideas at full size.
  </p>
</Lesson>
