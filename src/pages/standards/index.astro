---
import Base from "../../layouts/Base.astro";
import DocMeta from "../../components/DocMeta.astro";
import { standards, std } from "../../data/standards";
import { flows } from "../../data/flows";
import { REVIEWED } from "../../data/site";
import {
  RELATED_LABEL,
  STATUS_LABEL,
  STATUS_TONE,
  TOPIC_LABEL,
} from "../../data/types";
import type { StdStatus, StdTopic } from "../../data/types";
import { inline } from "../../lib/md";

const statuses = (Object.keys(STATUS_LABEL) as StdStatus[]).filter((s) =>
  standards.some((x) => x.status === s),
);
const topics = (Object.keys(TOPIC_LABEL) as StdTopic[]).filter((t) =>
  standards.some((x) => x.topics.includes(t)),
);
const bodies = [...new Set(standards.map((s) => s.body))].sort(
  (a, b) =>
    standards.filter((s) => s.body === b).length -
    standards.filter((s) => s.body === a).length,
);
const count = (fn: (s: (typeof standards)[number]) => boolean) =>
  standards.filter(fn).length;
const usedIn = (id: string) => flows.filter((f) => f.standards.includes(id));
const published = count((x) => x.status === "rfc" || x.status === "final");
const draftCount = count(
  (x) => x.status === "wg-draft" || x.status === "draft",
);
const details = [
  {
    label: "This page",
    value: "Reference",
    note: "Every entry links to its source",
  },
  {
    label: `${standards.length} entries`,
    // three counts side by side: as a note, the last read as a part of the drafts
    value: `${published} published, ${draftCount} drafts, ${standards.length - published - draftCount} projects and guidance`,
  },
  {
    label: "IETF process states",
    value: "Read from the datatracker",
    note: "How to read status",
    noteHref: "#reading-status",
  },
  {
    label: "Review",
    value: `Checked against sources in ${REVIEWED}`,
    note: "How it was checked",
    noteHref: "/about/#how-facts-were-checked",
  },
];

const moved = [
  {
    when: "January",
    what: "The OpenID Foundation approves the **AuthZEN Authorization API 1.0** as a final specification: a standard interface to policy engines.",
  },
  {
    when: "March",
    what: "**A2A 1.0** is released, with signed Agent Cards and a defined task state for in-task authorization.",
  },
  {
    when: "April",
    what: "**AP2 v0.2** redesigns payment mandates and is donated to the **FIDO Alliance**, which forms working groups on agentic authentication and payments.",
  },
  {
    when: "July",
    what: "**MCP 2026-07-28**: the protocol becomes stateless, Dynamic Client Registration is deprecated and issuer validation is required.",
  },
  {
    when: "August",
    what: "Two OAuth best-practice documents are published: **RFC 10017** (browser-based apps) and **RFC 10027** (cross-device flows). **Kubernetes 1.37** ships Pod Certificates and ClusterTrustBundle as GA.",
  },
  {
    when: "September",
    what: "The WIMSE working group adopts **AIMS**, the agent identity architecture. The OAuth working group adopts **Deferred Token Response**. The Web Bot Auth working group adopts its first document.",
  },
  {
    when: "October",
    what: "The IETF charters two agent-related working groups, **agentproto** (agent communication) and **DAWN** (agent discovery). Neither is chartered to define a new authentication or authorization mechanism: agentproto’s charter says it will reuse existing ones, and DAWN’s puts identity management out of scope. **ID-JAG** reaches revision -06. The MCP **OAuth Client Credentials** extension moves to stable, as **Enterprise-Managed Authorization** did in June.",
  },
  {
    when: "November",
    what: "**RFC 10070** updates JWT client authentication. **CIMD** reaches -03. **SPIRE 1.16** adds experimental WIT-SVID support. IETF 127 meets mid-month.",
  },
];
---

<Base
  title="Standards for agent authentication and authorization"
  description="Every RFC, draft, specification and project that matters for agent authentication and authorization, with current status and why it matters."
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Standards</p>
      <h1>Standards and drafts tracker</h1>
      <p class="lede">
        What each specification defines, where it stands, and why it matters for agents.
      </p>
      <DocMeta lead={`${standards.length} entries`} reviewed={REVIEWED} details={details} />
      <p class="also">
        Also on this page: <a href="#moved">what moved in 2026</a> · <a href="#reading-status">how to read status</a>
      </p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <standards-explorer class="sx">
        <form class="sx-filters" aria-label="Filter standards" hidden>
          <label class="sx-search">
            <span class="visually-hidden">Search</span>
            <input type="search" name="q" placeholder="Search name, number or text…" autocomplete="off" />
          </label>

          <details class="sx-facets" open>
            <summary>
              <span>Filters</span>
              <span class="sx-active" aria-live="polite"></span>
            </summary>
          <fieldset>
            <legend>Status</legend>
            {
              statuses.map((s) => (
                <label class="sx-opt">
                  <input type="checkbox" name="status" value={s} />
                  <span>{STATUS_LABEL[s]}</span>
                  <em>{count((x) => x.status === s)}</em>
                </label>
              ))
            }
          </fieldset>

          <fieldset>
            <legend>Topic</legend>
            {
              topics.map((t) => (
                <label class="sx-opt">
                  <input type="checkbox" name="topic" value={t} />
                  <span>{TOPIC_LABEL[t]}</span>
                  <em>{count((x) => x.topics.includes(t))}</em>
                </label>
              ))
            }
          </fieldset>

          <fieldset>
            <legend>Body</legend>
            {
              bodies.map((b) => (
                <label class="sx-opt">
                  <input type="checkbox" name="body" value={b} />
                  <span>{b}</span>
                  <em>{count((x) => x.body === b)}</em>
                </label>
              ))
            }
          </fieldset>

          <button class="btn small ghost" type="reset">Clear filters</button>
          </details>
        </form>

        <div class="sx-results">
          <p class="sx-count" aria-live="polite">{standards.length} entries</p>
          <ul class="sx-list">
            {
              standards.map((s) => {
                const used = usedIn(s.id);
                // A related document with its own entry links to that entry
                // on this page. Any other links to the document itself.
                const related = (s.related ?? []).map((r) => {
                  if ('entry' in r) {
                    const e = std(r.entry);
                    return { kind: RELATED_LABEL[r.kind], name: `${e.name} (${e.ref})`, href: `#${e.id}`, out: false, note: r.note ?? '' };
                  }
                  return { kind: RELATED_LABEL[r.kind], name: r.name, href: r.url, out: true, note: r.note ?? '' };
                });
                return (
                  <li
                    class="sx-item"
                    id={s.id}
                    data-status={s.status}
                    data-topics={s.topics.join(' ')}
                    data-body={s.body}
                    data-text={`${s.name} ${s.ref} ${s.id} ${s.body} ${s.summary} ${s.agents} ${s.detail ?? ''} ${related.map((r) => `${r.kind} ${r.name} ${r.note}`).join(' ')} ${(s.otherNames ?? []).join(' ')}`.toLowerCase()}
                  >
                    <header>
                      <h3>{s.name}</h3>
                      <span class="sx-ref">{s.ref}</span>
                    </header>
                    <div class="chips">
                      <span class="chip" data-tone={STATUS_TONE[s.status]}>
                        {STATUS_LABEL[s.status]}
                      </span>
                      <span class="chip">{' · '}{s.body}</span>
                      {s.topics.map((t) => (
                        <span class="chip topic">{' · '}{TOPIC_LABEL[t]}</span>
                      ))}
                    </div>
                    <p class="sx-summary" set:html={inline(s.summary)} />
                    <p class="sx-agents">
                      <strong>For agents:</strong>{' '}
                      <span set:html={inline(s.agents)} />
                    </p>
                    {s.detail && (
                      <p class="sx-detail">
                        <strong>Status:</strong>{' '}
                        <span set:html={inline(s.detail)} />
                      </p>
                    )}
                    {related.length > 0 && (
                      <div class="sx-related">
                        <strong>Related</strong>
                        <ul>
                          {related.map((r) => (
                            <li>
                              <span class="sx-kind">{r.kind}</span>{' '}
                              {r.out ? (
                                <a href={r.href} rel="noopener">
                                  {r.name} ↗
                                </a>
                              ) : (
                                <a href={r.href}>{r.name}</a>
                              )}
                              {r.note && (
                                <>
                                  {' '}
                                  <span set:html={inline(r.note)} />
                                </>
                              )}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    <p class="sx-source">
                      <a href={s.url} rel="noopener">
                        Source ↗
                      </a>
                      {used.length > 0 && (
                        <span class="sx-used">
                          Used in{' '}
                          {used.map((f, i) => (
                            <>
                              {i > 0 && ', '}
                              <a href={`/flows/${f.slug}/`}>{f.short}</a>
                            </>
                          ))}
                        </span>
                      )}
                    </p>
                  </li>
                );
              })
            }
          </ul>
          <p class="sx-empty" hidden>Nothing matches those filters. <button type="button" class="linklike">Clear them</button>.</p>
        </div>
      </standards-explorer>
    </div>
  </section>

  <section class="section" id="moved">
    <div class="wrap">
      <div class="section-head">
        <h2>What moved in 2026</h2>
        <p>The year so far, as of {REVIEWED}.</p>
      </div>
      <ol class="moved">
        {
          moved.map((m) => (
            <li>
              <span class="when">{m.when}</span>
              <p set:html={inline(m.what)} />
            </li>
          ))
        }
      </ol>
      <div class="callout" id="reading-status">
        <p class="callout-title">Reading status correctly</p>
        <p>
          An IETF <strong>working group draft</strong> has been adopted by a group that intends to publish it, but can
          still change in incompatible ways. An <strong>individual draft</strong> is one or more people’s proposal and
          carries no endorsement. IETF revision numbers, dates and process states, such as “in last call,” were read
          from the IETF datatracker and the RFC Editor, and other revisions from specification repositories. A state
          worded as reported comes from a secondary source. Follow the source link before relying on any draft.
        </p>
      </div>
    </div>
  </section>

</Base>

<script>
  class StandardsExplorer extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('form')!;
      const items = [...this.querySelectorAll<HTMLElement>('.sx-item')];
      const countEl = this.querySelector<HTMLElement>('.sx-count')!;
      const empty = this.querySelector<HTMLElement>('.sx-empty')!;
      form.hidden = false;
      this.dataset.js = '';
      const facets = this.querySelector<HTMLDetailsElement>('.sx-facets')!;
      const active = this.querySelector<HTMLElement>('.sx-active')!;
      const narrow = window.matchMedia('(max-width: 57.99rem)');

      const read = () => {
        const fd = new FormData(form);
        return {
          q: String(fd.get('q') ?? '').trim().toLowerCase(),
          status: fd.getAll('status').map(String),
          topic: fd.getAll('topic').map(String),
          body: fd.getAll('body').map(String),
        };
      };

      // A name is typed many ways: "RFC 9449" and "rfc9449", "OAuth 2.1" and
      // "oauth2.1". A word matches an entry's text as written, or with its
      // spaces and hyphens taken out.
      const squeeze = (s: string) => s.replace(/[\s-]+/g, '');
      const squeezed = new Map(items.map((el) => [el, squeeze(el.dataset.text ?? '')]));

      const apply = (push = true) => {
        const f = read();
        const words = f.q.split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const el of items) {
          const topics = (el.dataset.topics ?? '').split(' ');
          const ok =
            (f.status.length === 0 || f.status.includes(el.dataset.status ?? '')) &&
            (f.body.length === 0 || f.body.includes(el.dataset.body ?? '')) &&
            (f.topic.length === 0 || f.topic.some((t) => topics.includes(t))) &&
            words.every((w) => (el.dataset.text ?? '').includes(w) || squeezed.get(el)!.includes(squeeze(w)));
          el.hidden = !ok;
          if (ok) shown++;
        }
        countEl.textContent =
          shown === items.length ? `${shown} entries` : `${shown} of ${items.length} entries`;
        const n = f.status.length + f.topic.length + f.body.length;
        active.textContent = n ? `${n} on` : '';
        empty.hidden = shown !== 0;
        if (push) {
          const p = new URLSearchParams();
          if (f.q) p.set('q', f.q);
          for (const k of ['status', 'topic', 'body'] as const) for (const v of f[k]) p.append(k, v);
          const qs = p.toString();
          history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
        }
      };

      // restore from the URL
      const params = new URLSearchParams(location.search);
      const q = form.elements.namedItem('q') as HTMLInputElement;
      q.value = params.get('q') ?? '';
      for (const k of ['status', 'topic', 'body']) {
        const wanted = params.getAll(k);
        form.querySelectorAll<HTMLInputElement>(`input[name="${k}"]`).forEach((i) => {
          i.checked = wanted.includes(i.value);
        });
      }
      apply(false);

      // beside the list the facets are always open; on a phone they wait behind "Filters"
      const hasFacet = () => form.querySelectorAll('input[type="checkbox"]:checked').length > 0;
      const place = () => {
        facets.open = !narrow.matches || hasFacet();
      };
      narrow.addEventListener('change', place);
      place();

      form.addEventListener('input', () => {
        apply();
        // A reader far down the list who narrows it would be left below what
        // remains, looking at the foot of the page. Bring the top of the list back.
        if (countEl.getBoundingClientRect().top < 0) countEl.scrollIntoView({ block: 'start' });
      });
      form.addEventListener('submit', (e) => e.preventDefault());
      const clear = () => {
        form.reset();
        // reset() restores defaults; make sure URL-restored checks are cleared too
        form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((i) => (i.checked = false));
        q.value = '';
        apply();
      };
      form.addEventListener('reset', (e) => {
        e.preventDefault();
        clear();
      });
      empty.querySelector('button')?.addEventListener('click', clear);

      // deep link to one entry: make sure it is visible, then mark it
      const focusHash = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        const el = items.find((i) => i.id === id);
        if (!el) return;
        if (el.hidden) clear();
        items.forEach((i) => i.classList.toggle('is-target', i === el));
        el.scrollIntoView({ block: 'start' });
      };
      window.addEventListener('hashchange', focusHash);
      focusHash();
    }
  }
  customElements.define('standards-explorer', StandardsExplorer);
</script>

<style>
  .moved {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    border-top: 1.5px solid var(--fg);
  }
  .moved li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.75rem 0;
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .moved .when {
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* blue is for links: a label that is not a link gives it up */
    color: var(--fg-muted);
    padding-top: 0.25rem;
  }
  .moved p {
    margin: 0;
    max-width: 52rem;
  }
  @media (max-width: 34rem) {
    .moved li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  .sx {
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 58rem) {
    .sx[data-js] {
      grid-template-columns: 15.5rem minmax(0, 1fr);
    }
    .sx-filters {
      position: sticky;
      top: 4.6rem;
      max-height: calc(100dvh - 5.4rem);
      overflow-y: auto;
      scrollbar-width: thin;
      padding-right: 0.4rem;
    }
  }
  .sx-filters[hidden] {
    display: none;
  }
  /* "Filters" is a disclosure only where the facets would otherwise push the list down */
  .sx-facets > summary {
    display: none;
  }
  @media (max-width: 57.99rem) {
    .sx-facets > summary {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.6rem;
      padding: 0.6rem 0.8rem;
      border: 1px solid var(--fg);
      border-radius: var(--radius);
      background: var(--bg-raised);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .sx-facets > summary::-webkit-details-marker {
      display: none;
    }
    .sx-facets > summary::after {
      content: 'Show';
      margin-left: auto;
      font-family: var(--font-label);
      font-size: 0.76rem;
      font-weight: 500;
      color: var(--accent);
      text-decoration: underline;
    }
    .sx-facets[open] > summary::after {
      content: 'Hide';
    }
    .sx-active {
      font-family: var(--font-label);
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--fg-muted);
    }
    .sx {
      gap: 1rem;
    }
  }
  .also {
    margin: 0.7rem 0 0;
    font-size: 0.92rem;
    color: var(--fg-muted);
  }
  .sx-search input {
    width: 100%;
    font: inherit;
    font-size: 0.95rem;
    padding: 0.6rem 0.75rem;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
  }
  .sx-filters fieldset {
    border: 0;
    padding: 0;
    margin: 1.2rem 0 0;
  }
  .sx-filters legend {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding: 0 0 0.35rem;
    width: 100%;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.35rem;
  }
  .sx-opt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .sx-opt input {
    accent-color: var(--accent);
    width: 0.95rem;
    height: 0.95rem;
    margin: 0;
  }
  .sx-opt em {
    margin-left: auto;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.7rem;
    color: var(--fg-subtle);
  }
  .sx-filters .btn {
    margin-top: 1.2rem;
  }
  @media (max-width: 57.99rem) {
    .sx-filters fieldset {
      display: flex;
      flex-wrap: wrap;
      gap: 0.1rem 1.1rem;
    }
    .sx-opt em {
      margin-left: 0;
    }
  }

  .sx-count {
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.7rem;
  }
  .sx-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .sx-item {
    margin: 0;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.05rem 1.25rem 0.95rem;
    scroll-margin-top: 5rem;
  }
  .sx-item[hidden] {
    display: none;
  }
  .sx-item.is-target,
  .sx-item:target {
    border-color: var(--accent);
    box-shadow: 4px 4px 0 var(--accent-soft);
  }
  .sx-item header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
    margin-bottom: 0.55rem;
  }
  .sx-item h3 {
    margin: 0;
    font-size: 1.24rem;
  }
  .sx-item > .chips {
    column-gap: 0.6rem;
  }
  .sx-ref {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-muted);
    word-break: break-word;
  }
  .sx-summary {
    margin: 0.75rem 0 0.55rem;
    max-width: 50rem;
  }
  .sx-agents,
  .sx-detail,
  .sx-related {
    display: grid;
    grid-template-columns: 5.6rem minmax(0, 1fr);
    gap: 0.8rem;
    margin: 0;
    padding: 0.5rem 0;
    border-top: 1px dashed var(--border-strong);
    font-size: 0.94rem;
    max-width: 50rem;
  }
  .sx-agents strong,
  .sx-detail strong,
  .sx-related strong {
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 0.22rem;
  }
  .sx-detail,
  .sx-related {
    color: var(--fg-muted);
  }
  .sx-related ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sx-kind::after {
    content: ':';
  }
  .sx-related li + li {
    margin-top: 0.3rem;
  }
  .sx-source {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.4rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--border-strong);
    font-size: 0.86rem;
  }
  .sx-used {
    color: var(--fg-muted);
  }
  @media (max-width: 34rem) {
    .sx-agents,
    .sx-detail,
    .sx-related {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
  .sx-empty {
    padding: 2rem 0;
    color: var(--fg-muted);
  }
  .linklike {
    font: inherit;
    color: var(--fg);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
  }
</style>
