---
import Base from "../../layouts/Base.astro";
import FieldExamples from "../../components/FieldExamples.astro";
import { fieldDate, fieldProfile } from "../../data/field";
import { byGroup, flows, maturityLabel } from "../../data/flows";
import { fieldSnapshot } from "../../lib/field";

const groups = byGroup().map((group) => ({
  ...group,
  entries: group.flows.map((flow) => {
    const profile = fieldProfile(flow.slug);
    return {
      flow,
      profile,
      snapshot: profile && fieldSnapshot(profile),
      href: profile ? `/implementations/${flow.slug}/` : `/flows/${flow.slug}/`,
    };
  }),
}));
const reviewed = groups
  .flatMap((group) => group.entries)
  .filter(({ profile }) => profile).length;
---

<Base
  title="Implementations"
  reviewMetadata={false}
  description="Find documented implementation options and named production reports for agent authentication and authorization flows."
>
  <div class="page-head">
    <div class="wrap">
      <h1>Implementations</h1>
      <p class="lede">Find products that implement part of a flow and accounts of how named organizations have used it in production.</p>
      <p class="field-coverage">
        <strong>{reviewed} of {flows.length} flows reviewed</strong> · <a href="#methodology">How we review evidence</a>
      </p>
      <p class="field-note">Coverage is selective and varies by flow. Counts describe entries and operators covered in this review; they do not measure adoption. Mention is not recommendation.</p>
    </div>
  </div>

  <div class="wrap">
    <field-directory>
      <form class="field-controls" role="search" aria-label="Implementation directory" hidden>
        <div class="field-inputs">
          <label class="field-search">
            Search by flow, product or role
            <input type="search" placeholder="e.g. Keycloak or client library" autocomplete="off" />
          </label>
          <button class="btn ghost" type="button">Clear search</button>
        </div>
        <p class="field-count" role="status">{flows.length} flows shown</p>
      </form>

      <noscript><p>Product and role search needs JavaScript. Browse by flow below; each record includes all reviewed entries.</p></noscript>
      <p class="field-empty" hidden>No flows match. Try a different term or clear the search.</p>

      {groups.map((group) => (
        <section class="field-group" aria-labelledby={`field-${group.id}`}>
          <h2 id={`field-${group.id}`}>{group.title}</h2>
          <ul class="field-list" role="list">
            {group.entries.map(({ flow, profile, snapshot, href }) => (
              <li
                class="field-record"
                id={flow.slug}
                data-flow-text={`${flow.title} ${flow.short} ${flow.slug} ${flow.tagline} ${group.title}`}
                data-flow-identity={`${flow.title} ${flow.short} ${flow.slug}`}
              >
                <div class="field-identity">
                  <h3>{flow.short}</h3>
                  <dl>
                    <div>
                      <dt class="visually-hidden">Standards maturity</dt>
                      <dd>{maturityLabel(flow)}</dd>
                    </div>
                    <div>
                      <dt class="visually-hidden">Evidence review</dt>
                      <dd>
                        {profile
                          ? <>Reviewed <time datetime={profile.reviewedOn}>{fieldDate(profile.reviewedOn)}</time></>
                          : 'Not reviewed'}
                      </dd>
                    </div>
                  </dl>
                  <div class="field-actions">
                    {profile && (
                      <p><a class="field-evidence-link" href={href}>See the full record<span class="visually-hidden"> for {flow.short}</span></a></p>
                    )}
                    <p><a href={`/flows/${flow.slug}/`}>See the flow<span class="visually-hidden"> for {flow.short}</span></a></p>
                  </div>
                </div>
                {profile && snapshot && (
                  <>
                    <dl class="field-overview">
                      <div>
                        <dt>Implementation evidence</dt>
                        <dd>
                          {snapshot.implementations.length > 0 ? (
                            <>
                              <strong>{snapshot.optionsLabel}</strong>
                              <p class="field-example-label">From the record:</p>
                              <FieldExamples slug={flow.slug} entries={snapshot.implementations} label="Implementations from the record" />
                            </>
                          ) : 'No entry included in this review.'}
                        </dd>
                      </div>
                      <div>
                        <dt>Deployment reports</dt>
                        <dd>
                          {snapshot.deployment ? (
                            <>
                              <strong>{snapshot.operatorsLabel}</strong>
                              <p class="field-example-label">From the record:</p>
                              <FieldExamples slug={flow.slug} entries={[snapshot.deployment]} label="Deployment report from the record" />
                            </>
                          ) : 'No report included in this review.'}
                        </dd>
                      </div>
                    </dl>
                    <template>
                      {profile.implementations.map((entry) => (
                        <a
                          href={`${href}#field-${entry.id}`}
                          data-name={entry.product}
                          data-owner={entry.organization}
                          data-role={entry.role}
                          data-example={snapshot.implementations.some((example) => example.id === entry.id) ? '' : undefined}
                        >{entry.product} · {entry.role}</a>
                      ))}
                      {profile.deployments.map((entry) => (
                        <a
                          href={`${href}#field-${entry.id}`}
                          data-name={entry.organization}
                          data-role={entry.setting}
                          data-example={snapshot.deployment?.id === entry.id ? '' : undefined}
                        >{entry.organization} · {entry.setting}</a>
                      ))}
                    </template>
                    <div class="field-matches" hidden></div>
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </field-directory>

    <section class="field-method prose" aria-labelledby="methodology">
      <h2 id="methodology">How we review evidence</h2>
      <p>
        Each reviewed flow lists the sources consulted, what they establish, and the limits of that evidence.
        Coverage varies by flow.
      </p>
      <dl>
        <div>
          <dt>Standards maturity</dt>
          <dd>Comes from the flow’s specifications. <a href="/about/#how-flows-are-rated">How flows are rated</a>.</dd>
        </div>
        <div>
          <dt>Implementation evidence</dt>
          <dd>Primary sources describe each product’s role and support. Where they give a release stage, the record uses their wording. Interoperability requires its own evidence.</dd>
        </div>
        <div>
          <dt>Deployment reports</dt>
          <dd>Accounts of specific deployments name the operator, who reported the use, and the setting. “No report included” describes this review’s coverage; it does not establish that the flow is unused.</dd>
        </div>
        <div>
          <dt>Observations</dt>
          <dd>Counts of advertised support or other measurements retain their unit, population and date when known. They are kept out of the count of production operators.</dd>
        </div>
        <div>
          <dt>Dates</dt>
          <dd>A report’s publication, a product release, and the date evidence was added or checked each describe different events. A report can describe earlier use.</dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<script>
  const searchText = (text: string) => text.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ');

  class FieldDirectory extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form')!;
      const input = form.querySelector('input')!;
      const clear = form.querySelector('button')!;
      const count = form.querySelector<HTMLElement>('.field-count')!;
      const empty = this.querySelector<HTMLElement>('.field-empty')!;
      const groups = [...this.querySelectorAll<HTMLElement>('.field-group')].map((element) => ({
        element,
        entries: [...element.querySelectorAll<HTMLElement>('.field-record')].map((record) => {
          const flow = record.dataset.flowText ?? '';
          const identity = record.dataset.flowIdentity ?? '';
          const source = record.querySelector('template');
          const matches = record.querySelector<HTMLElement>('.field-matches');
          return {
            record,
            matches,
            flowText: searchText(flow),
            // A product or operator and its role belong to the same entry.
            candidates: Array.from(source?.content.querySelectorAll('a') ?? [], (link) => ({
              text: searchText(`${identity} ${link.dataset.name} ${link.dataset.owner ?? ''} ${link.dataset.role}`),
              link,
            })).sort((a, b) => Number(a.link.hasAttribute('data-example')) - Number(b.link.hasAttribute('data-example'))),
          };
        }),
      }));

      const filter = () => {
        const words = searchText(input.value).split(/\s+/).filter(Boolean);
        const contains = (text: string) => words.every((word) => text.includes(word));
        let shown = 0;
        for (const { element, entries } of groups) {
          let hasMatch = false;
          for (const { record, matches, flowText, candidates } of entries) {
            const matchesFlow = contains(flowText);
            const matchingEntries = words.length > 0
              ? candidates.filter((candidate) => contains(candidate.text))
              : [];
            const show = matchesFlow || matchingEntries.length > 0;
            record.toggleAttribute('data-filtered', !show);
            if (matches) {
              matches.replaceChildren();
              matches.hidden = matchingEntries.length === 0;
              if (matchingEntries.length) {
                const label = document.createElement('strong');
                label.textContent = 'Matching evidence';
                const list = document.createElement('ul');
                for (const { link } of matchingEntries) {
                  const item = document.createElement('li');
                  const anchor = document.createElement('a');
                  anchor.href = link.getAttribute('href')!;
                  anchor.textContent = link.textContent;
                  item.append(anchor);
                  list.append(item);
                }
                matches.append(label, list);
              }
            }
            if (show) {
              shown++;
              hasMatch = true;
            }
          }
          element.toggleAttribute('data-filtered', !hasMatch);
        }
        count.textContent = `${shown} ${shown === 1 ? 'flow' : 'flows'} shown`;
        empty.hidden = shown > 0;
      };

      form.addEventListener('submit', (event) => event.preventDefault());
      input.addEventListener('input', filter);
      clear.addEventListener('click', () => {
        form.reset();
        filter();
        input.focus();
      });
      filter();
      form.hidden = false;
    }
  }

  customElements.define('field-directory', FieldDirectory);
</script>

<style>
  .field-coverage {
    margin: 1rem 0 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .field-coverage strong { color: var(--fg); }
  .field-note {
    margin: 0.25rem 0 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  field-directory { display: block; }
  .field-controls {
    margin-top: 1.4rem;
    padding: 0.95rem 1.05rem 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
  }
  .field-inputs {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 0.9rem;
  }
  .field-inputs label {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .field-search { flex: 1 1 16rem; }
  .field-inputs input {
    width: 100%;
    min-width: 0;
    min-height: 2.5rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    font-family: inherit;
    font-size: 1rem;
  }
  .field-inputs input::placeholder { color: var(--fg-subtle); }
  .field-inputs button { min-height: 2.5rem; }
  .field-count,
  .field-empty {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .field-count { margin: 0.55rem 0 0; }
  .field-empty { margin: 1rem 0 0; }
  .field-group { margin-top: 2rem; }
  .field-group h2,
  .field-method h2 {
    margin: 0 0 0.65rem;
    font-size: 1.48rem;
  }
  .field-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .field-list { border-top: 1px solid var(--fg); }
  .field-record {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 2.65fr);
    gap: 0.75rem 1.4rem;
    margin: 0;
    padding: 0.8rem 1.25rem;
    border: 1px solid transparent;
    border-bottom-color: var(--border);
    overflow-wrap: anywhere;
  }
  .field-record:target {
    border-color: var(--accent);
    box-shadow: 4px 4px 0 var(--accent-soft);
  }
  .field-record h3 { margin: 0 0 0.2rem; font-size: 1.12rem; }
  .field-record dl { margin: 0; }
  .field-record dd {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .field-overview {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 0.6rem 1.25rem;
    min-width: 0;
  }
  .field-overview dt {
    margin: 0 0 0.25rem;
    color: var(--fg-muted);
    font: 500 0.76rem/1.35 var(--font-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .field-overview dd strong { color: var(--fg); }
  .field-example-label {
    margin: 0.5rem 0 0;
    font: 500 0.72rem/1.35 var(--font-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .field-actions {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.7rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .field-actions p { margin: 0; }
  .field-evidence-link { font-weight: 600; }
  .field-matches {
    grid-column: 2 / -1;
    padding: 0.55rem 0 0 0.8rem;
    border-inline-start: 2px solid var(--accent);
    font-size: 0.95rem;
  }
  .field-matches ul { margin: 0.25rem 0 0; }
  .field-matches li { margin: 0.2rem 0; }
  .field-method {
    margin-top: 2.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--fg);
  }
  .field-method dl { margin: 0; }
  .field-method dt { font-weight: 600; }
  .field-method dd { margin: 0 0 0.75rem; }

  @media screen {
    [data-filtered] { display: none; }
  }
  @media (max-width: 52rem) {
    .field-record { grid-template-columns: minmax(0, 1fr); }
    .field-overview { grid-column: 1; grid-row: 2; }
    .field-matches { grid-column: 1 / -1; }
    .field-identity dl {
      display: flex;
      flex-wrap: wrap;
      gap: 0.1rem 1rem;
    }
  }
  @media (max-width: 34rem) {
    .field-overview { grid-template-columns: minmax(0, 1fr); }
  }
  @media print {
    .field-controls, .field-empty, .field-matches { display: none; }
    .field-record { break-inside: avoid; }
  }
</style>
