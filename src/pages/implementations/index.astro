---
import Base from "../../layouts/Base.astro";
import ImplementationEntries from "../../components/ImplementationEntries.astro";
import {
  evidenceDate,
  implementationProfile,
} from "../../data/implementations";
import { byGroup, flows, maturityLabel } from "../../data/flows";

const groups = byGroup().map((group) => ({
  ...group,
  entries: group.flows.map((flow) => {
    const profile = implementationProfile(flow.slug);
    return {
      flow,
      profile,
      href: profile ? `/implementations/${flow.slug}/` : `/flows/${flow.slug}/`,
    };
  }),
}));
const reviewed = groups
  .flatMap((group) => group.entries)
  .filter(({ profile }) => profile).length;
---

<Base
  title="Implementations"
  reviewMetadata={false}
  description="Find documented implementation options and named production reports for agent authentication and authorization flows."
>
  <div class="page-head">
    <div class="wrap">
      <h1>Implementations</h1>
      <p class="lede">Find products that implement part of a flow and accounts of how named organizations have used it in production.</p>
      <p class="evidence-coverage">
        {reviewed} of {flows.length} flows reviewed · <a href="#methodology">How we review evidence</a>
      </p>
      <p class="evidence-note">Coverage is selective and varies by flow. These records do not measure adoption. Mention is not recommendation.</p>
    </div>
  </div>

  <div class="wrap">
    <implementation-directory>
      <form class="evidence-controls" role="search" aria-label="Implementation directory" hidden>
        <label class="evidence-search">
          Search by flow, product or role
          <input type="search" name="q" placeholder="e.g. Keycloak or client library" autocomplete="off" />
        </label>
        <details class="evidence-facets" open>
          <summary>
            <span>Filters</span>
            <span class="evidence-active" aria-live="polite"></span>
          </summary>
          <fieldset>
            <legend>Flow group</legend>
            {groups.map((group) => (
              <label class="evidence-opt">
                <input type="checkbox" name="group" value={group.id} />
                <span>{group.title}</span>
                <em data-count-for={group.id}><span class="evidence-group-total">{group.flows.length}</span><span class="visually-hidden"> matching flows</span></em>
              </label>
            ))}
          </fieldset>
          <button class="btn small ghost" type="reset">Clear filters</button>
        </details>
      </form>

      <div class="evidence-results">
        <noscript><p>Search and filters need JavaScript. All reviewed summaries are listed below by flow.</p></noscript>
        <p class="evidence-count" role="status" hidden>{flows.length} flows shown</p>
        <p class="evidence-empty" hidden>No flows match. Try a different term or clear the filters.</p>

        {groups.map((group) => (
          <section class="evidence-group" data-group={group.id} aria-labelledby={`field-${group.id}`}>
            <h2 id={`field-${group.id}`}>{group.title}</h2>
            <ul class="evidence-list" role="list">
              {group.entries.map(({ flow, profile, href }) => (
                <li
                  class="evidence-record"
                  id={flow.slug}
                  data-flow-text={`${flow.title} ${flow.short} ${flow.slug} ${flow.tagline} ${group.title}`}
                  data-flow-identity={`${flow.title} ${flow.short} ${flow.slug}`}
                >
                  <header class="evidence-identity">
                    <h3>{flow.short}</h3>
                    <p class="evidence-meta">
                      <span class="visually-hidden">Standards maturity: </span>{maturityLabel(flow)}{' · '}
                      {profile
                        ? <>Reviewed <time datetime={profile.reviewedOn}>{evidenceDate(profile.reviewedOn)}</time></>
                        : 'Not reviewed'}
                    </p>
                  </header>
                  {profile && (
                    <>
                      <dl class="evidence-overview">
                        <div>
                          <dt>
                            <span class="evidence-section-title">Implementation evidence</span>
                          </dt>
                          <dd>
                            {profile.implementations.length > 0 ? (
                              <ImplementationEntries slug={flow.slug} entries={profile.implementations} label="Implementations from the record" />
                            ) : <p class="evidence-none">No entry included in this review.</p>}
                          </dd>
                        </div>
                        <div>
                          <dt>
                            <span class="evidence-section-title">Deployment reports</span>
                          </dt>
                          <dd>
                            {profile.deployments.length > 0 ? (
                              <ImplementationEntries slug={flow.slug} entries={profile.deployments} label="Deployment reports from the record" />
                            ) : <p class="evidence-none">No report included in this review.</p>}
                          </dd>
                        </div>
                      </dl>
                      <template>
                        <ImplementationEntries
                          slug={flow.slug}
                          entries={[...profile.implementations, ...profile.deployments]}
                          label="Matching evidence"
                          searchable
                        />
                      </template>
                      <div class="evidence-matches" hidden>
                        <p class="evidence-section-title">Matching evidence</p>
                        <div class="evidence-match-list"></div>
                      </div>
                    </>
                  )}
                  <div class="evidence-actions">
                    <p><a href={`/flows/${flow.slug}/`}>See the flow<span class="visually-hidden"> for {flow.short}</span></a></p>
                    {profile && (
                      <p><a class="evidence-details-link" href={href}>Sources and review details<span class="visually-hidden"> for {flow.short}</span></a></p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </implementation-directory>

    <section class="evidence-method prose" aria-labelledby="methodology">
      <h2 id="methodology">How we review evidence</h2>
      <p>
        Each reviewed flow lists the sources consulted, what they establish, and the limits of that evidence.
        Coverage varies by flow.
      </p>
      <dl>
        <div>
          <dt>Standards maturity</dt>
          <dd>Comes from the flow’s specifications. <a href="/about/#how-flows-are-rated">How flows are rated</a>.</dd>
        </div>
        <div>
          <dt>Implementation evidence</dt>
          <dd>Primary sources describe each product’s role and support. Where they give a release stage, the record uses their wording. Interoperability requires its own evidence.</dd>
        </div>
        <div>
          <dt>Deployment reports</dt>
          <dd>Accounts of specific deployments name the operator, who reported the use, and the setting. “No report included” describes this review’s coverage; it does not establish that the flow is unused.</dd>
        </div>
        <div>
          <dt>Observations</dt>
          <dd>Counts of advertised support or other measurements retain their unit, population and date when known. They are kept out of the count of production operators.</dd>
        </div>
        <div>
          <dt>Dates</dt>
          <dd>A report’s publication, a product release, and the date evidence was added or checked each describe different events. A report can describe earlier use.</dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<script>
  const searchText = (text: string) => text.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ');

  class ImplementationDirectory extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('form')!;
      const input = form.querySelector<HTMLInputElement>('input[type="search"]')!;
      const checks = [...form.querySelectorAll<HTMLInputElement>('input[name="group"]')];
      const facets = form.querySelector<HTMLDetailsElement>('.evidence-facets')!;
      const active = form.querySelector<HTMLElement>('.evidence-active')!;
      const narrow = window.matchMedia('(max-width: 57.99rem)');
      const count = this.querySelector<HTMLElement>('.evidence-count')!;
      const empty = this.querySelector<HTMLElement>('.evidence-empty')!;
      const groups = [...this.querySelectorAll<HTMLElement>('.evidence-group')].map((element) => ({
        element,
        counter: form.querySelector<HTMLElement>(`[data-count-for="${element.dataset.group}"]`)!,
        entries: [...element.querySelectorAll<HTMLElement>('.evidence-record')].map((record) => {
          const flow = record.dataset.flowText ?? '';
          const identity = record.dataset.flowIdentity ?? '';
          const source = record.querySelector('template')?.content.querySelector('ul');
          const matches = record.querySelector<HTMLElement>('.evidence-matches');
          const matchList = matches?.querySelector<HTMLElement>('.evidence-match-list');
          return {
            record,
            matches,
            matchList,
            source,
            flowText: searchText(flow),
            // A product or operator and its role belong to the same entry.
            candidates: Array.from(source?.querySelectorAll<HTMLElement>('li') ?? [], (item) => ({
              text: searchText(`${identity} ${item.dataset.name} ${item.dataset.owner ?? ''} ${item.dataset.role}`),
              item,
            })),
          };
        }),
      }));

      const filter = (updateURL = true) => {
        const selected = checks.filter((check) => check.checked).map((check) => check.value);
        const words = searchText(input.value).split(/\s+/).filter(Boolean);
        const contains = (text: string) => words.every((word) => text.includes(word));
        let shown = 0;
        for (const { element, counter, entries } of groups) {
          const matchesGroup = selected.length === 0 || selected.includes(element.dataset.group ?? '');
          let hasMatch = false;
          let queryMatches = 0;
          for (const { record, matches, matchList, source, flowText, candidates } of entries) {
            const matchesFlow = contains(flowText);
            const matchingEntries = words.length > 0
              ? candidates.filter((candidate) => contains(candidate.text))
              : [];
            const matchesQuery = matchesFlow || matchingEntries.length > 0;
            // Count flows before group selection, including those with several matching entries.
            if (matchesQuery) queryMatches++;
            const show = matchesGroup && matchesQuery;
            record.toggleAttribute('data-filtered', !show);
            record.toggleAttribute('data-matching', matchingEntries.length > 0);
            if (matches && matchList) {
              matchList.replaceChildren();
              matches.hidden = matchingEntries.length === 0;
              if (matchingEntries.length && source) {
                const list = source.cloneNode(false);
                for (const { item } of matchingEntries) list.appendChild(item.cloneNode(true));
                matchList.append(list);
              }
            }
            if (show) {
              shown++;
              hasMatch = true;
            }
          }
          counter.querySelector('.evidence-group-total')!.textContent = String(queryMatches);
          counter.querySelector('.visually-hidden')!.textContent = queryMatches === 1 ? ' matching flow' : ' matching flows';
          element.toggleAttribute('data-filtered', !hasMatch);
        }
        count.textContent = `${shown} ${shown === 1 ? 'flow' : 'flows'} shown`;
        empty.hidden = shown > 0;
        active.textContent = selected.length ? `${selected.length} on` : '';
        if (updateURL) {
          const params = new URLSearchParams();
          if (input.value.trim()) params.set('q', input.value.trim());
          for (const group of selected) params.append('group', group);
          const query = params.toString();
          history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
        }
      };

      const params = new URLSearchParams(location.search);
      input.value = params.get('q') ?? '';
      const selected = params.getAll('group');
      for (const check of checks) check.checked = selected.includes(check.value);
      const place = () => {
        facets.open = !narrow.matches || checks.some((check) => check.checked);
      };
      narrow.addEventListener('change', place);
      place();

      const clear = () => {
        input.value = '';
        for (const check of checks) check.checked = false;
        filter();
      };
      form.addEventListener('submit', (event) => event.preventDefault());
      form.addEventListener('input', () => {
        filter();
        // Keep results in view when the sticky sidebar narrows a long list.
        if (count.getBoundingClientRect().top < 0) count.scrollIntoView({ block: 'start' });
      });
      form.addEventListener('reset', (event) => {
        event.preventDefault();
        clear();
        input.focus();
      });
      filter(false);
      form.hidden = false;
      count.hidden = false;
      this.dataset.js = '';

      // A link to a flow must stay reachable even when saved filters exclude it.
      const focusHash = () => {
        const id = location.hash.slice(1);
        const target = [...this.querySelectorAll<HTMLElement>('.evidence-record, .evidence-group h2')]
          .find((element) => element.id === id);
        if (!target) return;
        if (target.closest('[data-filtered]')) clear();
        target.scrollIntoView({ block: 'start' });
      };
      window.addEventListener('hashchange', focusHash);
      focusHash();
    }
  }

  customElements.define('implementation-directory', ImplementationDirectory);
</script>

<style>
  .evidence-coverage {
    margin: 1rem 0 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .evidence-note {
    margin: 0.25rem 0 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  implementation-directory {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem 2.5rem;
    margin-top: 1.5rem;
  }
  @media screen and (min-width: 58rem) {
    implementation-directory[data-js] { grid-template-columns: 15.5rem minmax(0, 1fr); }
    .evidence-controls {
      position: sticky;
      top: 4.6rem;
      max-height: calc(100dvh - 5.4rem);
      overflow-y: auto;
      scrollbar-width: thin;
      padding-right: 0.4rem;
    }
  }
  .evidence-controls[hidden] { display: none; }
  .evidence-search {
    display: grid;
    gap: 0.3rem;
    font-size: 0.95rem;
  }
  .evidence-search input {
    width: 100%;
    min-width: 0;
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
  }
  .evidence-search input::placeholder { color: var(--fg-subtle); }
  .evidence-controls fieldset { border: 0; padding: 0; margin: 1.2rem 0 0; }
  .evidence-controls legend {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding: 0 0 0.35rem;
    width: 100%;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.35rem;
  }
  .evidence-opt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .evidence-opt input {
    accent-color: var(--accent);
    flex-shrink: 0;
    width: 0.95rem;
    height: 0.95rem;
    margin: 0;
  }
  .evidence-opt em {
    margin-left: auto;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.7rem;
    color: var(--fg-subtle);
  }
  .evidence-controls .btn { margin-top: 1.2rem; }
  .evidence-facets > summary { display: none; }
  @media (max-width: 57.99rem) {
    implementation-directory { gap: 1rem; }
    .evidence-facets > summary {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.6rem;
      padding: 0.6rem 0.8rem;
      border: 1px solid var(--fg);
      border-radius: var(--radius);
      background: var(--bg-raised);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .evidence-facets > summary::-webkit-details-marker { display: none; }
    .evidence-facets > summary::after {
      content: 'Show';
      margin-left: auto;
      font-family: var(--font-label);
      font-size: 0.76rem;
      font-weight: 500;
      color: var(--accent);
      text-decoration: underline;
    }
    .evidence-facets[open] > summary::after { content: 'Hide'; }
    .evidence-active {
      font-family: var(--font-label);
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--fg-muted);
    }
    .evidence-controls fieldset { display: flex; flex-wrap: wrap; gap: 0.1rem 1.1rem; }
    .evidence-opt em { margin-left: 0; }
  }
  .evidence-count {
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.7rem;
  }
  .evidence-empty { margin: 1rem 0 0; color: var(--fg-muted); }
  .evidence-group { margin-top: 0; }
  .evidence-group + .evidence-group { margin-top: 2rem; }
  .evidence-group h2,
  .evidence-method h2 {
    margin: 0 0 0.65rem;
    font-size: 1.48rem;
  }
  .evidence-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }
  .evidence-record {
    margin: 0;
    padding: 1.05rem 1.25rem 0.95rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-wrap: anywhere;
  }
  .evidence-record:target {
    border-color: var(--accent);
    box-shadow: 4px 4px 0 var(--accent-soft);
  }
  .evidence-identity h3 { margin: 0; font-size: 1.24rem; }
  .evidence-meta {
    margin: 0.4rem 0 0;
    color: var(--fg-muted);
    font-size: 0.86rem;
  }
  .evidence-overview { margin: 0.8rem 0 0; }
  .evidence-overview > div,
  .evidence-matches {
    padding: 0.8rem 0;
    border-top: 1px dashed var(--border-strong);
  }
  .evidence-overview dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
    margin: 0 0 0.55rem;
  }
  .evidence-overview dd { margin: 0; }
  .evidence-section-title {
    margin: 0;
    color: var(--fg-muted);
    font: 500 0.68rem/1.35 var(--font-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .evidence-none {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .evidence-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.4rem;
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--border-strong);
    font-size: 0.86rem;
  }
  .evidence-actions p { margin: 0; }
  .evidence-details-link { font-weight: 600; }
  .evidence-matches { margin-top: 0.8rem; }
  .evidence-matches > p { margin-bottom: 0.55rem; }
  .evidence-method {
    margin-top: 2.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--fg);
  }
  .evidence-method dl { margin: 0; }
  .evidence-method dt { font-weight: 600; }
  .evidence-method dd { margin: 0 0 0.75rem; }

  @media screen {
    [data-filtered],
    [data-matching] .evidence-overview { display: none; }
  }
  @media print {
    .evidence-controls, .evidence-count, .evidence-empty, .evidence-matches { display: none; }
    .evidence-record { break-inside: avoid; }
  }
</style>
