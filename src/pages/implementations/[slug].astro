---
import Base from "../../layouts/Base.astro";
import ImplementationRecord from "../../components/ImplementationRecord.astro";
import {
  evidenceDate,
  implementationProfiles,
} from "../../data/implementations";
import type { ImplementationProfile } from "../../data/implementations";
import { flow } from "../../data/flows";

export function getStaticPaths() {
  return implementationProfiles.map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));
}

interface Props {
  profile: ImplementationProfile;
}

const { profile } = Astro.props;
const guide = flow(profile.slug);
const title = `${guide.short} implementations and deployment reports`;
---

<Base
  title={title}
  description={`Reviewed implementation entries, deployment reports and sources for ${guide.short}.`}
  article
  reviewMetadata={false}
  here={{ trail: [{ label: 'Implementations', href: '/implementations/' }], current: guide.short }}
>
  <article>
    <div class="page-head">
      <div class="wrap">
        <h1>{title}</h1>
        <p class="evidence-date">Evidence reviewed <time datetime={profile.reviewedOn}>{evidenceDate(profile.reviewedOn)}</time></p>
        <p class="evidence-links">
          <a href={`/flows/${guide.slug}/`}>How {guide.short} works</a> · <a href="/implementations/">Browse implementations across all flows</a>
        </p>
      </div>
    </div>
    <div class="wrap evidence-body">
      <ImplementationRecord profile={profile} />
    </div>
  </article>
</Base>

<style>
  .evidence-date {
    margin: 0.9rem 0 0.5rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .evidence-links { margin: 0; }
  .evidence-body { margin-top: clamp(1.6rem, 4vw, 2.5rem); }
</style>
