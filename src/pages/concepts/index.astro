---
import Base from "../../layouts/Base.astro";
import LastHop from "../../components/LastHop.astro";
import VerifyDetail from "../../components/VerifyDetail.astro";
import TokenInspector from "../../components/TokenInspector.astro";
import DocMeta from "../../components/DocMeta.astro";
import { REVIEWED } from "../../data/site";
import type { Role } from "../../data/types";
import { inline } from "../../lib/md";

/** The parties in every flow, under the names the specifications use. */
const roles: {
  role: Role;
  name: string;
  term: string;
  holds: string;
  verifies: string;
  examples: string;
}[] = [
  {
    role: "human",
    name: "User",
    term: "Resource owner",
    holds: "The authority to grant: their own data and permissions.",
    verifies:
      "Proves who they are to the authorization server, never to the agent.",
    examples: "End user, employee, approver",
  },
  {
    role: "agent",
    name: "Agent",
    term: "Client",
    holds:
      "A client identity of its own, and whatever tokens are issued to it.",
    verifies:
      "Which authorization server it is talking to, and that responses come from it.",
    examples: "Agent, MCP client, tool server in the middle",
  },
  {
    role: "authz",
    name: "Authorization server",
    term: "Issuer",
    holds: "Signing keys, and the record of who approved what.",
    verifies:
      "The user, the client, and whether policy allows the request. Then issues a token.",
    examples: "Authorization server, identity provider, SPIRE server",
  },
  {
    role: "resource",
    name: "Resource server",
    term: "The API being called",
    holds: "Nothing of the user’s or the agent’s. It only receives tokens.",
    verifies:
      "Each token’s issuer, audience, scope and expiry, and proof of possession where required.",
    examples: "API, MCP server, remote agent, website",
  },
  {
    role: "infra",
    name: "Infrastructure",
    term: "The platform underneath",
    holds: "Knowledge of which workload is actually running, and where.",
    verifies:
      "A workload’s identity, which it can attest to an authorization server.",
    examples: "Kubernetes, gateway, egress proxy",
  },
];

/** What a request should be able to answer, grouped by the three clauses of the site’s question. */
const asks: { group: string; rows: [string, string][] }[] = [
  {
    group: "Who is acting",
    rows: [
      [
        "What software is acting?",
        "`client_id`, the `act` claim, and the workload identity of the process making the call.",
      ],
      [
        "Which agent, exactly?",
        "Often nothing. Most tokens name the application that hosts an agent, not the agent. Several current drafts are trying to fix that.",
      ],
      [
        "Does it matter who holds the token?",
        "A bearer token can be used by anyone holding a copy. A token with a `cnf` claim additionally requires proof of the key it names.",
      ],
    ],
  },
  {
    group: "For whom",
    rows: [
      [
        "Whose authority is this?",
        "The subject of the token: `sub`. A person, or the agent itself.",
      ],
      [
        "Was it meant for this resource?",
        "The audience, `aud`, and whether the first two answers survive all the way to the last hop.",
      ],
    ],
  },
  {
    group: "Who said they could",
    rows: [
      [
        "On what grounds?",
        "A user’s consent, an administrator’s policy, or a signed mandate. Something outside the agent said yes.",
      ],
      [
        "What is it for?",
        "`scope`, `authorization_details`, and transaction context.",
      ],
      ["When does it stop?", "`exp`, and whether anyone can revoke it sooner."],
      [
        "How fresh is it?",
        "`iat`, `auth_time` and `acr`: when and how strongly the person last proved who they are.",
      ],
    ],
  },
];

const details = [
  {
    label: "This page",
    value: "Explainer",
    note: "Background for the flow guides",
  },
  {
    label: "Review",
    value: `Checked against sources in ${REVIEWED}`,
    note: "How it was checked",
    noteHref: "/about/#how-facts-were-checked",
  },
];

const toc = [
  ["roles", "The roles"],
  ["different", "Why agents are different"],
  ["verify", "What the API can verify"],
  ["delegation", "Delegation or impersonation"],
  ["human", "With and without a human"],
  ["tokens", "What is in a token"],
  ["rules", "Rules of thumb"],
];
---

<Base
  title="Concepts in agent authentication and authorization"
  description="The ideas behind agent authentication and authorization: principals, delegation versus impersonation, audience, proof of possession, and what each claim in a token is for."
  here={{ current: 'Concepts' }}
>
  <div class="page-head">
    <div class="wrap">
      <h1>Who is acting, for whom, and who said they could?</h1>
      <p class="lede">
        An API that receives a request from an AI agent needs three answers: which software is calling, whose
        authority it carries, and what that authority covers. This page explains the parties involved, the ways
        authority is handed on, and the claims in a token that carry the answers.
      </p>
      <p class="primer">
        This is the whole model on one page, with the caveats left in. If the vocabulary is new,{' '}
        <a href="/learn/">six short lessons</a> cover the same ground from the start.
      </p>
      <nav class="toc" aria-label="On this page">
        {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </div>
  </div>

  <div class="numbered">
    <div class="wrap">
      <DocMeta reviewed={REVIEWED} details={details} more="Review details" />
    </div>
  <section class="section" id="roles">
    <div class="wrap">
      <div class="section-head">
        <h2>The roles</h2>
        <p>Five kinds of party. Every diagram on this site uses the same names and the same colors for them.</p>
      </div>
      <div class="table-scroll" tabindex="0" role="region" aria-label="The roles">
        <table class="roles">
          <thead>
            <tr>
              <th scope="col">Role</th>
              <th scope="col">What it holds</th>
              <th scope="col">What it verifies</th>
              <th scope="col">Appears as</th>
            </tr>
          </thead>
          <tbody>
            {
              roles.map((r) => (
                <tr class={`role-${r.role}`}>
                  <th scope="row">
                    <span class="role-cell">
                      <span class="swatch" />
                      <span class="name">{r.name}</span>
                      <span class="term">{r.term}</span>
                    </span>
                  </th>
                  <td>{r.holds}</td>
                  <td>{r.verifies}</td>
                  <td class="ex">{r.examples}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="prose after">
        <p>
          The <strong>principal</strong> is whichever party’s authority a request exercises: usually the user, sometimes
          the agent itself. The <strong>actor</strong> is the software exercising it. Most of what goes wrong with agents
          comes from a resource server at the end of a chain that cannot tell the two apart, or knows neither.
        </p>
      </div>

      <h3 class="asks-title">What a request should be able to answer</h3>
      <p class="muted">Nine questions, and where in a token or a request each answer is carried.</p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="What a request should be able to answer">
        <table class="asks">
          <thead>
            <tr>
              <th scope="col">Question</th>
              <th scope="col">Where the answer lives</th>
            </tr>
          </thead>
          {
            asks.map((g) => (
              <tbody>
                <tr class="group">
                  <th scope="rowgroup" colspan="2">
                    {g.group}
                  </th>
                </tr>
                {g.rows.map(([q, a]) => (
                  <tr>
                    <th scope="row">{q}</th>
                    <td set:html={inline(a)} />
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
      <div class="prose after">
        <p>
          The rest of this site is about the mechanisms that carry those answers from where they are known to where
          they are needed.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="different">
    <div class="wrap">
      <h2>Why agents are different</h2>
      <p class="lede">
        Agents use the same protocols as every other program. What changes is how hard they lean on parts of those
        protocols that used to be edge cases.
      </p>
      <div class="grid two diff">
        <div class="card">
          <h3>Delegation is the normal case</h3>
          <p>
            A web app mostly acts as itself and occasionally for a user. An agent exists to act for someone else. The
            distinction between “the user did this” and “software did this for the user” stops being academic.
          </p>
        </div>
        <div class="card">
          <h3>Connections are made at runtime</h3>
          <p>
            Classic OAuth assumes a developer registered the client with each API ahead of time. An agent may be
            pointed at a server nobody involved has seen before, and must discover how to authenticate on the spot.
          </p>
        </div>
        <div class="card">
          <h3>Calls fan out</h3>
          <p>
            One request becomes an agent calling tools that call services that call other agents. Authority has to
            follow the chain without growing along the way, and without any hop holding more than it needs.
          </p>
        </div>
        <div class="card">
          <h3>The caller can be talked into things</h3>
          <p>
            An agent reads untrusted text and acts on it. A credential in its reach is a credential an injected
            instruction can misuse or leak. Controls that live in the prompt are suggestions; controls at the resource
            are enforcement.
          </p>
        </div>
        <div class="card">
          <h3>Work outlives the session</h3>
          <p>
            A person approves something and closes the laptop. The agent keeps going for hours. Either it holds a
            long-lived grant, or it needs a way to reach the person later.
          </p>
        </div>
        <div class="card">
          <h3>Identity has two layers</h3>
          <p>
            There is the workload, a process running somewhere, and there is the principal it is working for. They are
            proven by different credentials, and a sound design carries both.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="verify">
    <div class="wrap">
      <div class="section-head">
        <h2>What the API can verify</h2>
        <p>One user, one agent, one API. The credential the agent presents decides what the API can establish.</p>
      </div>
      <VerifyDetail />
    </div>
  </section>

  <section class="section" id="delegation">
    <div class="wrap">
      <div class="section-head">
        <h2>Delegation or impersonation</h2>
        <p>
          Add a tool server between the agent and the API. The API is now the last hop of a chain: what does it know?
          Pick how authority is passed down and see.
        </p>
      </div>
      <LastHop />
      <div class="prose after">
        <p>
          <strong>Impersonation</strong> means the downstream service cannot distinguish the software from the person.
          It is simple and common, and for an agent it is the one to move away from. <strong>Delegation</strong> keeps both identities:
          the token says who it is for and, separately, who is acting. The standard mechanism is the{' '}
          <code>act</code> claim from <a href="/flows/token-exchange/">token exchange</a>.
        </p>
        <p>
          The confused deputy problem is what happens without it. A service with broad authority is tricked by a
          caller into using that authority on the caller’s behalf. An agent that forwards tokens, or that serves many
          users with one identity, is a deputy waiting to be confused. Audience-restricted tokens and explicit
          delegation are the defenses.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="human">
    <div class="wrap">
      <h2>With and without a human</h2>
      <p class="lede">
        Once it is settled whose authority the agent is using, the next question is whether that person is available
        when access is needed.
      </p>
      <div class="grid modes">
        <a class="card" href="/flows/#g-human-present">
          <span class="chip" data-tone="red">Human present</span>
          <h3>Someone is at the keyboard</h3>
          <p>
            They can be redirected to sign in and shown a consent screen. The agent ends up with a token that carries
            their authority, scoped to what they approved. The risk is consent fatigue and over-broad grants.
          </p>
        </a>
        <a class="card" href="/flows/#g-human-in-the-loop">
          <span class="chip" data-tone="amber">Human reachable</span>
          <h3>Someone can be asked</h3>
          <p>
            The agent works alone but stops for approval at specific points. The approval must reach the person on a
            channel the agent cannot forge, describe one concrete action, and be enforced by something other than the
            agent.
          </p>
        </a>
        <a class="card" href="/flows/#g-autonomous">
          <span class="chip" data-tone="blue">No human</span>
          <h3>Nobody is there</h3>
          <p>
            The agent is the principal. Its identity should come from the platform it runs on, not from a stored
            secret, and its permissions are whatever an administrator granted in advance. Policy is the only control.
          </p>
        </a>
      </div>
      <div class="callout" data-tone="red">
        <p class="callout-title">The trap in the middle</p>
        <p>
          The dangerous configuration is the one that is neither: an unattended agent holding a person’s long-lived
          token. It has a human’s full authority and no human watching. If you find yourself here, narrow the scope,
          bind the token to a key, make the person reachable for anything irreversible, and know how you would revoke
          it.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="tokens">
    <div class="wrap">
      <div class="section-head">
        <h2>What is in a token</h2>
        <p>Nine credentials you will meet. Each claim is followed by the question it answers and what it means.</p>
      </div>
      <TokenInspector />
    </div>
  </section>

  <section class="section" id="rules">
    <div class="wrap">
      <h2>Rules of thumb</h2>
      <ol class="rules">
        <li>
          <strong>One audience per token.</strong>{' '}
          A token should work at exactly one resource. Request it that way with the <code>resource</code> parameter and
          reject anything addressed to someone else.
        </li>
        <li>
          <strong>Exchange, never forward.</strong>{' '}
          A service that needs to call another gets a new token for that hop. Passing along the one it received is how
          a token meant for one place ends up everywhere.
        </li>
        <li>
          <strong>Keep credentials out of the model’s context.</strong>{' '}
          Anything the model can read, an injected instruction can ask it to repeat. Tokens belong in the runtime
          around the model, or outside the sandbox entirely.
        </li>
        <li>
          <strong>Enforce at the resource.</strong>{' '}
          The agent asking for confirmation is a courtesy. The API refusing without a valid, specific authorization is
          a control.
        </li>
        <li>
          <strong>Prove the workload and the principal separately.</strong>{' '}
          Which process is calling, and whose authority it carries, are different questions with different
          credentials.
        </li>
        <li>
          <strong>Prefer identity you do not have to store.</strong>{' '}
          A platform-issued token that rotates itself beats a secret in an environment variable every time.
        </li>
        <li>
          <strong>Short lives, narrow scopes, and a way to say stop.</strong>{' '}
          Assume a token will leak and an agent will misbehave. Decide in advance how small the damage is and how fast
          you can end it.
        </li>
      </ol>
      <p class="next">
        <a class="btn primary" href="/flows/">See the flows →</a>
        <a class="btn" href="/guide/">Or answer six questions</a>
      </p>
    </div>
  </section>
  </div>
</Base>

<style>
  .primer {
    margin: 1rem 0 0;
    max-width: 42rem;
    color: var(--fg-muted);
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 1.4rem;
    font-family: var(--font-label);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .toc a {
    color: var(--fg-muted);
    text-decoration-color: var(--border-strong);
  }
  .toc a:hover {
    color: var(--accent);
  }
  .section h2 {
    margin-top: 0;
  }
  .section > .wrap > .lede {
    margin-bottom: 1.6rem;
  }
  .after {
    margin-top: 1.8rem;
  }
  .after p:last-child {
    margin-bottom: 0;
  }

  .roles,
  .asks {
    min-width: 40rem;
  }
  .roles tbody th,
  .asks tbody th {
    font-family: var(--font-body);
    font-size: inherit;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    white-space: normal;
    border-bottom: 1px solid var(--border);
  }
  .role-cell {
    display: grid;
    grid-template-columns: 0.9rem minmax(0, 1fr);
    column-gap: 0.6rem;
    align-items: center;
    min-width: 10.5rem;
  }
  .roles .swatch {
    width: 0.9rem;
    height: 0.9rem;
    background: var(--role-soft);
    border: 1.5px solid var(--role);
    border-radius: 2px;
  }
  .roles .name {
    color: var(--role);
  }
  .roles .term {
    grid-column: 2;
    font-size: 0.84rem;
    font-weight: 400;
    color: var(--fg-muted);
  }
  .roles .ex {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .asks-title {
    margin-top: 2.4rem;
    margin-bottom: 0.2rem;
  }
  .asks-title + p {
    margin-bottom: 0.8rem;
  }
  .asks tbody th {
    width: 38%;
  }
  .asks .group th {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    background: var(--bg-sunken);
    padding-block: 0.4rem;
  }

  .modes .card h3 {
    margin-top: 0.8rem;
  }
  .modes {
    margin-bottom: 1.2rem;
  }

  .rules {
    list-style: none;
    counter-reset: rule;
    padding: 0;
    margin: 1.2rem 0 2rem;
    border-top: 1.5px solid var(--fg);
    max-width: 54rem;
  }
  .rules li {
    counter-increment: rule;
    position: relative;
    padding: 0.9rem 0 0.9rem 3rem;
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .rules li::before {
    content: counter(rule);
    position: absolute;
    left: 0;
    top: 0.85rem;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius-round);
  }
  .rules strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.18rem;
    font-weight: 560;
    margin-bottom: 0.15rem;
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
