---
import Base from "../layouts/Base.astro";
import DocMeta from "../components/DocMeta.astro";
import { byGroup, flows } from "../data/flows";
import { standards } from "../data/standards";
import { REVIEWED } from "../data/site";

const groups = byGroup();
const drafts = standards.filter(
  (s) => s.status === "wg-draft" || s.status === "draft",
).length;

// One situation, shown before anything asks the reader to classify theirs.
const path = [
  {
    role: "human",
    name: "Dana",
    sub: "support rep",
    does: "asks for a customer’s record",
  },
  {
    role: "agent",
    name: "Support agent",
    sub: "software",
    does: "requests it",
  },
  {
    role: "resource",
    name: "Records service",
    sub: "holds customer records",
    does: "checks whether Dana may see it",
  },
] as const;

// Entry labels are situations. Each opens the part of an example that answers it.
const situations = [
  {
    href: "/examples/invoice-agent/",
    title: "An agent reconciles invoices overnight",
    text: "Nobody is signed in when it runs. Whose access is it using?",
  },
  {
    href: "/examples/invoice-agent/#key-only-supplier",
    title: "A service will only give you an API key",
    text: "How an agent can use a key it never holds.",
  },
  {
    href: "/examples/invoice-agent/#payment-approval",
    title: "A payment needs someone’s approval first",
    text: "What an approval has to be tied to before it means anything.",
  },
];

// For readers who know what they are looking for.
const sections = [
  {
    href: "/guide/",
    title: "Choose a flow",
    text: "Answer what you know about your agent and get the flows that fit, with the reason for each.",
  },
  {
    href: "/flows/",
    title: `${flows.length} flows`,
    text: "Every flow as a sequence diagram you can step through, with the HTTP on the wire and who holds what at each step.",
  },
  {
    href: "/concepts/",
    title: "Concepts",
    text: "Principals, delegation versus impersonation, audience, proof of possession, and an annotated tour of nine tokens.",
  },
  {
    href: "/deployments/",
    title: "Deployments",
    text: "Kubernetes, managed agent platforms, desktops and CLIs, CI pipelines and sandboxes: where identity comes from in each.",
  },
  {
    href: "/standards/",
    title: "Standards tracker",
    text: `${standards.length} RFCs, drafts and specifications with current status. ${drafts} of them are still drafts.`,
  },
  {
    href: "/glossary/",
    title: "Glossary",
    text: "The terms this guide uses, each in a sentence or two.",
  },
];

const news = [
  [
    "MCP 2026-07-28",
    "The protocol went stateless, deprecated Dynamic Client Registration, and made issuer validation mandatory for clients.",
    "/flows/mcp-authorization/",
  ],
  [
    "Agents are workloads",
    "The IETF WIMSE working group adopted an architecture for agent identity that composes existing standards and defines no new protocol.",
    "/standards/#wimse-aims",
  ],
  [
    "Pod Certificates are GA",
    "Kubernetes 1.37 gives every pod a native, auto-rotated X.509 identity. You bring the signer.",
    "/deployments/kubernetes/",
  ],
  [
    "Approval can wait",
    "The OAuth working group adopted Deferred Token Response: any grant may answer “not yet” while a human decides.",
    "/standards/#deferred-token-response",
  ],
];
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Authentication and authorization for AI agents</p>
      <h1>Who’s acting, and what are they allowed to do?</h1>
      <p class="lede">
        Understand how AI agents get access, whose permissions they use, and what you need to build and check.
      </p>

      <section class="opener" aria-labelledby="situation">
        <p class="opener-label">Start with a situation</p>
        <h2 id="situation">An agent should help Dana without seeing more than Dana can</h2>
        <p class="opener-text">
          Dana works in support. She can see the customers in her region, and no others. When she asks an agent to find
          a customer’s record, how do those limits follow the request?
        </p>
        <ol class="path" aria-label="The request, in three steps">
          {
            path.map((p) => (
              <li class={`role-${p.role}`}>
                <span class="path-box">
                  <b>{p.name}</b>
                  <i>{p.sub}</i>
                </span>
                <span class="path-does">{p.does}</span>
              </li>
            ))
          }
        </ol>
        <p class="idea">
          <strong>The records service has to enforce Dana’s limit, even when the agent asks for more.</strong> To do that,
          it needs a trustworthy way to know who the agent is acting for.
        </p>
        <p class="cta">
          <a class="btn primary" href="/examples/support-agent/">Walk through this example</a>
          <span>Follow the request, understand the design, and find implementation options.</span>
        </p>
      </section>

      <div class="hero-meta">
        <DocMeta lead="An independent guide, not a specification" reviewed={REVIEWED} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="minor">More situations</h2>
      <ul class="situations">
        {
          situations.map((s) => (
            <li>
              <a href={s.href}>{s.title}</a>
              <span>{s.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="quiet">
        <a href="/examples/">All examples</a>. Each ends with who is responsible for what, which is the part to read if
        you are reviewing a design someone else built.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="minor">Know what you are looking for?</h2>
      <div class="grid two what">
        {
          sections.map((s) => (
            <a class="card" href={s.href}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Moving this year</h2>
        <p>As of {REVIEWED}. <a href="/standards/">Full tracker →</a></p>
      </div>
      <ul class="news">
        {
          news.map(([title, text, href]) => (
            <li>
              <a href={href}>
                <strong>{title}</strong>
                <span>{text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Every flow</h2>
      <div class="index">
        {
          groups.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <ul>
                {g.flows.map((f) => (
                  <li>
                    <a href={`/flows/${f.slug}/`}>{f.short}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--fg);
    background: var(--bg);
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.6rem, 4vw, 2.6rem);
  }
  .hero h1 {
    font-size: calc(clamp(2.2rem, 4.6vw, 3.5rem) * var(--display-scale));
    max-width: 24ch;
  }
  .hero .lede {
    max-width: 36rem;
  }
  .hero-meta {
    margin-top: 2rem;
  }
  .hero-meta :global(.doc-meta) {
    margin-top: 0;
  }
  .section h2 {
    margin-top: 0;
  }

  /* one situation, one idea, one next step */
  .opener {
    margin-top: 1.6rem;
    border-top: 3px solid var(--fg);
    padding-top: 0.9rem;
  }
  .opener-label {
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0;
  }
  .opener h2 {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    line-height: 1.25;
    letter-spacing: 0;
    margin: 0.25rem 0 0.6rem;
  }
  .opener-text {
    max-width: var(--prose);
    margin: 0;
  }
  .path {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem 2.4rem;
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    max-width: 46rem;
  }
  .path li {
    position: relative;
    margin: 0;
    min-width: 0;
  }
  .path-box {
    display: block;
    border: 1.3px solid var(--role);
    background: var(--role-soft);
    padding: 0.5rem 0.7rem;
  }
  .path-box b {
    display: block;
    font-size: 1rem;
  }
  .path-box i {
    font-style: normal;
    font-size: 0.86rem;
    color: var(--fg-muted);
  }
  .path-does {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }
  .path li + li::before {
    content: '→';
    position: absolute;
    left: -1.58rem;
    top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    color: var(--fg-muted);
  }
  .idea {
    font-size: 1.14rem;
    line-height: 1.5;
    max-width: 37rem;
    margin: 1.3rem 0 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: center;
    margin: 1.1rem 0 0;
  }
  .cta .btn {
    font-size: 0.95rem;
  }
  .cta span {
    font-size: 0.94rem;
    color: var(--fg-muted);
  }
  /* on a phone the picture stays on one row, and one supporting label goes */
  @media (max-width: 40rem) {
    .opener-label {
      display: none;
    }
    .opener {
      margin-top: 1.2rem;
      padding-top: 0.75rem;
    }
    .opener h2 {
      font-size: 1.25rem;
      margin-top: 0;
    }
    .path {
      gap: 0.4rem 1.2rem;
    }
    .path-box {
      display: flex;
      align-items: center;
      min-height: 3rem;
      padding: 0.35rem 0.45rem;
    }
    .path-box b {
      font-size: 0.92rem;
      line-height: 1.25;
    }
    .path-box i {
      display: none;
    }
    .path-does {
      font-size: 0.9rem;
      line-height: 1.35;
    }
    .path li + li::before {
      left: -0.9rem;
      top: 0.72rem;
      font-size: 0.95rem;
    }
    .idea {
      font-size: 1.06rem;
    }
  }
  @media (max-width: 22rem) {
    .path {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.45rem;
    }
    .path li {
      display: grid;
      grid-template-columns: 6.8rem minmax(0, 1fr);
      gap: 0.6rem;
      align-items: center;
    }
    .path-box {
      min-height: 0;
    }
    .path-does {
      margin-top: 0;
    }
    .path li + li::before {
      content: none;
    }
  }

  /* what comes after: quieter, in the order a reader needs it */
  .minor {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    letter-spacing: 0;
  }
  .situations {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    border-top: 1px solid var(--fg);
    max-width: 44rem;
  }
  .situations li {
    margin: 0;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: 0.1rem;
  }
  .situations a {
    font-weight: 600;
    justify-self: start;
  }
  .situations span {
    font-size: 0.94rem;
    color: var(--fg-muted);
  }
  .quiet {
    margin: 0.9rem 0 0;
    font-size: 0.95rem;
    color: var(--fg-muted);
    max-width: 38rem;
  }
  .what {
    margin-top: 1rem;
  }
  .what h3 {
    font-size: 1.25rem;
  }
  .news {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1.5px solid var(--fg);
  }
  .news li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .news a {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.2rem 2rem;
    padding: 0.85rem 0;
    color: var(--accent);
    text-decoration: none;
  }
  .news a:hover strong {
    color: var(--accent);
  }
  .news strong {
    font-family: var(--font-heading);
    font-size: 1.16rem;
    font-weight: 560;
  }
  .news span {
    color: var(--fg-muted);
  }
  @media (max-width: 40rem) {
    .news a {
      grid-template-columns: 1fr;
    }
  }

  .index {
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin-top: 1.2rem;
  }
  .index h3 {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1.5px solid var(--fg);
  }
  .index ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.96rem;
  }
  .index li {
    margin: 0.3rem 0;
  }
  .index a {
    text-decoration-color: var(--border-strong);
  }
  .index a:hover {
    text-decoration-color: var(--accent);
  }
</style>
