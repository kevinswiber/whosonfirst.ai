---
import Base from "../layouts/Base.astro";
import Scenario from "../components/Scenario.astro";
import DocMeta from "../components/DocMeta.astro";
import { byGroup, flow, flows } from "../data/flows";
import { apiSees } from "../data/learn/api-sees";
import { lessons, totalMinutes } from "../data/learn/lessons";
import { standards } from "../data/standards";
import { REVIEWED } from "../data/site";
import { questions } from "../data/guide";
import { must } from "../lib/must";

const groups = byGroup();
const drafts = standards.filter(
  (s) => s.status === "wg-draft" || s.status === "draft",
).length;
const short = (slug: string) => flow(slug).short;

// The decision guide's first two questions, in its own words.
const question = (id: string) =>
  must(
    questions.find((q) => q.id === id),
    `guide question "${id}"`,
  );
const principal = question("principal");
const human = question("human");
const label = (q: typeof principal, value: string) =>
  must(
    q.options.find((o) => o.value === value),
    `answer "${value}" to guide question "${q.id}"`,
  ).label;

// Two answers, shown together. Each then has its own next question, and that
// question is not the same thing: software can run unattended on authority a
// person delegated earlier.
const authority = [
  {
    id: "person",
    choice: "Acting for a person",
    token: "The token names that person. Their permissions set the limit.",
    next: human.title,
    branches: [
      {
        when: label(human, "present"),
        links: [
          ["mcp-authorization", "calling an MCP server"],
          [
            "authorization-code-pkce",
            "calling an HTTP API, with a browser at hand",
          ],
          ["device-authorization", "no browser where the agent runs"],
          ["cross-app-access", "the company identity provider decides"],
          [
            "step-up-authorization",
            "a fresh approval for one sensitive action",
          ],
          ["url-elicitation", "an MCP server needs a grant from a third party"],
        ],
      },
      {
        when: label(human, "reachable"),
        links: [["ciba", "ask them on a device they already use"]],
      },
      {
        when: label(human, "absent"),
        note: "The agent runs unattended on authority the person delegated earlier. Scope it narrowly, and know how it is revoked.",
        links: [
          [
            "authorization-code-pkce",
            "consent once, then run on a refresh token",
          ],
        ],
      },
    ],
  },
  {
    id: "agent",
    choice: "Acting under its own service identity",
    token:
      "The token names the agent. Policy an administrator sets is the only control.",
    next: "Where does its identity come from?",
    branches: [
      {
        when: "The platform it runs on",
        links: [
          [
            "workload-identity-federation",
            "Kubernetes or a cloud workload calling an outside API",
          ],
          [
            "spiffe-workload-identity",
            "service to service inside your own platform",
          ],
        ],
      },
      {
        when: "A registered client credential",
        links: [
          ["client-credentials", "a client with a key or secret of its own"],
        ],
      },
    ],
  },
] as const;

const sections = [
  {
    href: "/flows/",
    title: `${flows.length} flows`,
    text: "Every flow as a sequence diagram you can step through, with the HTTP on the wire and who holds what at each step.",
  },
  {
    href: "/implementations/",
    title: "Implementations",
    text: "Find products and libraries by their documented roles, with release conditions, sources and attributed deployment reports.",
  },
  {
    href: "/deployments/",
    title: "Deployments",
    text: "Hosted apps, Kubernetes, managed agent platforms, desktops and CLIs, CI pipelines and sandboxes: where identity comes from in each, and what a gateway in front changes.",
  },
  {
    href: "/standards/",
    title: "Standards tracker",
    text: `${standards.length} RFCs, drafts and specifications with current status. ${drafts} of them are still drafts.`,
  },
  {
    href: "/concepts/",
    title: "Concepts on one page",
    text: "The lessons, compressed, with every caveat left in: the roles, what an API can verify, delegation and an annotated tour of nine tokens.",
  },
];

// For the reader who arrives with a job and not a question: the page that answers it.
const building = [
  {
    what: "An assistant that works in each user’s own accounts",
    href: "/deployments/web-apps/",
    where: "Hosted apps and backends",
  },
  {
    what: "A job that runs on a schedule, with nobody signed in",
    href: "/learn/whose-authority/",
    where: "Lesson 4: the agent’s own identity",
  },
  {
    what: "A remote MCP server",
    href: "/flows/mcp-authorization/#server",
    where: "MCP authorization: if you are writing the server",
  },
  {
    what: "An agent on Kubernetes",
    href: "/deployments/kubernetes/#the-short-answer",
    where: "Agents on Kubernetes: the short answer",
  },
  {
    what: "A tool that has to call another API for the user",
    href: "/learn/chains/",
    where: "Lesson 5: chains of calls",
  },
  {
    what: "An agent that runs code it was given",
    href: "/deployments/sandboxes/",
    where: "Sandboxes",
  },
];

const news = [
  [
    "MCP 2026-07-28",
    "The protocol went stateless, deprecated Dynamic Client Registration, and made issuer validation mandatory for clients.",
    "/flows/mcp-authorization/",
  ],
  [
    "Agents are workloads",
    "The IETF WIMSE working group adopted an architecture for agent identity that composes existing standards and defines no new protocol.",
    "/standards/#wimse-aims",
  ],
  [
    "Pod Certificates are GA",
    "Kubernetes 1.37 gives every pod a native, auto-rotated X.509 identity. You bring the signer.",
    "/deployments/kubernetes/",
  ],
  [
    "Approval can wait",
    "The OAuth working group adopted Deferred Token Response: any grant may answer “not yet” while a human decides.",
    "/standards/#deferred-token-response",
  ],
];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Authentication and authorization for AI agents</p>
        <h1>Who is acting, for whom, and who said they could?</h1>
        <p class="lede">
          Every API your agent calls needs those three answers, whether it is a calendar, a repository or a
          customer’s account. An API key gives it one. This guide starts from that key and goes as deep as the
          specifications.
        </p>
        <nav class="routes" aria-label="Start here">
          <ul>
            <li>
              <span class="who">New to this?</span>
              <a href="/learn/">Start with the lessons</a>
              <span>
                {lessons.length} short lessons, about {totalMinutes} minutes. No OAuth knowledge needed.
              </span>
            </li>
            <li>
              <span class="who">Designing an agent?</span>
              <a href="/guide/">Choose an authorization flow</a>
              <span>Six questions, starting with whose authority the agent uses.</span>
            </li>
            <li>
              <span class="who">Know what you are looking for?</span>
              <a href="/flows/">Browse flows and standards</a>
              <span>
                {flows.length} flows, step by step, and a <a href="/standards/">tracker of {standards.length} specifications</a>.
              </span>
            </li>
          </ul>
        </nav>
      </div>

      <Scenario
        scenario={apiSees}
        title="What can the API tell?"
        brief
        more={{ href: `/learn/${lessons[0].slug}/`, text: 'A token Alice approved answers all three. Lesson 1 shows why' }}
      />

      <div class="hero-meta">
        <DocMeta lead="An independent guide, not a specification" reviewed={REVIEWED} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Learn it in order</h2>
        <p>
          Each lesson answers one question and builds on the one before. <a href="/learn/">How the lessons work →</a>
        </p>
      </div>
      <ol class="path">
        {
          lessons.map((l, i) => (
            <li>
              <a href={`/learn/${l.slug}/`}>
                <span class="path-n">{i + 1}</span>
                <span class="path-body">
                  <strong>{l.title}</strong>
                  <span>{l.minutes} min</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Or start from what you are building</h2>
        <p>Each goes to the page that says what to build, and what to leave to a library or a product.</p>
      </div>
      <ul class="building">
        {
          building.map((b) => (
            <li>
              <a href={b.href}>
                <span class="what">{b.what}</span>
                <span class="where">{b.where}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap au">
      <div class="section-head">
        <h2>{principal.title}</h2>
        <p>If you know the ground, start here. It is the first question to settle, and it decides whose name is on the token.</p>
      </div>
      <fieldset class="au-choices">
        <legend class="visually-hidden">{principal.title}</legend>
        {
          authority.map((a, i) => (
            <label>
              <input type="radio" name="authority" value={a.id} checked={i === 0} />
              <span class="au-choice">
                <strong>{a.choice}</strong>
                <span>{a.token}</span>
              </span>
            </label>
          ))
        }
      </fieldset>
      {
        authority.map((a) => (
          <div class="au-branch" data-authority={a.id}>
            <h3>
              <span class="au-next">Then</span>
              {a.next}
            </h3>
            <div class="au-paths">
              {a.branches.map((b) => (
                <div>
                  <h4>{b.when}</h4>
                  {'note' in b && <p class="note">{b.note}</p>}
                  <ul>
                    {b.links.map(([slug, hint]) => (
                      <li>
                        <a href={`/flows/${slug}/`}>{short(slug)}</a>
                        <span class="hint">{hint}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
      <p class="more">
        The decision guide asks four more questions: what the agent calls, who runs that, where the agent runs and
        what is at stake. Chains of agents and tools have <a href="/flows/#g-delegation">flows of their own</a>.
      </p>
      <p class="cta">
        <a class="btn primary" href="/guide/">Answer all six questions</a>
        <a class="btn" href="/flows/">See all {flows.length} flows</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What is here</h2>
      <div class="grid two what">
        {
          sections.map((s) => (
            <a class="card" href={s.href}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Moving this year</h2>
        <p>
          For readers who follow the specifications. As of {REVIEWED}. <a href="/standards/">Full tracker →</a>
        </p>
      </div>
      <ul class="news">
        {
          news.map(([title, text, href]) => (
            <li>
              <a href={href}>
                <strong>{title}</strong>
                <span>{text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Every flow</h2>
      <div class="index">
        {
          groups.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <ul>
                {g.flows.map((f) => (
                  <li>
                    <a href={`/flows/${f.slug}/`}>{f.short}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--fg);
    background: var(--bg);
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }
  .hero-grid {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    }
  }
  .hero h1 {
    font-size: calc(clamp(2.2rem, 4.6vw, 3.5rem) * var(--display-scale));
    max-width: 17ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0;
  }

  .hero-meta {
    grid-column: 1 / -1;
  }
  .hero-meta :global(.page-facts) {
    margin-top: 0;
  }

  /* three ways in, set as a short list of links */
  .routes ul {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
    border-top: 1px solid var(--fg);
    max-width: 36rem;
  }
  .routes li {
    margin: 0;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: 0.1rem;
  }
  .routes li > a {
    font-size: 1.08rem;
    font-weight: 600;
    justify-self: start;
  }
  /* which reader each way in is for, said before the link */
  .routes .who {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .routes li > a::after {
    content: ' →';
  }
  .routes span {
    font-size: 0.93rem;
    color: var(--fg-muted);
  }

  .section h2 {
    margin-top: 0;
  }

  /* the lessons, in order: with room, two columns that read down and then across */
  .path {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 2.5rem;
    border-top: 1.5px solid var(--fg);
  }
  @media (min-width: 56rem) {
    .path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
    }
  }
  .path li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .path a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.8rem 0.4rem 0.8rem 0;
    text-decoration: none;
  }
  .path a:hover {
    background: var(--accent-soft);
  }
  .path-n {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius-round);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg);
  }
  .path-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 1rem;
  }
  .path-body strong {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .path-body span {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  /* what the reader is building, then the page that answers it */
  .building {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 0 2.5rem;
    border-top: 1.5px solid var(--fg);
  }
  .building li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .building a {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    align-content: start;
    padding: 0.75rem 0.3rem 0.8rem 0;
    text-decoration: none;
  }
  .building a:hover {
    background: var(--accent-soft);
  }
  .building .what {
    font-size: 1.04rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg);
  }
  .building .where {
    font-size: 0.93rem;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .building .where::after {
    content: ' →';
  }

  /* both answers are on screen before either one's list of flows */
  .au-choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0.6rem;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .au-choices label {
    display: block;
    cursor: pointer;
  }
  .au-choices input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .au-choice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.7rem;
    height: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  .au-choice::before {
    content: '';
    grid-row: 1 / span 2;
    width: 1rem;
    height: 1rem;
    margin-top: 0.25rem;
    border: 1.5px solid var(--fg);
    border-radius: 50%;
    background: var(--bg-raised);
  }
  .au-choice strong {
    font-size: 1.12rem;
    line-height: 1.3;
  }
  .au-choice span {
    grid-column: 2;
    font-size: 0.93rem;
    line-height: 1.4;
    color: var(--fg-muted);
  }
  .au-choices label:hover .au-choice {
    border-color: var(--fg);
  }
  .au-choices input:checked + .au-choice {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    background: var(--accent-soft);
  }
  .au-choices input:checked + .au-choice::before {
    border-color: var(--accent);
    background: radial-gradient(var(--accent) 0 45%, var(--bg-raised) 50%);
  }
  .au-choices input:focus-visible + .au-choice {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* only the chosen answer's paths are shown; without :has() both are */
  .au-branch {
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--fg);
  }
  @supports selector(:has(*)) {
    .au-branch {
      display: none;
    }
    .au:has(input[value='person']:checked) [data-authority='person'],
    .au:has(input[value='agent']:checked) [data-authority='agent'] {
      display: block;
    }
  }
  .au-branch h3 {
    margin: 0 0 0.9rem;
    font-size: 1.14rem;
  }
  .au-next {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-right: 0.6em;
  }
  .au-paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.2rem 2rem;
  }
  .au-paths h4 {
    margin: 0 0 0.4rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.98rem;
  }
  .au-paths .note {
    margin: 0 0 0.5rem;
    font-size: 0.88rem;
    color: var(--fg-muted);
  }
  .au-paths ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .au-paths li {
    margin: 0 0 0.45rem;
    line-height: 1.35;
  }
  .au-paths .hint {
    display: block;
    font-size: 0.88rem;
    color: var(--fg-muted);
  }
  .more {
    margin: 1.6rem 0 0;
    color: var(--fg-muted);
    max-width: 44rem;
  }

  .what {
    margin-top: 1.2rem;
  }
  .what h3 {
    font-size: 1.4rem;
  }

  .news {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1.5px solid var(--fg);
  }
  .news li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .news a {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.2rem 2rem;
    padding: 0.85rem 0;
    color: var(--accent);
    text-decoration: none;
  }
  .news a:hover strong {
    color: var(--accent);
  }
  .news strong {
    font-family: var(--font-heading);
    font-size: 1.16rem;
    font-weight: 560;
  }
  .news span {
    color: var(--fg-muted);
  }
  @media (max-width: 40rem) {
    .news a {
      grid-template-columns: 1fr;
    }
  }

  .index {
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin-top: 1.2rem;
  }
  .index h3 {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1.5px solid var(--fg);
  }
  .index ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.96rem;
  }
  .index li {
    margin: 0.3rem 0;
  }
  .index a {
    text-decoration-color: var(--border-strong);
  }
  .index a:hover {
    text-decoration-color: var(--accent);
  }
</style>
