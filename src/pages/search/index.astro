---
import Base from "../../layouts/Base.astro";
import GuideSearch from "../../components/GuideSearch.astro";

const browse = [
  {
    href: "/guide/",
    title: "Choose a flow",
    detail: "Work through six questions about your agent.",
  },
  {
    href: "/glossary/",
    title: "Glossary",
    detail: "Look up a term or abbreviation.",
  },
  {
    href: "/standards/",
    title: "Standards tracker",
    detail: "Find a specification and its status.",
  },
  {
    href: "/implementations/",
    title: "Implementations",
    detail: "Browse products and the roles they support.",
  },
];
---

<Base title="Search the guide" description="Find a passage about agent authentication and authorization by describing your situation or naming a protocol." noindex>
  <div class="wrap search-page">
    <div>
      <h1>Search the guide</h1>
      <GuideSearch />
    </div>
    <aside aria-labelledby="search-browse">
      <h2 id="search-browse">Browse the guide</h2>
      <ul>
        {browse.map(({ href, title, detail }) => (
          <li><a href={href}>{title}</a><p>{detail}</p></li>
        ))}
      </ul>
    </aside>
  </div>
</Base>

<style>
  .search-page {
    display: grid;
    grid-template-columns: minmax(0, 44rem) minmax(13rem, 18rem);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .search-page h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    text-transform: none;
  }
  aside { border-top: 2px solid var(--fg); padding-top: 0.8rem; }
  aside h2 { font-size: 1.05rem; text-transform: none; margin: 0 0 0.5rem; }
  aside ul { list-style: none; padding: 0; margin: 0; }
  aside li { border-bottom: 1px solid var(--border); padding: 0.65rem 0; margin: 0; }
  aside a { font-weight: 600; }
  aside p { color: var(--fg-muted); font-size: 0.92rem; margin: 0.1rem 0 0; }
  @media (max-width: 48rem) {
    .search-page { grid-template-columns: minmax(0, 1fr); }
  }
</style>
