---
/**
 * The living style guide. Everything on this page is rendered with the real
 * tokens and components, so it cannot drift from the site.
 * Values and contrast ratios are read from the browser, not written by hand.
 */
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";
import FlowCard from "../../components/FlowCard.astro";
import TokenInspector from "../../components/TokenInspector.astro";
import LastHop from "../../components/LastHop.astro";
import Check from "../../components/Check.astro";
import Here from "../../components/Here.astro";
import Mixup from "../../components/Mixup.astro";
import Scenario from "../../components/Scenario.astro";
import { apiSees } from "../../data/learn/api-sees";
import { gloss } from "../../lib/gloss";
import { block } from "../../lib/md";
import { flow } from "../../data/flows";
import { ROLE_LABEL, STATUS_LABEL, STATUS_TONE } from "../../data/types";
import type { Role, StdStatus } from "../../data/types";
import { codeThemes } from "../../lib/code-themes.mjs";

const surfaces = [
  ["--bg", "The page."],
  [
    "--bg-raised",
    "Cards, panels and code blocks: anything that sits on the page.",
  ],
  [
    "--bg-sunken",
    "Wells, hovered rows, the footer: anything set into the page.",
  ],
  ["--bg-inset", "The deepest step. Rare."],
];
const text = [
  ["--fg", "Body text and headings."],
  ["--fg-muted", "Ledes, captions, secondary text."],
  [
    "--fg-subtle",
    "The lightest text allowed. Counts, placeholders, fine print.",
  ],
];
const lines = [
  ["--border", "Hairlines between rows and around cards."],
  ["--border-strong", "Control outlines and rules that need to be seen."],
];
const accent = [
  ["--accent", "Links, focus rings, the primary button, the current item."],
  ["--accent-soft", "The highlight behind a targeted entry."],
  ["--on-accent", "Text on an accent fill."],
];
const hues: { id: string; role: Role; also: string }[] = [
  { id: "red", role: "human", also: "Also: danger, “no,” cautions." },
  { id: "blue", role: "agent", also: "Also: working group drafts." },
  { id: "violet", role: "authz", also: "Also: projects and platforms." },
  {
    id: "green",
    role: "resource",
    also: "Also: success, “yes,” published standards.",
  },
  {
    id: "amber",
    role: "infra",
    also: "Also: “partly,” individual drafts, out-of-band messages.",
  },
];

const textTokens = [
  "--fg",
  "--fg-muted",
  "--fg-subtle",
  "--accent",
  "--red",
  "--blue",
  "--violet",
  "--green",
  "--amber",
];
const grounds = ["--bg", "--bg-raised", "--bg-sunken"];

const families = [
  ["--font-display", "Display", "Who’s on first?"],
  ["--font-body", "Body", "Exchange, never forward."],
  ["--font-label", "Label", "STABLE STANDARDS · 14 STEPS"],
  ["--font-mono", "Mono", "grant_type=client_credentials"],
];

const shape = [
  ["--radius", "Cards, buttons, code blocks."],
  ["--radius-pill", "Chips and segmented choices."],
  ["--radius-round", "Step numbers and markers."],
];

const statuses = Object.keys(STATUS_LABEL) as StdStatus[];
const sample = flow("client-credentials");
const cards = ["mcp-authorization", "ciba", "spiffe-workload-identity"].map(
  flow,
);

const toc = [
  ["color", "Color"],
  ["contrast", "Contrast"],
  ["type", "Type"],
  ["shape", "Shape"],
  ["components", "Components"],
  ["diagrams", "Diagrams"],
  ["lessons", "Lessons"],
  ["voice", "Voice"],
];
---

<Base
  title="Style guide"
  description="The living style guide for Who’s on First: color and type tokens with live contrast ratios, and every component rendered with the real code."
  here={{ current: 'Style guide' }}
  markdown={false}
>
  <div class="page-head">
    <div class="wrap">
      <h1>How the site looks, and why</h1>
      <p class="lede">
        Every swatch, specimen and component below is the real thing, rendered from the same tokens the site uses.
        Use the theme button in the header to see it in light and dark.
      </p>
      <nav class="sg-toc" aria-label="On this page">
        {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </div>
  </div>

  <style-guide>
    <section class="section" id="color">
      <div class="wrap">
        <div class="section-head">
          <h2>Color</h2>
          <p>Values shown are read from this page as rendered, in the current theme.</p>
        </div>

        <h3>Surfaces</h3>
        <div class="sw-grid">
          {
            surfaces.map(([t, use]) => (
              <div class="sw">
                <span class="sw-chip" style={`background: var(${t})`} data-swatch />
                <code>{t}</code>
                <span class="sw-val" />
                <p>{use}</p>
              </div>
            ))
          }
        </div>

        <h3>Text and lines</h3>
        <div class="sw-grid">
          {
            [...text, ...lines].map(([t, use]) => (
              <div class="sw">
                <span class="sw-chip" style={`background: var(${t})`} data-swatch />
                <code>{t}</code>
                <span class="sw-val" />
                <p>{use}</p>
              </div>
            ))
          }
        </div>

        <h3>Accent</h3>
        <p class="sg-para">
          The accent marks interaction: something you can follow, press, or are currently on. It is separate from the
          five hues so that a link never reads as a role.
        </p>
        <div class="sw-grid">
          {
            accent.map(([t, use]) => (
              <div class="sw">
                <span class="sw-chip" style={`background: var(${t})`} data-swatch />
                <code>{t}</code>
                <span class="sw-val" />
                <p>{use}</p>
              </div>
            ))
          }
        </div>

        <h3>The five hues</h3>
        <p class="sg-para">
          Every diagram on the site assigns one hue to each kind of principal, and keeps that assignment everywhere.
          Each hue has a solid value for text and outlines and a soft value for fills.
        </p>
        <div class="hue-grid">
          {
            hues.map((h) => (
              <div class={`hue role-${h.role}`}>
                <div class="hue-pair">
                  <span class="sw-chip" style={`background: var(--${h.id})`} data-swatch />
                  <span class="sw-chip" style={`background: var(--${h.id}-soft)`} data-swatch />
                </div>
                <strong>{ROLE_LABEL[h.role]}</strong>
                <code>--{h.id}</code>
                <code>--{h.id}-soft</code>
                <p>{h.also}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="contrast">
      <div class="wrap">
        <div class="section-head">
          <h2>Contrast</h2>
          <p>Each cell is measured live. Text needs 4.5 to 1 to pass WCAG AA.</p>
        </div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Contrast of each text pairing">
          <table class="cx-table">
            <thead>
              <tr>
                <th scope="col">Text token</th>
                {grounds.map((g) => <th scope="col">on {g}</th>)}
                <th scope="col">on its own soft fill</th>
              </tr>
            </thead>
            <tbody>
              {
                textTokens.map((t) => {
                  const soft = hues.some((h) => `--${h.id}` === t) ? `${t}-soft` : t === '--accent' ? '--accent-soft' : null;
                  return (
                    <tr>
                      <th scope="row">
                        <code>{t}</code>
                      </th>
                      {grounds.map((g) => (
                        <td>
                          <span class="cx" style={`color: var(${t}); background: var(${g})`} data-contrast>
                            Aa
                          </span>
                          <span class="cx-r" />
                        </td>
                      ))}
                      <td>
                        {soft ? (
                          <>
                            <span
                              class="cx"
                              style={`color: var(${t === '--accent' ? '--fg' : t}); background: var(${soft})`}
                              data-contrast
                            >
                              Aa
                            </span>
                            <span class="cx-r" />
                          </>
                        ) : (
                          <span class="muted">–</span>
                        )}
                      </td>
                    </tr>
                  );
                })
              }
              <tr>
                <th scope="row"><code>--on-accent</code></th>
                <td colspan={grounds.length + 1}>
                  <span class="cx" style="color: var(--on-accent); background: var(--accent)" data-contrast>
                    Aa on --accent
                  </span>
                  <span class="cx-r" />
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="sg-note">
          The same pairs are checked in both themes by <code>npm run check:contrast</code>, which
          fails if any text pair drops below 4.5 to 1.
        </p>
      </div>
    </section>

    <section class="section" id="type">
      <div class="wrap">
        <div class="section-head">
          <h2>Type</h2>
          <p>Four roles, filled by two families.</p>
        </div>
        <div class="fam-list">
          {
            families.map(([t, role, sample]) => (
              <div class="fam">
                <div class="fam-meta">
                  <strong>{role}</strong>
                  <code>{t}</code>
                  <span class="fam-name" data-family={t} />
                </div>
                <p class="fam-sample" style={`font-family: var(${t})`} data-kind={role.toLowerCase()}>
                  {sample}
                </p>
              </div>
            ))
          }
        </div>

        <h3>Scale</h3>
        <div class="scale">
          <div><span>h1</span><p class="as-h1">Who is acting?</p></div>
          <div><span>h2</span><p class="as-h2">Delegation or impersonation</p></div>
          <div><span>h3</span><p class="as-h3">The agent redeems the code directly</p></div>
          <div><span>h4</span><p class="as-h4">Token Exchange</p></div>
          <div><span>lede</span><p class="lede">A field guide to every way an AI agent can prove what it is and what it may do.</p></div>
          <div>
            <span>body</span>
            <p>
              A service that needs to call another gets a new token for that hop. Passing along the one it received is
              how a token meant for one place ends up everywhere.
            </p>
          </div>
          <div><span>label</span><p class="eyebrow">Flows / Delegation chains</p></div>
          <div><span>code</span><p><code>aud</code>, <code>act.sub</code>, <code>cnf.jkt</code></p></div>
        </div>
      </div>
    </section>

    <section class="section" id="shape">
      <div class="wrap">
        <div class="section-head">
          <h2>Shape</h2>
          <p>Three radii, and three widths that every page shares.</p>
        </div>
        <div class="sw-grid">
          {
            shape.map(([t, use]) => (
              <div class="sw">
                <span class="shape-box" style={`border-radius: var(${t})`} />
                <code>{t}</code>
                <span class="sw-val" data-length={t} />
                <p>{use}</p>
              </div>
            ))
          }
        </div>
        <div class="table-scroll widths" tabindex="0" role="region" aria-label="Type widths">
          <table>
            <thead>
              <tr><th>Token</th><th>Value</th><th>Use</th></tr>
            </thead>
            <tbody>
              <tr><td><code>--wide</code></td><td>72rem</td><td>The widest a page gets. Diagrams and grids use all of it.</td></tr>
              <tr><td><code>--prose</code></td><td>44rem</td><td>Running text. About 70 characters a line.</td></tr>
              <tr><td><code>--gutter</code></td><td>1rem to 2.5rem</td><td>Side padding, growing with the viewport.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" id="components">
      <div class="wrap">
        <div class="section-head">
          <h2>Components</h2>
          <p>The building blocks, with what each is for.</p>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Where you are</h3>
            <p>
              A long page carries a line under the site header: the way to the page, the page’s short name and, once
              the reader has scrolled, the section they are in. It stays in view with the header and takes the place
              of the small label above a title. On a phone it gives way to the page’s name alone. The one at the top
              of this page is live.
            </p>
          </div>
          <div class="spec-demo">
            <Here
              trail={[{ label: 'Learn', href: '/learn/' }, { label: 'Lesson 3 of 6', short: '3 of 6' }]}
              current="Getting a token"
            />
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Buttons</h3>
            <p>
              One primary action per view. Everything else is a plain button, and tertiary actions are ghosts. Labels
              say what happens: “Explore the flows,” never “Click here.”
            </p>
          </div>
          <div class="spec-demo row">
            <a class="btn primary" href="#components">Explore the flows</a>
            <a class="btn" href="#components">Find the one you need</a>
            <button class="btn ghost" type="button">All steps</button>
            <button class="btn small" type="button">← Prev</button>
            <button class="btn small" type="button" disabled>Next →</button>
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Chips</h3>
            <p>
              Short facts about the thing they sit on. A neutral chip states a property. A toned chip states a
              category, and takes its hue from the table above, so the same color always means the same thing.
            </p>
          </div>
          <div class="spec-demo">
            <div class="chips">
              <span class="chip">14 steps</span>
            </div>
            <div class="chips">
              {
                statuses.map((s) => (
                  <span class="chip" data-tone={STATUS_TONE[s]}>
                    {STATUS_LABEL[s]}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Cards</h3>
            <p>
              A linked card goes to one place. Its title is underlined, and the whole card can be clicked or focused.
              Use cards for a set of peers. Records with several destinations keep separate links.
            </p>
          </div>
          <div class="spec-demo">
            <div class="grid">
              {cards.map((f) => <FlowCard flow={f} />)}
            </div>
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Callouts</h3>
            <p>
              For the one thing on a page a reader must not miss. If a page has three, none of them is a callout.
              Red is for a risk, amber for a caveat.
            </p>
          </div>
          <div class="spec-demo">
            <div class="callout">
              <p class="callout-title">Reading status correctly</p>
              <p>A working group draft has been adopted, and can still change in incompatible ways.</p>
            </div>
            <div class="callout" data-tone="red">
              <p class="callout-title">The trap in the middle</p>
              <p>An unattended agent holding a person’s long-lived token has a human’s authority and no human watching.</p>
            </div>
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Roles</h3>
            <p>
              Five kinds of participant appear in every diagram. The class <code>role-human</code>,{' '}
              <code>role-agent</code> and so on sets <code>--role</code> and <code>--role-soft</code> for anything inside
              it.
            </p>
          </div>
          <div class="spec-demo row">
            {
              hues.map((h) => (
                <span class={`role-box role-${h.role}`}>
                  <strong>{ROLE_LABEL[h.role]}</strong>
                </span>
              ))
            }
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Tables</h3>
            <p>
              For comparing the same facts across several things. Column heads are labels; the first column names the
              row. Wide tables scroll inside their own frame, never the page.
            </p>
          </div>
          <div class="spec-demo">
            <div class="table-scroll" tabindex="0" role="region" aria-label="Example table">
              <table>
                <thead>
                  <tr><th>Flow</th><th>Human</th><th>Token subject</th><th>Maturity</th></tr>
                </thead>
                <tbody>
                  <tr><td>Authorization code + PKCE</td><td>present</td><td>User</td><td>Stable standards</td></tr>
                  <tr><td>Backchannel approval (CIBA)</td><td>reachable</td><td>User, for one action</td><td>Stable standards</td></tr>
                  <tr><td>Workload identity federation</td><td>absent</td><td>Agent, as a workload</td><td>Stable standards</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Code</h3>
            <p>
              Inline code names a real identifier: a claim, a parameter, a header. Blocks show what is on the wire.
              Examples are abbreviated for reading and say so.
            </p>
          </div>
          <div class="spec-demo">
            <p>
              The <code>resource</code> parameter asks for a token that is valid for one API only, and the API checks{' '}
              <code>aud</code>.
            </p>
            <Code
              code={`POST /token HTTP/1.1
Host: auth.example
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&resource=https://erp.example/api`}
              lang="http"
              themes={codeThemes as any}
              defaultColor={false}
            />
          </div>
        </div>

        <div class="spec">
          <div class="spec-text">
            <h3>Comparison</h3>
            <p>
              Yes, no and partly are stated in words as well as color, so the answer survives a grayscale print and a
              color-blind reader.
            </p>
          </div>
          <div class="spec-demo">
            <LastHop />
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="diagrams">
      <div class="wrap">
        <div class="section-head">
          <h2>Diagrams</h2>
          <p>Sequence diagrams are drawn at build time from data, so they take the tokens like everything else.</p>
        </div>
        <div class="sg-rules">
          <p><strong>One column per participant</strong>, colored by role.</p>
          <p><strong>Line style is meaning.</strong> Solid for a direct call, dashed for a response, dotted for out of band, and the human hue for anything that passes through a person’s browser.</p>
          <p><strong>Labels stay short.</strong> Two lines at most; the panel carries the explanation.</p>
        </div>
        <FlowDiagram flow={sample} />

        <h3 class="sg-gap">Annotated tokens</h3>
        <TokenInspector only={['user-access-token', 'delegated-token']} />
      </div>
    </section>

    <section class="section" id="lessons">
      <div class="wrap">
        <div class="section-head">
          <h2>Lessons</h2>
          <p>What a lesson is built from. Each works with scripts off.</p>
        </div>
        <div class="sg-rules">
          <p><strong>A figure makes its point before a click.</strong> Its first state is a complete picture, because most readers never touch it.</p>
          <p><strong>Every variation is also in a table.</strong> What a choice would show, the table beneath already says.</p>
          <p><strong>Questions explain.</strong> Choosing an answer says whether it is right and, either way, why.</p>
          <p><strong>One hard rule a lesson, at most.</strong> A lesson’s “never” is shown under “What to keep”, beneath the ideas and under a label of its own, with a red edge. It interrupts nothing, and a prohibition does not sit straight under a heading that says keep.</p>
          <p><strong>What must not be built says so.</strong> A figure compares approaches, and a comparison can be taken for a menu. A dangerous one carries the warning sign on its button, says so with the reason in its panel, and is marked in the table.</p>
        </div>
        <Scenario scenario={apiSees} glance="All three at a glance" />

        <Check
          id="sg-check"
          title="A question, with the reason for each answer"
          intro="As it appears at the end of a lesson, under “Check yourself”."
          questions={[
            {
              id: 'sg-question',
              question: 'Which of these can an API rely on without taking the agent’s word?',
              options: [
                { text: 'A name the agent adds to the request.', why: 'The agent can put any name there.' },
                {
                  text: 'A token that names the user, signed by a service the API trusts.',
                  correct: true,
                  why: 'The agent did not write it and cannot change it.',
                },
              ],
            },
          ]}
        />

        <h3 class="sg-gap">A mistake, named and corrected</h3>
        <Mixup belief="A token is encrypted.">
          <p>A JWT is signed, not encrypted. Anyone who holds one can read it.</p>
        </Mixup>

        <h3 class="sg-gap">A term, defined where it is used</h3>
        <div
          class="prose"
          set:html={block(
            'The first use of a glossary term on a flow page is marked. Pressing it shows the definition in place: an access token is addressed to one audience, and a refresh token is not sent to an API at all.',
            gloss(),
          )}
        />
      </div>
    </section>

    <section class="section" id="voice">
      <div class="wrap">
        <div class="section-head">
          <h2>Voice</h2>
          <p>How the site talks.</p>
        </div>
        <div class="voice">
          <div>
            <h3>Plain words first, then the name</h3>
            <p>“A service the API trusts signs it. That service is called an authorization server.” A term arrives after the idea it names, never before.</p>
          </div>
          <div>
            <h3>Say who does what</h3>
            <p>“The agent redeems the code.” Not “the code is redeemed.” Auth is about who acts; passive sentences hide exactly that.</p>
          </div>
          <div>
            <h3>State it, then stop</h3>
            <p>One clear sentence beats a hedge. Where something is uncertain, say what is uncertain and why, once, in the place it applies.</p>
          </div>
          <div>
            <h3>Name a thing once</h3>
            <p>Pick the term, define it in the glossary, and keep using it. A “grant” in one paragraph is not a “permission” in the next.</p>
          </div>
          <div>
            <h3>Status is a fact</h3>
            <p>“Working group draft, revision 11” is a status. “Emerging standard” is an opinion. Report what a source says and link to it.</p>
          </div>
          <div>
            <h3>The joke is the frame, not the filling</h3>
            <p>Who, What and I Don’t Know organize the ideas. They do not appear in every heading. A reference page earns trust by being plain.</p>
          </div>
          <div>
            <h3>Cautions come with a way out</h3>
            <p>Every “watch out” says what to do instead. A warning with no alternative is just worry.</p>
          </div>
        </div>
      </div>
    </section>
  </style-guide>
</Base>

<script>
  // Reads rendered values so the guide can never drift from the stylesheet.
  class StyleGuide extends HTMLElement {
    connectedCallback() {
      const root = document.documentElement;
      const rgb = (s: string) => (s.match(/[\d.]+/g) ?? []).slice(0, 3).map(Number);
      const hex = (s: string) => '#' + rgb(s).map((n) => Math.round(n).toString(16).padStart(2, '0')).join('');
      const lum = (s: string) => {
        const [r, g, b] = rgb(s).map((v) => {
          const c = v / 255;
          return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
        });
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
      };

      const refresh = () => {
        this.querySelectorAll<HTMLElement>('[data-swatch]').forEach((el) => {
          const out = el.parentElement?.classList.contains('hue-pair')
            ? null
            : el.parentElement?.querySelector<HTMLElement>('.sw-val');
          if (out) out.textContent = hex(getComputedStyle(el).backgroundColor);
        });
        this.querySelectorAll<HTMLElement>('[data-contrast]').forEach((el) => {
          const cs = getComputedStyle(el);
          const [a, b] = [lum(cs.color), lum(cs.backgroundColor)].sort((x, y) => y - x);
          const ratio = (a + 0.05) / (b + 0.05);
          const out = el.nextElementSibling as HTMLElement | null;
          if (!out) return;
          out.textContent = `${ratio.toFixed(2)} ${ratio >= 4.5 ? 'AA' : ratio >= 3 ? 'large only' : 'fails'}`;
          out.dataset.level = ratio >= 4.5 ? 'pass' : ratio >= 3 ? 'large' : 'fail';
        });
        this.querySelectorAll<HTMLElement>('[data-family]').forEach((el) => {
          const sample = el.closest('.fam')?.querySelector<HTMLElement>('.fam-sample');
          if (sample) el.textContent = getComputedStyle(sample).fontFamily.split(',')[0].replace(/["']/g, '').replace(/ Variable$/, '');
        });
        this.querySelectorAll<HTMLElement>('[data-length]').forEach((el) => {
          el.textContent = getComputedStyle(root).getPropertyValue(el.dataset.length!).trim();
        });
      };

      new MutationObserver(refresh).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', refresh);
      document.fonts?.ready.then(refresh);
      refresh();
    }
  }
  customElements.define('style-guide', StyleGuide);
</script>

