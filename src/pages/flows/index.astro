---
import Base from "../../layouts/Base.astro";
import FlowCard from "../../components/FlowCard.astro";
import { byGroup, flow, flows, maturityLabel } from "../../data/flows";
import { HUMAN_LABEL } from "../../data/types";

const groups = byGroup();

/** Who the resulting credential is about, and what the agent proves itself with. */
const COMPARE: Record<string, [subject: string, proof: string]> = {
  "authorization-code-pkce": [
    "User",
    "PKCE, plus client authentication if confidential",
  ],
  "mcp-authorization": ["User", "Client ID metadata URL and PKCE"],
  "device-authorization": ["User", "Device code"],
  "step-up-authorization": [
    "User, for one action",
    "Same as the underlying flow",
  ],
  ciba: ["User, for one action", "Signed client assertion"],
  "url-elicitation": [
    "User, at the third party",
    "Nothing: the server holds the grant",
  ],
  aauth: [
    "User, as their person server names them",
    "A signature from its own key on every request",
  ],
  "token-exchange": [
    "User, with the actor named",
    "Client authentication and the token it received",
  ],
  "biscuit-delegation": [
    "Permissions; no caller identity in this example",
    "Possession of a restricted bearer token",
  ],
  "cross-app-access": ["User", "A grant issued by the identity provider"],
  "identity-chaining": [
    "User or agent, mapped per domain",
    "A signed grant from the home domain",
  ],
  "transaction-tokens": ["User and transaction", "Workload identity"],
  "client-credentials": ["Agent", "Signed assertion or client secret"],
  "workload-identity-federation": [
    "Agent, as a workload",
    "A token issued by the platform",
  ],
  "spiffe-workload-identity": [
    "Agent, as a workload",
    "Certificate obtained by attestation",
  ],
  "wimse-workload-tokens": [
    "Agent, as a workload",
    "Key-bound token and per-request proof",
  ],
  "agent-to-agent": [
    "Whatever the token says",
    "A scheme declared in the Agent Card",
  ],
  "web-bot-auth": ["Agent operator", "HTTP message signature"],
  "agent-payments": ["User’s signed intent", "A key named in the mandate"],
  dpop: ["Unchanged", "A signed proof on every request"],
  "oauth-mtls": [
    "Set by the grant (the agent here)",
    "The key for the bound certificate, in TLS",
  ],
  "tool-call-authorization": [
    "Agent acting for a user",
    "Existing bearer token",
  ],
  "access-revocation": [
    "Employee, plus the company session ID",
    "Existing bearer access token",
  ],
  "credential-broker": ["Unchanged", "Nothing: the proxy holds the secret"],
};
for (const f of flows) {
  if (!COMPARE[f.slug])
    throw new Error(`flows/index: add "${f.slug}" to COMPARE`);
}

/**
 * The flows the lessons introduce, in the order the lessons do, each with the
 * situation it answers. The rest of the catalog is variations on these.
 */
const START: [slug: string, when: string][] = [
  ["authorization-code-pkce", "A person is there to sign in."],
  [
    "mcp-authorization",
    "A person is there to sign in, and the agent has never seen the server before.",
  ],
  ["client-credentials", "Nobody is there. The agent acts as itself."],
  [
    "workload-identity-federation",
    "The agent acts as itself, and the platform it runs on vouches for it.",
  ],
  ["token-exchange", "A tool in the middle has to call the next API."],
  ["dpop", "A copied token should be useless to whoever copied it."],
];
const start = START.map(([slug, when]) => ({ flow: flow(slug), when }));

const filters = [
  { id: "all", label: "All flows" },
  { id: "present", label: "Human present" },
  { id: "reachable", label: "Human reachable" },
  { id: "absent", label: "No human" },
];
---

<Base
  title="Agent authentication and authorization flows"
  description="Step-by-step walkthroughs of how AI agents get, use and lose access, from user consent to workload identity and revocation."
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Flows</p>
      <h1>How agents get, use and lose access</h1>
      <p class="lede">
        {flows.length} flows, each as a sequence diagram you can step through. They are grouped by the question that
        matters most when choosing between them: is there a person involved, and when?
      </p>
    </div>
  </div>

  <div class="wrap fl">
    <section class="fl-start" aria-labelledby="start">
      <div class="section-head">
        <h2 id="start">Start with these</h2>
        <p>
          Six flows cover the common ways to get access. If the vocabulary is new,{' '}
          <a href="/learn/">the lessons</a> come first.
        </p>
      </div>
      <ol>
        {
          start.map(({ flow: f, when }) => (
            <li>
              <a href={`/flows/${f.slug}/`}>
                <span class="when">{when}</span>
                <strong>{f.short}</strong>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <h2 class="fl-all" id="all">Every flow</h2>
    <fieldset class="fl-filter">
      <legend class="visually-hidden">Filter by human involvement</legend>
      {
        filters.map((f, i) => (
          <label>
            <input type="radio" name="human" value={f.id} checked={i === 0} />
            <span>{f.label}</span>
          </label>
        ))
      }
    </fieldset>

    {
      groups.map((g) => (
        <section class="fl-group" aria-labelledby={`g-${g.id}`}>
          <div class="section-head">
            <h2 id={`g-${g.id}`}>{g.title}</h2>
            <p>{g.blurb}</p>
          </div>
          <div class="grid">
            {g.flows.map((f) => (
              <div class="fl-cell" data-human={f.human}>
                <FlowCard flow={f} />
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="fl-table" aria-labelledby="compare">
      <div class="section-head">
        <h2 id="compare">Side by side</h2>
        <p>Who the token is about, and what proves it.</p>
      </div>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Flows compared">
        <table>
          <thead>
            <tr>
              <th>Flow</th>
              <th>Human</th>
              <th>Token subject</th>
              <th>Agent proves itself with</th>
              <th>Maturity</th>
            </tr>
          </thead>
          <tbody>
            {
              flows.map((f) => (
                <tr>
                  <td>
                    <a href={`/flows/${f.slug}/`}>{f.short}</a>
                  </td>
                  <td>{HUMAN_LABEL[f.human].replace('Human ', '').replace('With or without a human', 'Either')}</td>
                  <td>{COMPARE[f.slug][0]}</td>
                  <td>{COMPARE[f.slug][1]}</td>
                  <td>{maturityLabel(f)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

<style>
  .fl {
    padding-top: 1.6rem;
  }
  .fl-filter {
    border: 0;
    padding: 0;
    margin: 0 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    position: sticky;
    top: 3.6rem;
    z-index: 5;
    background: var(--bg);
    padding-block: 0.7rem;
  }
  .fl-filter label {
    cursor: pointer;
  }
  .fl-filter input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .fl-filter span {
    display: block;
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.55rem 0.9rem;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
  }
  .fl-filter label:hover span {
    border-color: var(--fg);
    color: var(--fg);
  }
  .fl-filter input:checked + span {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .fl-filter input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* where to start: the situation first, then the name of the flow that answers it */
  .fl-start {
    padding-bottom: 2.2rem;
    border-bottom: 1px solid var(--fg);
  }
  .fl-start h2,
  .fl-all {
    margin: 0;
    font-size: 1.6rem;
  }
  .fl-all {
    margin-top: 2rem;
  }
  .fl-start ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 0 2.5rem;
    border-top: 1.5px solid var(--fg);
  }
  .fl-start li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .fl-start ol a {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.3rem 0.75rem 0;
    text-decoration: none;
  }
  .fl-start ol a:hover {
    background: var(--accent-soft);
  }
  .fl-start .when {
    font-size: 0.98rem;
    line-height: 1.4;
    color: var(--fg);
  }
  .fl-start strong {
    justify-self: start;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .fl-start strong::after {
    content: ' →';
  }

  .fl-group {
    padding-block: 1.8rem;
    border-top: 1px solid var(--border);
  }
  .fl-group:first-of-type {
    border-top: 0;
  }
  .fl-group h2 {
    margin: 0;
    font-size: 1.6rem;
  }
  .fl-cell {
    display: grid;
  }

  /* CSS-only filter. "any" flows always show. */
  .fl:has(input[value='present']:checked) .fl-cell:not([data-human='present'], [data-human='any']),
  .fl:has(input[value='reachable']:checked) .fl-cell:not([data-human='reachable'], [data-human='any']),
  .fl:has(input[value='absent']:checked) .fl-cell:not([data-human='absent'], [data-human='any']) {
    display: none;
  }
  .fl:has(input[value='present']:checked) .fl-group:not(:has(.fl-cell:is([data-human='present'], [data-human='any']))),
  .fl:has(input[value='reachable']:checked)
    .fl-group:not(:has(.fl-cell:is([data-human='reachable'], [data-human='any']))),
  .fl:has(input[value='absent']:checked) .fl-group:not(:has(.fl-cell:is([data-human='absent'], [data-human='any']))) {
    display: none;
  }

  .fl-table {
    padding-block: 2rem 0;
    border-top: 1px solid var(--border);
  }
  .fl-table h2 {
    margin: 0;
    font-size: 1.6rem;
  }
  .fl-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
  }
</style>
