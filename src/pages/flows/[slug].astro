---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";
import FlowOverview from "../../components/FlowOverview.astro";
import FlowCredentials from "../../components/FlowCredentials.astro";
import FlowCard from "../../components/FlowCard.astro";
import StandardCard from "../../components/StandardCard.astro";
import DocMeta from "../../components/DocMeta.astro";
import ImplementationSummary from "../../components/ImplementationSummary.astro";
import { implementationProfile } from "../../data/implementations";
import {
  flow as flowBySlug,
  flows,
  maturityLabel,
  rating,
  related,
} from "../../data/flows";
import { lesson as lessonBySlug, lessons } from "../../data/learn/lessons";
import { std } from "../../data/standards";
import { REVIEWED } from "../../data/site";
import {
  GROUPS,
  HUMAN_LABEL,
  REF_ROLE_BLURB,
  REF_ROLE_TITLE,
  STATUS_LABEL,
} from "../../data/types";
import type { Flow, RefRole, Standard } from "../../data/types";
import { codeThemes } from "../../lib/code-themes.mjs";
import { gloss } from "../../lib/gloss";
import { block, inline } from "../../lib/md";
import { must } from "../../lib/must";

export function getStaticPaths() {
  return flows.map((flow) => ({
    params: { slug: flow.slug },
    props: { flow },
  }));
}

interface Props {
  flow: Flow;
}
const { flow } = Astro.props;
const implementationEvidence = implementationProfile(flow.slug);
// One reading of the page's own text: a glossary term is marked the first time it appears in it.
const g = gloss(Astro.url.pathname);
const group = must(
  GROUPS.find((g) => g.id === flow.group),
  `group "${flow.group}"`,
);
const standards = flow.standards.map(std);
// The worked example and any further sections are drawn the same way, in that order.
const sections = [
  ...(flow.example ? [{ id: "example", ...flow.example }] : []),
  ...(flow.sections ?? []),
];
const rel = related(flow);
// Two ways in for a reader who is not ready for the steps: the lesson that
// teaches the idea in plain words, and the flow this one is a variation of.
const taught = flow.lesson ? lessonBySlug(flow.lesson) : undefined;
const likened = flow.like ? flowBySlug(flow.like.flow) : undefined;
const i = flows.indexOf(flow);
const prev = flows[i - 1];
const next = flows[i + 1];

// What the page says the flow implements: `basis` if given, otherwise the first standard listed.
// A pattern that no specification defines names none, and says so in `noBasis`.
if (flow.noBasis && flow.basis)
  throw new Error(`[${flow.slug}] says it has no basis, and also names one`);
const basis = flow.noBasis ? [] : (flow.basis ?? [flow.standards[0]]).map(std);
const primary: Standard | undefined = basis[0];
const firstSentence = primary?.detail
  ?.split(/(?<=\.)\s/)[0]
  .replaceAll("`", "")
  .replace(/\.$/, "");
// On the one-line summary: a revision or version if the entry leads with one, a date for an RFC.
const numbered = /^(Revision|Version) ([^\s,.;]+)/.exec(firstSentence ?? "");
const dated = /^([A-Z][a-z]+ \d{4})/.exec(firstSentence ?? "");
// A flow that covers more than its diagram draws says so wherever its basis, its required
// references and its rating are stated: all three belong to the arrangement drawn.
const drawn = Boolean(flow.illustrated);
const based = primary && {
  key: drawn ? "Diagram based on" : undefined,
  refs: basis.map((s) => ({ ref: s.ref, href: `/standards/#${s.id}` })),
  status:
    basis.length > 1
      ? basis.every((s) => s.status === "rfc")
        ? "published RFCs"
        : basis.map((s) => STATUS_LABEL[s.status]).join(", ")
      : primary.status === "rfc"
        ? dated
          ? `published ${dated[1]}`
          : "published"
        : STATUS_LABEL[primary.status],
  revision:
    basis.length === 1 && primary.status !== "rfc" && numbered
      ? `${numbered[1].toLowerCase()} ${numbered[2]}`
      : undefined,
};

// Flows reviewed reference by reference show their standards grouped by role.
const ROLE_ORDER: RefRole[] = [
  "required",
  "optional",
  "background",
  "unresolved",
];
const roles = flow.roles;
const byRole = roles
  ? ROLE_ORDER.map((role) => ({
      role,
      items: standards.filter((s) => roles[s.id] === role),
    })).filter((g) => g.items.length > 0)
  : [];
const counted = roles
  ? standards.filter((s) => roles[s.id] === "required")
  : standards;
const others = standards.length - counted.length;

// A reference whose role is not settled is not counted. If requiring it would lower the rating,
// the rating is provisional, and the page names the references it is waiting on.
const rated = rating(flow);
const pending = (rated?.pending ?? []).map(std);
const pendingNames = new Intl.ListFormat("en", { type: "conjunction" }).format(
  pending.map((s) => s.name),
);
const unsettled = roles
  ? standards.filter((s) => roles[s.id] === "unresolved").length
  : 0;
const unrated = flow.maturity === "unrated";
const unsettledNote =
  pending.length > 0 && unrated
    ? `If ${pendingNames} turned out to be required, this flow would have a rating, so “not rated” is provisional until ${pending.length === 1 ? "its role is" : "their roles are"} settled.`
    : pending.length > 0
      ? `Requiring ${pendingNames} would lower this flow’s rating, so the rating is provisional until ${pending.length === 1 ? "its role is" : "their roles are"} settled.`
      : "None of them is less mature than the flow’s rating, so none could lower it.";

const nDraft = counted.filter(
  (s) => s.status === "wg-draft" || s.status === "draft",
).length;
const nPublished = counted.filter(
  (s) => s.status === "rfc" || s.status === "final",
).length;
const nOther = counted.length - nDraft - nPublished;
const makeup = [
  `${nPublished} published`,
  nDraft > 0 && `${nDraft} ${nDraft === 1 ? "draft" : "drafts"}`,
  nOther > 0 && `${nOther} ${nOther === 1 ? "project" : "projects"}`,
]
  .filter(Boolean)
  .join(", ");
const aboutDetails = [
  {
    label: "This page",
    value: "Implementation guide",
    note: "An explanation, not a specification",
  },
  {
    label: "Flow maturity",
    value: maturityLabel(flow),
    note: rated?.provisional
      ? `Provisional until the role of ${pendingNames} is settled: what the rating means`
      : unrated
        ? "None of its references is required, so there is no level to take: what the rating means"
        : flow.roles
          ? drawn
            ? "For the flow the diagram draws, from its required references: what the rating means"
            : "From its required references: what the rating means"
          : "What the rating means",
    noteHref: "/about/#how-flows-are-rated",
  },
  { label: "Human involvement in the diagram", value: HUMAN_LABEL[flow.human] },
  {
    label: "Review",
    value: `Checked against sources in ${REVIEWED}`,
    note: "How it was checked",
    noteHref: "/about/#how-facts-were-checked",
  },
];
const basisDetails = [
  ...basis.map((s) => ({
    label: s.ref,
    value: s.name,
    href: `/standards/#${s.id}`,
    note: [
      STATUS_LABEL[s.status],
      s.detail
        ?.split(/(?<=\.)\s/)[0]
        .replaceAll("`", "")
        .replace(/\.$/, ""),
    ]
      .filter(Boolean)
      .join(" · "),
  })),
  ...(flow.noBasis
    ? [{ label: "Primary specification", value: "None", note: flow.noBasis }]
    : []),
  flow.roles && counted.length === 0
    ? {
        label: "Required references",
        value: "None",
        href: "#standards",
        note:
          unsettled > 0
            ? `${others} listed: ${unsettled} with ${unsettled === 1 ? "a role" : "roles"} not settled, the rest optional or background`
            : `${others} listed as optional or background`,
      }
    : flow.roles
      ? {
          label: `${counted.length} required ${counted.length === 1 ? "reference" : "references"}`,
          value: makeup,
          href: "#standards",
          note:
            [
              drawn && "Required by the flow the diagram draws",
              others > 0 &&
                (unsettled > 0
                  ? `${others} more listed: ${unsettled} with ${unsettled === 1 ? "a role" : "roles"} not settled, the rest optional or background`
                  : `${others} more listed as optional or background`),
            ]
              .filter(Boolean)
              .join(". ") || undefined,
        }
      : {
          label: `All ${standards.length} specifications`,
          value: makeup,
          href: "#standards",
        },
];
const detailGroups = [
  { label: "About this guide", items: aboutDetails },
  {
    label: drawn ? "Diagram’s specification basis" : "Specification basis",
    items: basisDetails,
  },
];
---

<Base
  title={flow.title}
  reviewMetadata={!implementationEvidence}
  description={flow.tagline}
  article
  here={{ trail: [{ label: 'Flows', href: '/flows/' }, { label: group.title }], current: flow.short }}
>
  <article>
  <div class="page-head">
    <div class="wrap">
      <h1>{flow.title}</h1>
      <p class="lede">{flow.tagline}</p>
    </div>
  </div>

  <div class="wrap body">
    <div class="intro">
      <div class="prose">
        <Fragment set:html={block(flow.summary, g)} />
        <DocMeta based={based} lead={flow.noBasis} reviewed={REVIEWED} subject="Guide" groups={detailGroups} />
        {
          (taught || likened) && (
            <ul class="ways-in">
              {taught && (
                <li>
                  <strong>New to this?</strong>{' '}
                  <a href={`/learn/${taught.slug}/`}>
                    Lesson {lessons.indexOf(taught) + 1}: {taught.title}
                  </a>{' '}
                  covers the ground this builds on, in plain words.
                </li>
              )}
              {likened && (
                <li>
                  <strong>Know <a href={`/flows/${likened.slug}/`}>{likened.short}</a>?</strong>{' '}
                  This is the same, except that <Fragment set:html={inline(flow.like?.except ?? '')} />
                </li>
              )}
            </ul>
          )
        }
      </div>
      <section class="fit">
        <h2>Use it when</h2>
        <ul>
          {flow.fits.map((x) => <li set:html={inline(x, g)} />)}
        </ul>
      </section>
    </div>

    {flow.credentials && <FlowCredentials credentials={flow.credentials} gloss={g} />}

    {
      (flow.phases || flow.parts) && (
        <div class="overview">
          <FlowOverview flow={flow} gloss={g} />
        </div>
      )
    }

    <section aria-labelledby="walkthrough">
      <div class="section-head">
        <h2 id="walkthrough">Step by step</h2>
        <p>
          {flow.steps.length} steps between {flow.participants.length} parties. Each step shows the message and
          who holds which credential afterward.
        </p>
        <aside class="keys" aria-label="Using the diagram">
          <p>Use <kbd>←</kbd> <kbd>→</kbd> or select any arrow to follow a step. Every step stays in the list.</p>
        </aside>
      </div>
      {flow.illustrated && (
        <div class="prose drawn">
          <div set:html={block(flow.illustrated.steps, g)} />
          {flow.illustrated.preconditions && (
            <>
              <p class="setup-title"><strong>Already true before step 1</strong></p>
              <ul>
                {flow.illustrated.preconditions.map((condition) => (
                  <li set:html={inline(condition, g)} />
                ))}
              </ul>
            </>
          )}
          {flow.illustrated.examples && <p set:html={inline(flow.illustrated.examples, g)} />}
        </div>
      )}
      <FlowDiagram flow={flow} />
    </section>

    {
      flow.comparison && (
        <section aria-labelledby="comparison">
          <div class="section-head">
            <h2 id="comparison">{flow.comparison.title}</h2>
          </div>
          {flow.comparison.intro && <div class="prose" set:html={block(flow.comparison.intro, g)} />}
          {/* Two presentations of the same rows. CSS shows one and removes the other with
              display: none, which also takes it out of the accessibility tree and the tab order. */}
          <div
            class="table-scroll compare-wide"
            tabindex="0"
            role="region"
            aria-label={`Table: ${flow.comparison.title}`}
          >
            <table class="compare">
              <thead>
                <tr>
                  <th scope="col">{flow.comparison.rowHeading}</th>
                  {flow.comparison.fields.map((f) => (
                    <th scope="col">{f.heading}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {flow.comparison.rows.map((row) => (
                  <tr>
                    <th scope="row" set:html={inline(row.name)} />
                    {row.values.map((v) => (
                      <td set:html={inline(v)} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="compare-narrow">
            {flow.comparison.rows.map((row) => (
              <div class="env">
                <h3 set:html={inline(row.name)} />
                <dl>
                  {row.values.map((v, n) => (
                    <div>
                      <dt>{must(flow.comparison?.fields[n], `comparison field ${n + 1}`).label}</dt>
                      <dd set:html={inline(v)} />
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
          {flow.comparison.after && <div class="prose after" set:html={block(flow.comparison.after)} />}
        </section>
      )
    }

    {/* Most sections explain the flow before the cautions; source reviews close it. */}
    {
      [false, true].map((afterNotes) => (
        <>
          {afterNotes && (
            <section class="cols" aria-label="Cautions and notes">
              <div>
                <h2>Watch out for</h2>
                <ul class="watch">
                  {flow.watchOut.map((x) => <li set:html={inline(x, g)} />)}
                </ul>
              </div>
              {
                flow.notes && (
                  <div class="notes">
                    {flow.notes.map((note) => (
                      <>
                        <h2>{note.title}</h2>
                        <div set:html={block(note.body, g)} />
                      </>
                    ))}
                  </div>
                )
              }
            </section>
          )}
          {
            sections.filter((sec) => Boolean(sec.afterNotes) === afterNotes).map((sec) => (
              <section aria-labelledby={sec.id}>
                <div class="section-head">
                  <h2 id={sec.id}>{sec.title}</h2>
                </div>
                <div class="prose" set:html={block(sec.intro, g)} />
                <div class="worked">
                  {sec.parts.map((part) => (
                    <div class="part">
                      <h3>{part.title}</h3>
                      {part.tags && (
                        <p class="chips part-tags">
                          {part.tags.map((tag) => (
                            <span class="chip" data-tone={tag.tone}>
                              {tag.text}
                            </span>
                          ))}
                        </p>
                      )}
                      <div class="prose" set:html={block(part.body, g)} />
                      {part.code && (
                        <Code
                          code={part.code.text}
                          lang={part.code.lang as any}
                          themes={codeThemes as any}
                          defaultColor={false}
                        />
                      )}
                      {part.sources && (
                        <div class="sources">
                          <p>{part.sources.length === 1 ? 'Source' : 'Sources'}</p>
                          <ul>
                            {part.sources.map((src) => (
                              <li>
                                <a href={src.href} rel="noopener">
                                  {src.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
                {sec.after && <div class="prose section-after" set:html={block(sec.after)} />}
              </section>
            ))
          }
        </>
      ))
    }

    <section aria-labelledby="standards">
      <h2 id="standards">Standards in play</h2>
      <p><a href="/standards/">See the full tracker</a> for status and links.</p>
      {unrated && (
        <p>
          {flow.noBasis}, and no step on this page depends on any of the references below. So the flow has no required
          reference, and it is not rated: there is no level to take.{' '}
          <a href="/about/#how-flows-are-rated">How flows are rated</a>
        </p>
      )}
      {
        byRole.length > 0 ? (
          byRole.map((g) => (
            <div class="refs">
              <h3>{REF_ROLE_TITLE[g.role]}</h3>
              <p>
                {REF_ROLE_BLURB[g.role]}
                {g.role === 'unresolved' && ` ${unsettledNote}`}
              </p>
              {g.role === 'required' && flow.illustrated && (
                <p class="scope" set:html={inline(flow.illustrated.references)} />
              )}
              <div class="grid">
                {g.items.map((s) => (
                  <StandardCard standard={s} />
                ))}
              </div>
            </div>
          ))
        ) : (
          <div class="grid">
            {standards.map((s) => (
              <StandardCard standard={s} />
            ))}
          </div>
        )
      }
    </section>

    <ImplementationSummary slug={flow.slug} profile={implementationEvidence} />

    {
      rel.length > 0 && (
        <section aria-labelledby="related">
          <h2 id="related">Related flows</h2>
          <div class="grid">
            {rel.map((f) => (
              <FlowCard flow={f} />
            ))}
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label="More flows">
      {
        prev ? (
          <a href={`/flows/${prev.slug}/`}>
            <span>← Previous</span>
            {prev.short}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="next" href={`/flows/${next.slug}/`}>
            <span>Next →</span>
            {next.short}
          </a>
        )
      }
    </nav>
  </div>
  </article>
</Base>

<style>
  /* arrow keys only step the diagram where it is a stepper */
  @media (max-width: 47.99rem) {
    .keys {
      display: none;
    }
  }
  .body > section,
  .body > .overview {
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
  }
  /* ways in for a reader who is not ready for the steps */
  .ways-in {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
    font-size: 0.98rem;
  }
  .ways-in li {
    margin: 0;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .body h2 {
    margin-top: 0;
    font-size: 1.55rem;
  }
  .intro {
    display: grid;
    gap: 1.5rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(1.8rem, 4vw, 2.6rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }
  .intro .prose {
    font-size: 1.08rem;
  }
  /* "use it when" is a ruled note, not a colored box */
  .fit {
    border-top: 1px solid var(--fg);
    padding: 0.9rem 0 0;
  }
  .fit h2 {
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 0.7rem;
  }
  .fit ul {
    font-size: 0.96rem;
    padding-left: 1.1em;
  }

  /* references grouped by what the flow needs from them */
  .refs + .refs {
    margin-top: 1.6rem;
  }
  .refs h3 {
    margin: 0 0 0.15rem;
    font-size: 1.1rem;
  }
  .refs > p {
    margin: 0 0 0.7rem;
    font-size: 0.93rem;
    color: var(--fg-muted);
  }

  .section-head kbd {
    font-size: 0.78rem;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 3px;
    padding: 0 0.35em;
    background: var(--bg-raised);
  }

  /* what the diagram draws, said before it */
  .drawn {
    margin: -0.6rem 0 1.4rem;
  }
  .drawn :global(p) {
    margin: 0;
  }
  .drawn :global(p + p),
  .drawn .setup-title {
    margin-top: 0.9rem;
  }
  .drawn ul {
    margin: 0.5rem 0 0.9rem;
    padding-left: 1.2em;
  }
  .drawn li + li {
    margin-top: 0.25rem;
  }
  /* the scope of "required", in the body color so that it is not read as part of the gloss above it */
  .refs > .scope {
    max-width: var(--prose);
    color: var(--fg);
  }

  /* comparison, where there is room: a table. Column headings are phrases here, so they wrap;
     the row heading is a label like them, set in the body face so that it reads with its row */
  .compare {
    min-width: 46rem;
  }
  .compare thead th {
    white-space: normal;
    vertical-align: bottom;
  }
  .compare th[scope='row'] {
    white-space: normal;
    width: 9rem;
    font-family: var(--font-body);
    font-size: inherit;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    border-bottom: 1px solid var(--border);
  }
  .compare tr:last-child th[scope='row'] {
    border-bottom: 0;
  }

  /* comparison, where there is not: one block per row, each value under its own label, so that
     nothing has to be scrolled sideways to be read. Same frame as the table; labels as its
     column headings are set; fields ruled off as on the standards tracker. */
  .compare-narrow {
    display: none;
    margin: 0 0 1.5em;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--border);
    background: var(--bg-raised);
  }
  .env {
    padding: 0.9rem 0.8rem 0.3rem;
  }
  .env + .env {
    border-top: 1px solid var(--border);
  }
  .env h3 {
    margin: 0 0 0.6rem;
    font-size: 1.1rem;
  }
  .env dl {
    margin: 0;
  }
  .env dl > div {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.1rem 0.8rem;
    padding: 0.5rem 0;
    border-top: 1px dashed var(--border-strong);
  }
  .env dt {
    padding-top: 0.28rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .env dd {
    margin: 0;
  }
  @media (max-width: 59.99rem) {
    .compare-wide {
      display: none;
    }
    .compare-narrow {
      display: block;
    }
  }
  @media (max-width: 34rem) {
    .env dl > div {
      grid-template-columns: 1fr;
    }
    .env dt {
      padding-top: 0;
    }
  }
  .after {
    font-size: 0.96rem;
    color: var(--fg-muted);
  }

  /* worked example: parts in reading order, each a heading, a paragraph and perhaps a listing.
     Not numbered: "a numbered step" means a step of the diagram when references are classified. */
  .worked {
    margin: 1.4rem 0 0;
  }
  .part {
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .part + .part {
    margin-top: 1.3rem;
  }
  .part h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  .part :global(pre) {
    max-width: var(--prose);
  }
  .part-tags {
    margin: 0 0 0.7rem;
  }
  /* where a part comes from: a label as on the page-facts line, then the documents by title */
  .sources {
