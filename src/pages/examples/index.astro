---
import Base from "../../layouts/Base.astro";
import DocMeta from "../../components/DocMeta.astro";
import "../../styles/examples.css";
import { examples, SOURCES_READ } from "../../data/examples";
import { EVIDENCE_LABEL } from "../../data/examples/types";

const levels = [
  {
    level: "capability",
    text: "One component’s own documentation says it does this job.",
  },
  {
    level: "together",
    text: "A vendor or project documents these components working together.",
  },
  {
    level: "composed",
    text: "This site put documented components together. Nobody documents the combination.",
  },
  {
    level: "open",
    text: "A gap the page knows about. The label names the part, and it sits beside the choice it affects.",
  },
] as const;
---

<Base
  title="Worked examples"
  description="Situations worked through from start to finish: one design, why it fits, the variations that change it, and who has to do what to build it."
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Examples</p>
      <h1>Worked examples</h1>
      <p class="lede">
        Each starts from a situation, explains one design and why it fits, and ends with who has to do what.
      </p>
      <DocMeta
        lead={`${examples.length} examples, none of them a tested recipe`}
        reviewed={SOURCES_READ}
        reviewedKey="Sources read"
      />
    </div>
  </div>

  <div class="wrap ex-index">
    <ul class="ex-list">
      {
        examples.map((e) => (
          <li>
            <h2>
              <a href={`/examples/${e.slug}/`}>{e.title}</a>
            </h2>
            <p>{e.summary}</p>
            <dl>
              <div>
                <dt>Acts for</dt>
                <dd>{e.actsFor}</dd>
              </div>
              <div>
                <dt>Explains</dt>
                <dd>{e.explains}</dd>
              </div>
              <div>
                <dt>Variations</dt>
                <dd>
                  <ul>
                    {e.variations.map((v) => (
                      <li>
                        <a href={v.href}>{v.label}</a>, {v.note}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
              <div>
                <dt>Written up for</dt>
                <dd>{e.writtenFor}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>

    <section aria-labelledby="evidence">
      <h2 id="evidence">How to read the evidence labels</h2>
      <div class="prose">
        <p>
          An example is an authored design. Its build section says how well each combination of products is supported,
          which is a different question from whether each product does its own part.
        </p>
      </div>
      <dl class="ex-levels">
        {
          levels.map((l) => (
            <div>
              <dt>
                <span class="ev" data-level={l.level}>
                  {EVIDENCE_LABEL[l.level]}
                </span>
              </dt>
              <dd>{l.text}</dd>
            </div>
          ))
        }
      </dl>
      <div class="prose">
        <p>
          A fifth level, run here, is empty: nothing in any example has been built or tested by this site. Vendor rows
          are drawn from the linked documentation. The date on each page is when those sources were read, and passing
          it does not make a claim false.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .ex-index {
    padding-block: 1.6rem 3.5rem;
  }
  .ex-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--fg);
  }
  .ex-list > li {
    padding: 1.1rem 0 1.2rem;
    border-bottom: 1px solid var(--border);
    margin: 0;
  }
  .ex-list h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    letter-spacing: 0;
    margin: 0 0 0.2rem;
  }
  .ex-list p {
    margin: 0;
    max-width: var(--prose);
  }
  .ex-list dl {
    margin: 0.7rem 0 0;
  }
  .ex-list dl > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.1rem 0.8rem;
    padding: 0.15rem 0;
  }
  .ex-list dt {
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 0.3rem;
  }
  .ex-list dd {
    margin: 0;
    max-width: 38rem;
  }
  .ex-list dd ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .ex-list dd li {
    margin: 0 0 0.15rem;
  }
  @media (max-width: 40rem) {
    .ex-list dl > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .ex-index section {
    margin-top: 2.6rem;
  }
  .ex-levels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1rem 0 1.2rem;
  }
  .ex-levels > div {
    border-top: 3px solid var(--fg);
    padding-top: 0.55rem;
  }
  .ex-levels dd {
    margin: 0.4rem 0 0;
    font-size: 0.94rem;
    color: var(--fg-muted);
  }
  @media (max-width: 56rem) {
    .ex-levels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 26rem) {
    .ex-levels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
