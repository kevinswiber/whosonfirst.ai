---
/**
 * The full version of the home page demonstration: both credentials side by
 * side, all four checks and the complete explanation of each verdict, then how
 * the API verifies each credential, what a valid credential still does not
 * prove, and what refusing and revoking take. Static, so it reads the same
 * with or without scripts.
 */
import {
  checks,
  credentials,
  exampleToken,
  notProven,
  stopAspects,
  VERDICT_LABEL,
} from "../data/verify";
import { inline } from "../lib/md";
---

<div class="vd">
  <div class="table-scroll" tabindex="0" role="region" aria-label="What the API can verify, by credential">
    <table>
      <thead>
        <tr>
          <th scope="col">What the API can verify</th>
          {credentials.map((c) => <th scope="col">The agent presents: {c.name[0].toLowerCase() + c.name.slice(1)}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          checks.map((q) => (
            <tr>
              <th scope="row">
                <span class="vd-clause">{q.clause}</span>{' '}
                {q.question}
              </th>
              {credentials.map((c) => {
                const r = c.results[q.id];
                return (
                  <td>
                    <span class={`vd-mark is-${r.verdict}`}>{VERDICT_LABEL[r.verdict]}</span>{' '}
                    <span set:html={inline(r.detail)} />
                  </td>
                );
              })}
            </tr>
          ))
        }
        <tr class="vd-sum">
          <th scope="row">So the API can</th>
          {
            credentials.map((c) => (
              <td>
                {c.consequence}{' '}
                <a href={c.flow.href}>{c.flow.text}</a>
              </td>
            ))
          }
        </tr>
      </tbody>
    </table>
  </div>
  <div class="vd-more">
    <div>
      <h3>How the API verifies</h3>
      <dl>
        {
          credentials.map((c) => (
            <div>
              <dt>{c.onWire}</dt>
              <dd>{c.how}</dd>
            </div>
          ))
        }
      </dl>
      <p>Every verdict in the table assumes this has been done. An unvalidated token proves nothing.</p>
    </div>
    <div>
      <h3>About the example token</h3>
      {exampleToken.map((line) => <p class="vd-line" set:html={inline(line)} />)}
    </div>
    <div>
      <h3>What a valid credential does not prove</h3>
      <ul>
        {
          notProven.map((n) => (
            <li>
              <strong>{n.claim}.</strong> <span set:html={inline(n.why)} />
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>Refusing and revoking</h3>
      <dl>
        {
          stopAspects.map((a) => (
            <div>
              <dt>{a.title}</dt>
              {credentials.map((c) => (
                <dd>
                  <span class="vd-which">{c.onWire}:</span> <span set:html={inline(c.stop[a.key])} />
                </dd>
              ))}
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>

<style>
  table {
    min-width: 42rem;
  }
  thead th {
    white-space: normal;
  }
  tbody th {
    font-family: var(--font-body);
    font-size: inherit;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    white-space: normal;
    border-bottom: 1px solid var(--border);
    width: 26%;
  }
  .vd-clause {
    display: block;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 0.15rem;
  }
  td {
    width: 37%;
  }
  .vd-mark {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-bottom: 0.15rem;
    font-family: var(--font-label);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .vd-mark::before {
    content: '';
    width: 0.7em;
    height: 0.7em;
    flex: none;
    border-radius: 50%;
  }
  .is-yes {
    color: var(--green);
  }
  .is-yes::before {
    background: currentColor;
  }
  .is-no {
    color: var(--red);
  }
  .is-no::before {
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .is-conditional {
    color: var(--amber);
  }
  .is-conditional::before {
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .vd-sum :is(th, td) {
    background: var(--bg-sunken);
  }
  /* three short answers the table cannot hold */
  .vd-more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.4rem 2.5rem;
    margin-top: 0.6rem;
  }
  .vd-more h3 {
    margin: 0 0 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--fg);
    font-size: 1.05rem;
  }
  .vd-more dl {
    margin: 0;
  }
  .vd-more dt {
    font-weight: 600;
  }
  .vd-more dd {
    margin: 0 0 0.7rem;
  }
  .vd-more ul {
    margin: 0;
    padding-left: 1.1em;
  }
  .vd-more li {
    margin-bottom: 0.55rem;
  }
  .vd-more p {
    margin: 0;
    color: var(--fg-muted);
  }
  .vd-more .vd-line {
    margin: 0 0 0.6rem;
    color: var(--fg);
  }
  .vd-more dd + dd {
    margin-top: -0.3rem;
  }
  .vd-which {
    font-weight: 500;
    color: var(--fg-muted);
  }
  .vd-more :is(dd, li, p) {
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
