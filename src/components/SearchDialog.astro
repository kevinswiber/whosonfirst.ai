---
import GuideSearch from "./GuideSearch.astro";
---

<dialog id="global-search" class="search-dialog" aria-labelledby="global-search-title" aria-describedby="search-keys">
  <div class="dialog-content">
    <div class="dialog-head">
      <h2 id="global-search-title">Search the guide</h2>
      <button class="dialog-close" type="button" aria-label="Close search">Close</button>
    </div>
    <GuideSearch idPrefix="modal-" />
  </div>
  <p id="search-keys" class="search-keys">
    <span><span class="visually-hidden">Up and down arrows</span><kbd aria-hidden="true">↑</kbd><kbd aria-hidden="true">↓</kbd> Navigate</span>
    <span><kbd>Enter</kbd> Select</span>
    <span><kbd>Esc</kbd> Close</span>
  </p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#global-search');
  const launcher = document.querySelector<HTMLAnchorElement>('[data-search-launch]');
  if (dialog && launcher && typeof dialog.showModal === 'function') {
    const input = dialog.querySelector<HTMLInputElement>('input[name="q"]')!;
    const search = dialog.querySelector('guide-search')!;
    const hint = launcher.querySelector<HTMLElement>('.launch-key')!;
    hint.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? ' ⌘ K' : ' Ctrl K';
    hint.hidden = false;
    launcher.setAttribute('aria-keyshortcuts', 'Control+K Meta+K');
    let returnTo: HTMLElement = launcher;
    const openSearch = (from: HTMLElement) => {
      if (!dialog.open) {
        returnTo = from;
        dialog.showModal();
      }
      input.focus();
    };
    for (const link of [launcher, ...document.querySelectorAll<HTMLAnchorElement>('[data-search-directory]')]) {
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', dialog.id);
      link.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
        event.preventDefault();
        openSearch(link);
      });
    }
    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.isComposing || event.altKey || event.shiftKey) return;
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openSearch(document.activeElement instanceof HTMLElement && document.activeElement !== document.body
          ? document.activeElement : launcher);
      }
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      if (event.defaultPrevented || event.isComposing || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const items = [...search.querySelectorAll<HTMLElement>('.quick-matches a[href], .search-results a[href], .search-examples button')]
        .filter((element) => element.getClientRects().length);
      const current = items.findIndex((element) => element === document.activeElement);
      if (!items.length || (current < 0 && document.activeElement !== input)) return;
      if (current < 0 && event.key === 'ArrowUp') return;
      event.preventDefault();
      if (current === 0 && event.key === 'ArrowUp') input.focus();
      else items[current + (event.key === 'ArrowDown' ? 1 : -1)]?.focus();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || event.defaultPrevented) return;
      const controls = [...dialog.querySelectorAll<HTMLElement>('a[href], button:not(:disabled), input:not(:disabled), [tabindex="0"]')]
        .filter((element) => element.getClientRects().length);
      const first = controls[0], last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
    // The native close event is queued for a later frame. Cancel timers and
    // requests in the same action that closes the dialog, before a new search
    // can open or a pending query can fire.
    const closeSearch = (restoreFocus = true) => {
      dialog.close();
      search.dispatchEvent(new Event('guide-search-reset'));
      if (restoreFocus) (returnTo.isConnected ? returnTo : launcher).focus({ preventScroll: true });
    };
    // Some browsers clear a focused search input on Escape before firing
    // the dialog's cancel event. Close on the first press in either case.
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || event.defaultPrevented || event.isComposing ||
          event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      closeSearch();
    });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeSearch();
    });
    dialog.querySelector('.dialog-close')!.addEventListener('click', () => closeSearch());
    dialog.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || event.defaultPrevented) return;
      if (event.target === dialog) {
        closeSearch();
        return;
      }
      const link = event.target.closest<HTMLAnchorElement>('a[href]');
      if (link && !event.button && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
        // Reset removes the result links. Keep the chosen href so fragment
        // navigation also works when the result is on this very page.
        const href = link.href;
        event.preventDefault();
        closeSearch(false);
        location.assign(href);
      }
    });
  }
</script>

<style>
  .search-dialog {
    box-sizing: border-box;
    width: min(45rem, calc(100% - 2rem));
    max-width: none;
    max-height: min(80dvh, 52rem);
    margin: clamp(1rem, 8dvh, 6rem) auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    overflow: hidden;
  }
  .search-dialog::backdrop { background: rgb(14 15 17 / 55%); }
  :global(html:has(.search-dialog[open])) { overflow: hidden; }
  .search-dialog[open] { display: flex; flex-direction: column; }
  .dialog-content {
    padding: clamp(1rem, 3vw, 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .search-keys {
    display: flex;
    flex: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0.6rem clamp(1rem, 3vw, 2rem);
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 0.8rem;
  }
  .search-keys > span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .search-keys > span:last-child { margin-inline-start: auto; }
  .search-keys kbd {
    min-width: 1.3rem;
    padding: 0.15rem 0.25rem;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font: 500 0.72rem/1 var(--font-mono);
    text-align: center;
  }
  .dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .dialog-head h2 {
    margin: 0;
    font: 600 clamp(1.3rem, 2.5vw, 1.7rem)/1.2 var(--font-display);
    text-transform: none;
    letter-spacing: -0.03em;
  }
  .dialog-close {
    min-height: 44px;
    padding: 0 0.75rem;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font: 500 0.8rem var(--font-label);
    cursor: pointer;
  }
  @media (max-width: 38rem) {
    .search-dialog {
      width: calc(100% - 1rem);
      max-height: calc(100dvh - 1rem);
      margin-top: 0.5rem;
    }
  }
  @media print { .search-dialog { display: none; } }
</style>
