---
/**
 * "What does the last hop know?" — compares five ways of carrying authority
 * down a call chain. Every comparison stays readable; the links jump to one
 * without hiding the others.
 */
import { inline } from "../lib/md";

type Mark = "yes" | "no" | "partial";

const questions = [
  "Who is the user?",
  "What software is calling?",
  "Was this credential meant for me?",
  "Is a stolen copy useless elsewhere?",
  "Can one user or one agent be cut off?",
];

interface Mode {
  id: string;
  name: string;
  /** Credential presented on each of the three hops. */
  hops: [string, string, string];
  marks: Mark[];
  verdict: string;
  link?: { href: string; text: string };
}

const modes: Mode[] = [
  {
    id: "key",
    name: "Shared API key",
    hops: ["Session cookie", "Tool’s API key", "Tool’s API key"],
    marks: ["no", "partial", "yes", "no", "no"],
    verdict:
      "The API sees one caller: whoever holds the key. Every user and every agent run looks the same, the key works from anywhere, and revoking it cuts off everyone at once. Common, and the reason one user’s request can reach another’s data.",
  },
  {
    id: "passthrough",
    name: "Token passthrough",
    hops: ["User’s token", "Same token", "Same token"],
    marks: ["yes", "no", "no", "no", "partial"],
    verdict:
      "The user is visible, but the API is accepting a token that was issued for a different service. Every hop that touched the token can replay it wherever it is accepted. This is the confused-deputy setup, and the MCP specification prohibits it.",
  },
  {
    id: "impersonation",
    name: "Impersonation",
    hops: ["User’s token", "Exchanged: sub=user", "Exchanged: sub=user"],
    marks: ["yes", "no", "yes", "partial", "partial"],
    verdict:
      "Each hop gets a fresh token for the right audience. But the API believes the user is calling directly. Logs show Alice doing things at 3 a.m. that Alice never did, and policy cannot treat software differently from a person.",
    link: { href: "/flows/token-exchange/", text: "Token exchange" },
  },
  {
    id: "delegation",
    name: "Delegation",
    hops: ["User’s token", "sub=user, act=agent", "sub=user, act=tool→agent"],
    marks: ["yes", "yes", "yes", "partial", "yes"],
    verdict:
      "The token names both the user and the chain of software acting for them. The API can apply the user’s permissions and the agent’s limits together, and either can be revoked on its own. A stolen token is still usable until it expires, but only at this one API.",
    link: { href: "/flows/token-exchange/", text: "Token exchange" },
  },
  {
    id: "bound",
    name: "Delegation + proof of possession",
    hops: [
      "User’s token + key proof",
      "Delegated + key proof",
      "Delegated + key proof",
    ],
    marks: ["yes", "yes", "yes", "yes", "yes"],
    verdict:
      "As above, and each token is bound to a key held by the caller. A token copied alone out of a log is refused, as long as the API checks the proof and the key is kept where the model cannot read it. This is where the standards are heading; few deployments are here yet.",
    link: { href: "/flows/dpop/", text: "Sender-constrained tokens" },
  },
];

const nodes = [
  { label: "User", sub: "Alice", role: "human" },
  { label: "Agent", sub: "Orchestrator", role: "agent" },
  { label: "Tool server", sub: "Middle tier", role: "agent" },
  { label: "Downstream API", sub: "The last hop", role: "resource" },
];

const MARK_TEXT: Record<Mark, string> = {
  yes: "Yes",
  no: "No",
  partial: "Partly",
};
---

<div class="lh">
  <nav class="lh-modes" aria-label="Ways of passing authority down the chain">
    {modes.map((m) => <a href={`#lh-${m.id}`}>{m.name}</a>)}
  </nav>

  {
    modes.map((m) => (
      <section class="lh-panel" data-mode={m.id} id={`lh-${m.id}`} aria-labelledby={`lh-heading-${m.id}`}>
        <h3 id={`lh-heading-${m.id}`}>{m.name}</h3>
        <aside class="lh-chain" aria-hidden="true">
          {nodes.map((n, i) => (
            <>
              <div class={`lh-node role-${n.role}`}>
                <strong>{n.label}</strong>{' '}
                <span>{n.sub}</span>
              </div>
              {i < 3 && (
                <div class="lh-hop">
                  <span class="lh-cred">{m.hops[i]}</span>
                  <span class="lh-arrow" aria-hidden="true" />
                </div>
              )}
            </>
          ))}
        </aside>

        <h4>Credentials at each hop</h4>
        <ol class="lh-path">
          {m.hops.map((credential, i) => (
            <li>{`${nodes[i].label} (${nodes[i].sub}) to ${nodes[i + 1].label} (${nodes[i + 1].sub}): ${credential}.`}</li>
          ))}
        </ol>

        <div class="lh-result">
          <table>
            <caption>What the downstream API can tell</caption>
            <tbody>
              {questions.map((q, i) => (
                <tr>
                  <th scope="row">{q}</th>
                  <td>
                    <span class={`mark mark-${m.marks[i]}`}>{MARK_TEXT[m.marks[i]]}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="lh-verdict">
            <p set:html={inline(m.verdict)} />
            {m.link && (
              <a class="btn small" href={m.link.href}>
                {m.link.text} →
              </a>
            )}
          </div>
        </div>
      </section>
    ))
  }
</div>

<style>
  .lh {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem 1.3rem;
  }
  .lh-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }
  .lh-modes a {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.45rem 0.8rem;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--fg);
    text-decoration: none;
    transition:
      background 0.12s,
      border-color 0.12s;
  }
  .lh-modes a:hover {
    border-color: var(--fg);
  }
  .lh-modes a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lh-panel {
    display: block;
  }
  .lh-panel + .lh-panel {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-strong);
  }
  .lh-panel h3 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
  }
  .lh-panel h4 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .lh-path {
    max-width: 75ch;
    margin: 0 0 1.4rem;
    padding-left: 1.5rem;
    font-size: 1rem;
  }
  .lh-path li + li {
    margin-top: 0.3rem;
  }

  .lh-chain {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0;
    padding: 0.4rem 0 1.4rem;
  }
  .lh-node {
    border: 1.3px solid var(--role);
    background: var(--role-soft);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    text-align: center;
    min-width: 6.5rem;
  }
  .lh-node strong {
    display: block;
    font-size: 0.9rem;
    line-height: 1.2;
  }
  .lh-node span {
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .lh-hop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.3rem;
    min-width: 0;
  }
  .lh-cred {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.25;
    text-align: center;
    color: var(--fg);
    text-wrap: balance;
  }
  .lh-arrow {
    width: 100%;
    height: 1.5px;
    background: var(--fg);
    position: relative;
  }
  .lh-arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 1.5px solid var(--fg);
    border-right: 1.5px solid var(--fg);
    transform: translateY(-50%) rotate(45deg);
  }

  @media (max-width: 46rem) {
    .lh-chain {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .lh-node {
      width: min(100%, 14rem);
    }
    .lh-hop {
      flex-direction: row;
      padding: 0.5rem 0;
      gap: 0.7rem;
    }
    .lh-arrow {
      width: 1.5px;
      height: 1.6rem;
      order: -1;
    }
    .lh-arrow::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1px;
      transform: translateX(-50%) rotate(135deg);
    }
  }

  .lh-result {
    display: grid;
    gap: 1.2rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    border-top: 1px solid var(--border);
    padding-top: 1.1rem;
  }
  table {
    margin: 0;
    font-size: 0.93rem;
  }
  caption {
    text-align: left;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-bottom: 0.3rem;
  }
  tbody th {
    font-family: var(--font-body);
    font-size: 0.93rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    white-space: normal;
    border-bottom: 1px solid var(--border);
    padding-left: 0;
  }
  td {
    text-align: right;
    padding-right: 0;
    width: 5.5rem;
  }
  tr:last-child :is(th, td) {
    border-bottom: 0;
  }
  .mark {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    border: 1px solid;
    min-width: 4.2rem;
    text-align: center;
  }
  .mark-yes {
    color: var(--green);
    background: var(--green-soft);
  }
  .mark-no {
    color: var(--red);
    background: var(--red-soft);
  }
  .mark-partial {
    color: var(--amber);
    background: var(--amber-soft);
  }
  .lh-verdict p {
    margin: 0 0 0.9rem;
    font-size: 0.98rem;
  }
</style>
