---
interface Props {
  idPrefix?: string;
}
const { idPrefix = "" } = Astro.props;
const id = (name: string) => idPrefix + name;
const examples = [
  "My agent needs me to approve a payment on my phone",
  "Nobody is signed in when the overnight job runs",
  "RFC 9449",
];
---

<guide-search class:list={[{ compact: Boolean(idPrefix) }]}>
  <form id={id("guide-search-form")} role="search" aria-label="Search the whole guide" method="get" action="/search">
    <label class:list={[{ "visually-hidden": idPrefix }]} for={id("guide-query")}>{idPrefix ? "Search the guide" : "Describe a task, or enter a term or RFC number."}</label>
    <div class="search-controls">
      <div class="search-field">
        <input id={id("guide-query")} name="q" type="search" placeholder={idPrefix ? "Ask a question or find a term" : undefined} required maxlength="500" autocomplete="off" autocorrect="off" spellcheck="false" enterkeyhint="search" aria-describedby={id("search-hint")} />
        <button class="clear-query" type="button" aria-label="Clear search" title="Clear search" hidden>×</button>
      </div>
      <button class="btn primary" type="submit" aria-label="Search the whole guide">Search</button>
    </div>
    <p class="search-hint" id={id("search-hint")}>Press Enter to search.</p>
  </form>
  <section class="quick-matches" aria-labelledby={id("quick-matches-title")} hidden>
    <h2 id={id("quick-matches-title")}>Quick matches</h2>
    <p class="quick-count" aria-live="polite"></p>
    <ul></ul>
  </section>
  <section class="search-examples" aria-labelledby={id("search-examples-title")} hidden>
    <h2 id={id("search-examples-title")}>Try a search</h2>
    <ul>
      {examples.map((example) => <li><button type="button" data-query={example}>{example}<span aria-hidden="true">→</span></button></li>)}
    </ul>
  </section>
  <section class="guide-results" aria-labelledby={id("guide-results-title")}>
    <h2 id={id("guide-results-title")}>Guide results</h2>
    <p role="status" aria-live="polite"><span id={id("search-status-text")}></span></p>
    <button class="btn retry-query" type="button" hidden>Try again</button>
    <ol class="search-results" id={id("search-results")}></ol>
  </section>
</guide-search>

<script>
  import type { SearchResult } from "../search/search.ts";
  import { quickMatches } from "../lib/quick-matches.mjs";

  type QuickRecord = { href: string; type: string; title: string; summary: string; aliases: string[] };

  let catalog: Promise<QuickRecord[]> | undefined;
  function loadCatalog() {
    catalog ??= fetch('/search/quick-matches.json').then((response) => {
      if (!response.ok) throw new Error('Quick matches unavailable');
      return response.json();
    });
    return catalog;
  }

  const searchableLength = (text: string) => text.match(/[\p{L}\p{N}]/gu)?.length ?? 0;

  function siteUrl(href: string) {
    if (!href.startsWith('/')) return;
    const url = new URL(href, location.origin);
    return url.origin === location.origin ? url.href : undefined;
  }

  function guideRow(passage: SearchResult) {
    const href = siteUrl(passage.href);
    if (!href) return;
    const row = document.createElement('li');
    const kind = document.createElement('p');
    kind.className = 'result-kind';
    kind.textContent = passage.type;
    const heading = document.createElement('h3');
    const link = document.createElement('a');
    link.href = href;
    link.textContent = passage.title;
    heading.append(link);
    row.append(kind, heading);
    if (passage.section && passage.section !== passage.title) {
      link.setAttribute('aria-label', `${passage.title}, ${passage.section}`);
      const section = document.createElement('p');
      section.className = 'result-section';
      section.textContent = passage.section;
      row.append(section);
    }
    const excerpt = document.createElement('p');
    excerpt.textContent = passage.excerpt;
    row.append(excerpt);
    return row;
  }

  class GuideSearch extends HTMLElement {
    connectedCallback() {
      this.setAttribute('data-live', '');
      const form = this.querySelector('form')!;
      const input = form.querySelector('input')!;
      const clear = form.querySelector<HTMLButtonElement>('.clear-query')!;
      clear.hidden = !input.value;
      const hint = this.querySelector<HTMLElement>('.search-hint')!;
      const status = this.querySelector<HTMLElement>('[role="status"] span')!;
      const retry = this.querySelector<HTMLButtonElement>('.retry-query')!;
      const results = this.querySelector<HTMLOListElement>('.search-results')!;
      const examples = this.querySelector<HTMLElement>('.search-examples')!;
      const quick = this.querySelector<HTMLElement>('.quick-matches')!;
      const quickList = quick.querySelector('ul')!;
      const quickCount = quick.querySelector<HTMLElement>('.quick-count')!;
      const cache = new Map<string, SearchResult[]>();
      let revision = 0;
      let draft = results.hasAttribute('data-search-submitted') ? input.value.trim().toLowerCase().replace(/\s+/g, ' ') : '';
      let composing = false;
      let timer: number | undefined;
      let pending: AbortController | undefined;
      let retryAfter = 0;
      // Set when the day's budget is spent. Search answers again at midnight UTC.
      let spentUntil = 0;
      const spent = 'Search has answered all it can for today. Browse the guide, or try again tomorrow.';
      const until = (delay: string | null, fallback: number) => {
        const time = delay && /^\d+$/.test(delay) ? Date.now() + Number(delay) * 1000 : Date.parse(delay ?? '');
        return Number.isFinite(time) ? time : Date.now() + fallback;
      };

      hint.textContent = 'Results update as you type. Press Enter to search immediately.';
      examples.hidden = results.hasAttribute('data-search-submitted');

      const clearResults = () => {
        revision++;
        window.clearTimeout(timer);
        pending?.abort();
        pending = undefined;
        status.textContent = '';
        retry.hidden = true;
        results.replaceChildren();
        results.removeAttribute('aria-busy');
        results.removeAttribute('data-search-submitted');
        quick.hidden = true;
        quickList.replaceChildren();
        quickCount.textContent = '';
        examples.hidden = Boolean(input.value.trim());
      };

      // Leave quick links in place while the reader is choosing one.
      const groupQuickLinks = () => {
        if (!quick.hidden && (quick.contains(document.activeElement) || quick.matches(':hover'))) return;
        const guideLinks = new Set([...results.querySelectorAll('a')].map((a) => a.href));
        let count = 0;
        for (const row of quickList.children) {
          const link = row.querySelector('a')!;
          const duplicate = guideLinks.has(link.href);
          (row as HTMLElement).hidden = duplicate;
          if (!duplicate) count++;
        }
        // A longer question is waiting for guide results. An empty local
        // list would announce a miss just before those results arrive.
        quick.hidden = count === 0 && (searchableLength(draft) >= 3 || results.children.length > 0);
        quickCount.textContent = count ? `${count} quick ${count === 1 ? 'match' : 'matches'}.` : 'No quick matches.';
      };
      // Results that arrived while the reader was choosing are grouped once
      // they move away, so a quick link the results repeat is not left twice.
      quick.addEventListener('pointerleave', groupQuickLinks);
      quick.addEventListener('focusout', (event) => {
        if (!quick.contains(event.relatedTarget as Node | null)) groupQuickLinks();
      });

      const showQuick = async (query: string, version: number) => {
        try {
          const records = await loadCatalog();
          if (revision !== version) return;
          const rows = document.createDocumentFragment();
          const limit = this.classList.contains('compact') ? 3 : 5;
          for (const record of quickMatches(records, query).slice(0, limit)) {
            const href = siteUrl(record.href);
            if (!href) continue;
            const row = document.createElement('li');
            const link = document.createElement('a');
            link.href = href;
            link.textContent = record.title;
            const kind = document.createElement('span');
            kind.className = 'quick-type';
            kind.textContent = record.type;
            const description = document.createElement('p');
            description.textContent = record.summary;
            row.append(link, kind, description);
            rows.append(row);
          }
          quickList.replaceChildren(rows);
          groupQuickLinks();
        } catch {
          if (revision !== version) return;
          quick.hidden = results.children.length > 0;
          quickCount.textContent = 'Quick matches are unavailable.';
        }
      };

      const render = (passages: SearchResult[], query: string) => {
        const rows = document.createDocumentFragment();
        for (const passage of passages) {
          const row = guideRow(passage);
          if (row) rows.append(row);
        }
        const count = rows.childElementCount;
        results.replaceChildren(rows);
        if (quickList.children.length) groupQuickLinks();
        else if (count > 0) quick.hidden = true;
        status.textContent = count === 0 ? 'No results found. Try a shorter phrase.'
          : `${count} ${count === 1 ? 'result' : 'results'} for “${query}”.`;
      };

      const search = async () => {
        const query = input.value.trim();
        const key = draft;
        retry.hidden = true;
        const cached = cache.get(key);
        if (cached) {
          render(cached, query);
          return;
        }
        if (pending) return;
        if (Date.now() < spentUntil) {
          status.textContent = spent;
          return;
        }
        if (Date.now() < retryAfter) {
          const seconds = Math.ceil((retryAfter - Date.now()) / 1000);
          status.textContent = `Too many searches. Try again in ${seconds} ${seconds === 1 ? 'second' : 'seconds'}.`;
          return;
        }

        const request = new AbortController();
        pending = request;
        results.setAttribute('aria-busy', 'true');
        status.textContent = 'Searching…';
        const deadline = window.setTimeout(() => request.abort(), 12000);
        try {
          // The one address the Worker answers for this question, as
          // plainQuestion() and searchAddress() in src/search/search.ts
          // make it, so a cached answer is found without a redirect.
          const plain = query.normalize('NFKC').trim().replace(/\s+/g, ' ');
          const address = `/search?${new URLSearchParams({ q: plain, format: 'json' })}`;
          const response = await fetch(address, {
            headers: { Accept: 'application/json' },
            signal: request.signal,
          });
          if (pending !== request) return;
          if (response.status === 429) {
            retryAfter = until(response.headers.get('Retry-After'), 60000);
            const seconds = Math.max(1, Math.ceil((retryAfter - Date.now()) / 1000));
            status.textContent = `Too many searches. Try again in ${seconds} ${seconds === 1 ? 'second' : 'seconds'}.`;
            return;
          }
          // Only the spent budget sends a 503 with a time to come back.
          if (response.status === 503 && response.headers.has('Retry-After')) {
            spentUntil = until(response.headers.get('Retry-After'), 3600000);
            status.textContent = spent;
            return;
          }
          if (response.status === 504) {
            status.textContent = 'Guide results took too long to load.';
            retry.hidden = false;
            return;
          }
          if (!response.ok) throw new Error('Search unavailable');
          const payload = await response.json() as { results: SearchResult[] };
          if (pending !== request) return;
          render(payload.results, query);
          if (cache.size >= 16) cache.delete(cache.keys().next().value!);
          cache.set(key, payload.results);
        } catch {
          if (pending !== request) return;
          status.textContent = request.signal.aborted
            ? 'Guide results took too long to load.'
            : 'Guide results are temporarily unavailable.';
          retry.hidden = false;
        } finally {
          window.clearTimeout(deadline);
          if (pending === request) {
            pending = undefined;
            results.removeAttribute('aria-busy');
          }
        }
      };

      const update = (immediate: boolean, withQuick = true) => {
        clear.hidden = !input.value;
        if (composing) return;
        input.setCustomValidity('');
        const query = input.value.trim();
        const key = query.toLowerCase().replace(/\s+/g, ' ');
        const length = searchableLength(query);
        if (key !== draft) {
          clearResults();
          draft = key;
          if (withQuick && length >= 2) void showQuick(query, revision);
        } else if (!immediate) return;
        window.clearTimeout(timer);
        if (immediate && !length) {
          input.setCustomValidity('Enter a question, a term or an RFC number.');
          input.reportValidity();
          return;
        }
        if (immediate || (length >= 3 && cache.has(key))) void search();
        else if (length >= 3) timer = window.setTimeout(search, 450);
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        update(true);
      });
      retry.addEventListener('click', () => {
        input.focus();
        form.requestSubmit();
      });
      input.addEventListener('input', () => update(false));
      input.addEventListener('compositionstart', () => {
        composing = true;
        draft = '';
        clearResults();
      });
      input.addEventListener('compositionend', () => {
        composing = false;
        update(false);
      });
      examples.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button[data-query]');
        if (!button) return;
        input.value = button.dataset.query!;
        input.focus();
        update(true, false);
      });
      const reset = () => {
        input.value = '';
        clear.hidden = true;
        input.setCustomValidity('');
        composing = false;
        draft = '';
        clearResults();
      };
      clear.addEventListener('click', () => {
        reset();
        input.focus();
      });
      this.addEventListener('guide-search-reset', () => {
        reset();
        cache.clear();
      });
    }
  }
  customElements.define('guide-search', GuideSearch);
</script>

<style>
  guide-search { display: block; }
  .retry-query { margin-top: 0.5rem; }
  .retry-query[hidden] { display: none; }
  .compact[data-live] .search-controls > button { display: none; }
  label { display: block; margin-bottom: 0.55rem; }
  .search-controls { display: flex; gap: 0.5rem; align-items: stretch; }
  .search-field { position: relative; flex: 1; min-width: 0; }
  input {
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font: inherit;
    background: var(--bg-raised);
    color: var(--fg);
  }
  .search-field:has(.clear-query:not([hidden])) input { padding-inline-end: 3rem; }
  .search-field:has(.clear-query:not([hidden])) input::-webkit-search-cancel-button { display: none; }
  .clear-query {
    position: absolute;
    inset-inline-end: 0.15rem;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 1.4rem;
    cursor: pointer;
  }
  .search-hint { font-size: 0.84rem; color: var(--fg-muted); margin-top: 0.5rem; }
  [role='status'] { margin: 0.35rem 0; }
  .guide-results > h2 { font-size: 1.1rem; text-transform: none; margin: 1.2rem 0 0; }
  .guide-results:not(:has([data-search-submitted], [role='status'] span:not(:empty))) > h2 { display: none; }
  .guide-results [role='status']:has(span:empty) { margin: 0; }
  .compact .quick-matches :global(li p) { display: none; }
  .compact .quick-matches, .compact .search-examples { margin-top: 1rem; }
  .compact .quick-matches :global(li) { padding-block: 0.45rem; }
  .compact .search-results :global(li) { padding-block: 0.65rem; }
  /* Stretch the existing title link across its row. A click on the excerpt
     or the whitespace then follows the same link as Enter or a context menu. */
  .compact :is(.quick-matches, .search-results) :global(li) {
    position: relative;
    padding-inline: 0.65rem;
  }
  .compact :is(.quick-matches, .search-results) :global(a::after) {
    content: '';
    position: absolute;
    inset: 0;
  }
  .compact .search-examples button { padding-inline: 0.65rem; }
  .compact :global(li:has(:focus-visible)) {
    background: var(--accent-soft);
    border-radius: var(--radius);
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .compact :global(li :focus-visible) { outline: none; }
  @media (hover: hover) {
    .compact :global(li:hover) {
      background: var(--accent-soft);
      border-radius: var(--radius);
      outline: 1px solid var(--accent);
      outline-offset: -1px;
    }
  }
  .quick-matches, .search-examples { border-top: 1px solid var(--fg); padding-top: 0.8rem; margin-top: 2rem; }
  .quick-matches h2, .search-examples h2 { margin: 0; font-size: 0.95rem; text-transform: none; }
  .quick-matches ul, .search-examples ul { list-style: none; padding: 0; margin: 0.4rem 0 0; }
  .quick-matches :global(li) {
    border-bottom: 1px solid var(--border);
    margin: 0;
    padding: 0.65rem 0;
    overflow-wrap: anywhere;
  }
  .quick-matches :global(li a) { font-weight: 600; }
  .quick-matches :global(.quick-type) {
    color: var(--fg-muted);
    font: 500 0.78rem var(--font-label);
    margin-inline-start: 0.6rem;
  }
  .quick-matches :global(li p), .quick-count { font-size: 0.92rem; margin: 0.2rem 0 0; }
  @media (max-width: 36rem) {
    .search-controls { flex-direction: column; align-items: stretch; }
  }
  .search-examples li { margin: 0; border-bottom: 1px solid var(--border); }
  .search-examples button {
    width: 100%;
    min-height: 44px;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
    text-align: left;
    background: transparent;
    color: var(--accent);
    border: 0;
    padding: 0.8rem 0;
    font: inherit;
    cursor: pointer;
  }
  .search-examples button:hover { text-decoration: underline; }
  .search-results { list-style: none; padding: 0; margin: 0; }
  .search-results :global(li) { border-top: 1px solid var(--border); padding: 1.1rem 0; margin: 0; }
  .search-results :global(:is(h2, h3)) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    text-transform: none;
    margin: 0.15rem 0 0.35rem;
    overflow-wrap: anywhere;
  }
  .search-results :global(p) { margin: 0; overflow-wrap: anywhere; }
  .search-results :global(.result-kind) { color: var(--fg-muted); font: 500 0.76rem var(--font-label); }
  .search-results :global(.result-section) { font-weight: 600; margin-bottom: 0.2rem; }
</style>
