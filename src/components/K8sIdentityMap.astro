        lx: 556,
        ly: 122,
        anchor: "middle",
      },
      {
        pts: [
          [780, 50],
          [780, 32],
          [165, 32],
          [165, 50],
        ],
        label: "fetch issuer keys",
        lx: 472,
        ly: 27,
        anchor: "middle",
        dashed: true,
      },
      {
        pts: [
          [333, 274],
          [333, 360],
          [650, 360],
          [650, 441],
