---
/**
 * An agent pod and the identity layers available to it on Kubernetes.
 * Choose a layer to see which components take part and what flows where.
 * Every layer’s explanation stays visible; the script highlights the drawing.
 */
import { inline } from "../lib/md";
import { flow } from "../data/flows";

type Role = "agent" | "authz" | "resource" | "infra";
interface Node {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  sub?: string;
  role: Role;
}

