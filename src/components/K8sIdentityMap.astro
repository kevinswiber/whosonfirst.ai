    nodes: ["kubelet", "signer", "vol", "spire", "agent", "gw"],
    edges: [
      {
        pts: [
          [150, 180],
          [150, 128],
          [473, 128],
          [473, 112],
        ],
        label: "PodCertificateRequest",
        lx: 312,
        ly: 122,
        anchor: "middle",
        both: true,
