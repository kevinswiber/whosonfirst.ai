const d = (pts: [number, number][]) =>
  pts.map(([x, y], i) => `${i ? "L" : "M"}${x} ${y}`).join(" ");
function head(a: [number, number], b: [number, number]) {
  // arrowhead at b, pointing along a→b
  const dx = Math.sign(b[0] - a[0]);
  const dy = Math.sign(b[1] - a[1]);
  const [x, y] = b;
  const L = 8;
  const W = 4.2;
  return dx !== 0
    ? `${x},${y} ${x - dx * L},${y - W} ${x - dx * L},${y + W}`
    : `${x},${y} ${x - W},${y - dy * L} ${x + W},${y - dy * L}`;
}
---

<k8s-map class="km">
  <div class="km-tabs" role="group" aria-label="Highlight an identity layer">
    {
      layers.map((l, i) => (
        <button
          type="button"
          class={`tone-${l.tone}`}
          id={`km-tab-${l.id}`}
          aria-controls={`km-panel-${l.id}`}
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-layer={l.id}
        >
          <span class="n">{i + 1}</span>
          {l.name}
        </button>
      ))
    }
  </div>

  <div class="km-body">
    <div class="km-canvas" tabindex="0" role="region" aria-label="Kubernetes identity layers diagram">
      <svg
        viewBox="0 0 900 540"
        role="img"
        aria-label="Diagram of an agent pod on a Kubernetes node, with the API server and a certificate signer in the cluster, a gateway on the node, and a cloud token service, authorization server, tools and model provider outside. The selected layer’s description follows."
      >
        <rect class="km-zone" x="16" y="16" width="620" height="488" rx="8"></rect>
        <text class="km-zone-label" x="30" y="498">KUBERNETES CLUSTER</text>
        <rect class="km-zone inner" x="40" y="142" width="576" height="322" rx="6"></rect>
        <text class="km-zone-label" x="52" y="456">NODE</text>
        <rect class="km-zone pod" x="240" y="170" width="356" height="124" rx="6"></rect>
        <text class="km-zone-label" x="586" y="188" text-anchor="end">AGENT POD · SA: RESEARCH-AGENT</text>

        {
          nodes.map((n) => (
            <g class={`km-node role-${n.role}`} data-node={n.id}>
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="4" />
              <text class="km-label" x={n.x + n.w / 2} y={n.y + (n.sub ? n.h / 2 - 3 : n.h / 2 + 5)} text-anchor="middle">
                {n.label}
              </text>
              {n.sub && (
                <text class="km-sub" x={n.x + n.w / 2} y={n.y + n.h / 2 + 14} text-anchor="middle">
                  {n.sub}
                </text>
              )}
            </g>
          ))
        }

        {
          layers.map((l, i) => (
            <g class:list={['km-layer', `tone-${l.tone}`, { 'is-off': i !== 0 }]} data-layer={l.id} data-nodes={l.nodes.join(' ')}>
              {l.edges.map((e) => (
                <>
                  <path class:list={['km-edge', { dashed: e.dashed }]} d={d(e.pts)} />
                  <polygon class="km-head" points={head(e.pts[e.pts.length - 2], e.pts[e.pts.length - 1])} />
                  {e.both && <polygon class="km-head" points={head(e.pts[1], e.pts[0])} />}
                  {e.label && (
                    <text class="km-edge-label" x={e.lx} y={e.ly} text-anchor={e.anchor ?? 'middle'}>
                      {e.label}
                    </text>
                  )}
                </>
              ))}
            </g>
          ))
        }
      </svg>
    </div>

    <div class="km-panels">
      {
        layers.map((l, i) => (
          <section
            class={`km-panel tone-${l.tone}`}
            id={`km-panel-${l.id}`}
            aria-labelledby={`km-heading-${l.id}`}
            data-layer={l.id}
          >
            <p class="km-kicker">
              Layer {i + 1} · {l.name}
            </p>
            <h3 id={`km-heading-${l.id}`}>{l.question}</h3>
            <p set:html={inline(l.body)} />
            <dl>
              <div>
                <dt>Good for</dt>
                <dd set:html={inline(l.goodFor)} />
              </div>
              <div>
                <dt>Limit</dt>
                <dd set:html={inline(l.limit)} />
              </div>
            </dl>
            <p class="km-flows">
              {l.flows.map((slug) => (
                <a class="chip" href={`/flows/${slug}/`}>
                  {flow(slug).short} →
                </a>
              ))}
            </p>
          </section>
        ))
      }
    </div>
  </div>
</k8s-map>

<script>
  class K8sMap extends HTMLElement {
    connectedCallback() {
      this.dataset.js = '';
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('.km-tabs button')];
      const select = (id: string, focus = false) => {
        tabs.forEach((t) => {
          const on = t.dataset.layer === id;
          t.setAttribute('aria-pressed', String(on));
          if (on && focus) t.focus();
        });
        let active: string[] = [];
        this.querySelectorAll<SVGGElement>('.km-layer').forEach((g) => {
          const on = g.dataset.layer === id;
          g.classList.toggle('is-off', !on);
          if (on) active = (g.dataset.nodes ?? '').split(' ');
        });
        this.querySelectorAll<SVGGElement>('.km-node').forEach((n) => {
          n.classList.toggle('is-on', active.includes(n.dataset.node ?? ''));
        });
        // Highlight the drawing; keep every layer’s explanation readable.
        this.querySelectorAll<HTMLElement>('.km-panel').forEach((p) => p.classList.toggle('is-current', p.dataset.layer === id));
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t.dataset.layer!));
        t.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          select(tabs[(i + step + tabs.length) % tabs.length].dataset.layer!, true);
        });
      });
      select(tabs[0].dataset.layer!);
    }
  }
  customElements.define('k8s-map', K8sMap);
</script>

<style>
  .km {
    display: block;
  }
  .km-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .km:not([data-js]) .km-tabs {
    display: none;
  }
  .km-tabs button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0.85rem 0.4rem 0.4rem;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--bg-raised);
    color: var(--fg);
    cursor: pointer;
  }
  .km-tabs .n {
    display: grid;
    place-items: center;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: var(--radius-round);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: var(--tone);
    color: var(--bg-raised);
  }
  .km-tabs button:hover {
    border-color: var(--tone);
  }
  .km-tabs button[aria-pressed='true'] {
    border-color: var(--tone);
    background: color-mix(in srgb, var(--tone) 14%, var(--bg-raised));
    box-shadow: inset 0 0 0 1px var(--tone);
  }

  .tone-amber {
    --tone: var(--amber);
  }
  .tone-violet {
    --tone: var(--violet);
  }
  .tone-green {
    --tone: var(--green);
  }
  .tone-blue {
    --tone: var(--blue);
  }
  .tone-red {
    --tone: var(--red);
  }

  .km-body {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: minmax(0, 1fr);
  }
  .km-canvas {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem;
    overflow-x: auto;
  }
  .km-canvas svg {
    display: block;
    width: 100%;
    min-width: 40rem;
    height: auto;
    font-family: var(--font-body);
  }
  .km-zone {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  .km-zone.inner {
    fill: color-mix(in srgb, var(--bg-sunken) 55%, transparent);
    stroke-dasharray: none;
    stroke: var(--border);
  }
  .km-zone.pod {
    fill: var(--bg-raised);
    stroke: var(--blue);
    stroke-dasharray: 2 3;
  }
  .km-zone-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    fill: var(--fg-subtle);
  }

  .km-node rect {
    fill: var(--role-soft);
    stroke: var(--role);
    stroke-width: 1.2;
  }
  .km-label {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--fg);
  }
  .km-sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--fg-muted);
  }
  /* Parts outside the chosen layer step back to an outline and the muted ink,
     which is held to 4.5:1 here. They are never faded with opacity. */
  .km[data-js] .km-node:not(.is-on) rect {
    fill: var(--bg-raised);
    stroke: var(--border-strong);
    stroke-dasharray: 3 3;
  }
  .km[data-js] .km-node:not(.is-on) .km-label {
    fill: var(--fg-muted);
    font-weight: 500;
  }
  .km-node.is-on rect {
    stroke-width: 2.2;
  }

  .km-layer.is-off {
    display: none;
  }
  .km-edge {
    fill: none;
    stroke: var(--tone);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .km-edge.dashed {
    stroke-dasharray: 5 4;
  }
  .km-head {
    fill: var(--tone);
  }
  .km-edge-label {
    font-size: 11.5px;
    font-weight: 500;
    fill: var(--fg);
    paint-order: stroke;
    stroke: var(--bg-raised);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .km-panel {
    border-left: 3px solid var(--tone);
    padding: 0.1rem 0 0.2rem 1.1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 2.5rem;
  }
  .km-panel > * {
    grid-column: 1;
    max-width: none;
  }
  @media (min-width: 52rem) {
    .km-panel {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
    }
    .km-panel > dl {
      grid-column: 2;
      grid-row: 1 / span 4;
      align-self: start;
      margin-top: 0.2rem;
    }
    .km-panel > .km-flows {
      grid-column: 1;
    }
  }
  .km-panel.is-current {
    border-color: var(--tone);
  }
  .km-panel + .km-panel {
    margin-top: 1.6rem;
  }
  .km-kicker {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tone);
    margin: 0 0 0.3rem;
  }
  .km-panel h3 {
    margin: 0 0 0.5rem;
    font-size: 1.36rem;
  }
  .km-panel p {
    font-size: 0.96rem;
  }
  .km-panel dl {
    margin: 0 0 0.9rem;
    border-top: 1px solid var(--border);
  }
  .km-panel dl > div {
    display: grid;
