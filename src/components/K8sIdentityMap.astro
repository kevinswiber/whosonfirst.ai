interface Edge {
  /** polyline points */
  pts: [number, number][];
  label?: string;
  /** label position */
  lx?: number;
  ly?: number;
  anchor?: "start" | "middle" | "end";
  both?: boolean;
  dashed?: boolean;
}

interface Layer {
  id: string;
  name: string;
  tone: string;
  question: string;
  body: string;
  goodFor: string;
  limit: string;
  nodes: string[];
  edges: Edge[];
  flows: string[];
}

const layers: Layer[] = [
