    name: "ServiceAccount token",
    tone: "amber",
    question: "Which pod is this?",
    body: "The kubelet asks the API server’s TokenRequest API for a token bound to this pod, with an audience and expiry from the pod spec, and writes it into a projected volume. It replaces the file before it expires. The API server stops accepting the token once the pod is deleted. A receiver that only checks the signature does not see that, and accepts it until it expires.",
    goodFor:
      "Calling the Kubernetes API, and as the starting credential for everything else here.",
    limit:
      "It names a ServiceAccount. Two agents that share one are indistinguishable.",
    nodes: ["api", "kubelet", "vol", "agent"],
    edges: [
      {
        pts: [
          [120, 180],
          [120, 112],
        ],
        label: "TokenRequest",
        lx: 128,
        ly: 150,
        anchor: "start",
        both: true,
