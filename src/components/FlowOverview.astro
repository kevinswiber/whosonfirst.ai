---
/**
 * A flow before its diagram: what happens, in a few plain parts, and who has to
 * do what. A protocol page mostly describes other people's work; this is where a
 * reader finds their own. Each part and each step number links into the diagram.
 */
import { phaseSpan, stepsOf } from "../data/flows";
import type { Flow } from "../data/types";
import { ROLE_PART } from "../data/types";
import type { Gloss } from "../lib/gloss";
import { inline } from "../lib/md";

interface Props {
  flow: Flow;
  /** The page's reading, so a term already marked above is not marked again here. */
  gloss?: Gloss;
}
const { flow, gloss } = Astro.props;
const phases = (flow.phases ?? []).map((p, i) => {
  const [first, last] = phaseSpan(flow, i);
  return {
    ...p,
    first,
    range: first === last ? `Step ${first}` : `Steps ${first} to ${last}`,
  };
});
// "Agent" reads as a common noun in "if you build the agent"; "MCP client" and "API" do not change
const soft = (label: string) =>
  /^[A-Z][a-z]/.test(label) ? label[0].toLowerCase() + label.slice(1) : label;
const parts = flow.participants
  .filter((p) => flow.parts?.[p.id])
  .map((p) => ({
    ...p,
    heading: ROLE_PART[p.role].replace(
      "{label}",
      ROLE_PART[p.role].startsWith("{") ? p.label : soft(p.label),
    ),
    text: flow.parts?.[p.id] ?? "",
    steps: stepsOf(flow, p.id),
  }));
---

<div class="ov">
  {
    phases.length > 0 && (
      <section aria-labelledby="in-short">
        <h2 id="in-short">In short</h2>
        <ol class="ov-phases" role="list">
          {phases.map((p, i) => (
            <li>
              <a href={`#step-${p.first}`}>
                <span class="ov-n" aria-hidden="true">{i + 1}</span>
                <span class="ov-t">{p.title}</span>
                <span class="ov-r">{p.range}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
  {
    parts.length > 0 && (
      <section aria-labelledby="who-does-what">
        <h2 id="who-does-what">Who does what</h2>
        <dl class="ov-parts">
          {parts.map((p) => (
            <div class={`role-${p.role}`}>
              <dt>{p.heading}</dt>
              <dd>
                <span set:html={inline(p.text, gloss)} />
                {p.steps.length > 0 && (
                  <span class="ov-steps">
                    {p.steps.length === 1 ? 'Step' : 'Steps'}{' '}
                    {p.steps.map((n, k) => (
                      <>
                        {k > 0 && ', '}
                        <a href={`#step-${n}`}>{n}</a>
                      </>
                    ))}
                  </span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</div>

<style>
  .ov {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .ov:has(section + section) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }
  h2 {
    margin: 0 0 0.8rem;
    font-size: 1.55rem;
  }

  /* the parts of the flow, in order: each row is a link to the step it starts at */
  .ov-phases {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--fg);
  }
  .ov-phases li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .ov-phases a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.8rem;
    padding: 0.7rem 0.3rem 0.7rem 0;
    text-decoration: none;
  }
  .ov-phases a:hover {
    background: var(--accent-soft);
  }
  .ov-n {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius-round);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }
  .ov-t {
    font-size: 1.04rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .ov-r {
    grid-column: 2;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* each party under its diagram color, with the steps it takes part in */
  .ov-parts {
    margin: 0;
    border-top: 1.5px solid var(--fg);
  }
  .ov-parts > div {
    padding: 0.7rem 0 0.75rem 0.9rem;
    border-bottom: 1px solid var(--border);
    box-shadow: inset 4px 0 0 var(--role);
  }
  .ov-parts dt {
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.15rem;
  }
  .ov-parts dd {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.5;
  }
  .ov-steps {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .ov-steps a {
    display: inline-block;
    min-width: 1.2em;
    padding: 0.1rem 0.15rem;
    color: var(--accent);
    text-align: center;
  }
  /* under a finger each number gets the room of a button */
  @media (pointer: coarse) {
    .ov-steps {
      line-height: 2.4;
    }
    .ov-steps a {
      min-width: 2.2em;
      padding: 0.55rem 0.35rem;
    }
  }
</style>
