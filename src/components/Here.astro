---
/**
 * Where the reader is: the trail to this page and the page's own short name,
 * on one line under the site header. A layout gives the base layout the trail
 * and the name, and the line stays in view with the header, so a reader halfway down a
 * long page can still see which page it is.
 *
 * It takes the place of the small label above a page's title, so the top of the
 * page is no taller for it. A script in the base layout adds the section the
 * reader has scrolled to, as a button that lists the page's sections. Without
 * the script the line is the trail and the name.
 *
 * It sits inside the site header, whose styles and script address `nav`
 * elements there, so this is a `div` with the navigation role.
 */
interface Props {
  /**
   * The way here, outermost first. An entry with no `href` is a label. On a
   * phone a label in the middle of the trail gives way to the page's name,
   * unless it has a `short` form to stand in for it.
   */
  trail?: { label: string; short?: string; href?: string }[];
  /** This page, by its short name. */
  current: string;
}
const { trail = [], current } = Astro.props;
---

<div class="here-nav" role="navigation" aria-label="You are here">
  <ol>
    {
      trail.map((t) => (
        <li class:list={{ 'has-short': !!t.short }}>
          {t.href ? (
            <a href={t.href}>{t.label}</a>
          ) : t.short ? (
            <>
              <span class="full">{t.label}</span>
              <span class="short" aria-hidden="true">
                {t.short}
              </span>
            </>
          ) : (
            t.label
          )}
        </li>
      ))
    }
    <li class="here-page" aria-current="page">{current}</li>
  </ol>
  <button class="here-sec" type="button" popovertarget="here-menu" hidden>
    <span class="visually-hidden">Sections on this page. Now in: </span>
    <span class="here-sec-name"></span>
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M2 4h12M2 8h12M2 12h8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
  </button>
  <div class="here-menu" id="here-menu" popover>
    <p>On this page</p>
    <ol></ol>
  </div>
</div>

<style>
  .here-nav {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2rem;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  ol {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
    flex: none;
  }
  li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--fg-subtle);
  }
  a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--fg);
  }
  /* the page's own name is the part that may be cut short, never the trail */
  .here-page {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--fg);
    font-weight: 600;
  }
  /* The section scrolled to, in the reading face. It is a button: pressing it lists
     the page's sections, to go to another. It is the first thing to give way. */
  .here-sec {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 1 auto;
    min-width: 0;
    min-height: 1.6rem;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg-muted);
    font-family: var(--font-body, inherit);
    font-size: 0.84rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }
  .here-sec[hidden] {
    display: none;
  }
  .here-sec:hover,
  .here-sec[aria-expanded='true'] {
    color: var(--fg);
    border-color: var(--fg);
  }
  .here-sec-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .here-sec svg {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }
  .here-menu {
    position: fixed;
    inset: auto;
    top: var(--here-menu-top, 6rem);
    left: var(--here-menu-left, 1rem);
    margin: 0;
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(70vh, 30rem);
    overflow-y: auto;
    padding: 0.7rem 0.9rem 0.8rem;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    box-shadow: 3px 3px 0 var(--border);
    font-family: var(--font-body, inherit);
    font-size: 0.94rem;
    letter-spacing: 0;
    text-transform: none;
    white-space: normal;
  }
  /* A browser without popovers would draw the closed list as an open box over
     the top of the page, with nothing to close it. There the line stays the
     trail and the name, as it is without the script. */
  @supports not selector(:popover-open) {
    .here-menu {
      display: none;
    }
  }
  .here-menu p {
    margin: 0 0 0.4rem;
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .here-menu ol {
    display: block;
  }
  .here-menu :global(li) {
    margin: 0;
  }
  .here-menu :global(li)::before {
    content: none;
  }
  .here-menu :global(a) {
    display: block;
    padding: 0.35rem 0;
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .here-menu :global(li:last-child a) {
    border-bottom: 0;
  }
  .here-menu :global(a:hover) {
    text-decoration: underline;
  }
  .here-menu :global(a[aria-current]) {
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    /* on a phone the line is for the page's name, and the button is its sign alone */
    .here-sec {
      margin-left: auto;
      flex: none;
    }
    .here-sec-name {
      display: none;
    }
    /* and a label in the middle of the trail gives way to the name, or to its short form */
    li:not(:first-child):not(.here-page):not(.has-short) {
      display: none;
    }
    .full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @media (min-width: 40.01rem) {
    .short {
      display: none;
    }
  }
  /* the list of sections is a control, and means nothing on paper */
  @media print {
    .here-sec,
    .here-menu {
      display: none !important;
    }
  }
</style>
