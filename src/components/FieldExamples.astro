---
import type { ImplementationEvidence, DeploymentEvidence } from "../data/field";
import { fieldQualification } from "../lib/field";

interface Props {
  slug: string;
  entries: (ImplementationEvidence | DeploymentEvidence)[];
  label: string;
  cards?: boolean;
  searchable?: boolean;
}

const { slug, entries, label, cards = false, searchable = false } = Astro.props;
const Entry = cards ? "a" : "div";
---

<ul class:list={["field-examples", { grid: cards, "field-example-cards": cards, "field-example-list": !cards }]} role="list" aria-label={label}>
  {entries.map((entry) => {
    const href = `/implementations/${slug}/#field-${entry.id}`;
    const name = entry.kind === "implementation" ? entry.product : entry.organization;
    const qualification = fieldQualification(entry);
    return (
      <li
        data-name={searchable ? (entry.kind === 'implementation' ? entry.product : entry.organization) : undefined}
        data-owner={searchable && entry.kind === 'implementation' ? entry.organization : undefined}
        data-role={searchable ? (entry.kind === 'implementation' ? entry.role : entry.setting) : undefined}
      >
        <Entry class={cards ? "card" : undefined} href={cards ? href : undefined}>
          {cards ? (
            <h3 class="field-example-name">{name}</h3>
          ) : (
            <div class="field-example-name"><a href={href}>{name}</a></div>
          )}{' '}
          <p class="field-example-role">
            {entry.kind === 'implementation' ? entry.role : entry.setting}
          </p>
          <p class="field-example-summary">{entry.summary}</p>
          {qualification && (
            <p class="field-example-qualification">
              {!cards && 'Note: '}{qualification}
            </p>
          )}
          {(cards || searchable) && (
            <div class:list={{ chips: cards, "field-example-kind-inline": searchable }}>
              <span class="chip field-example-kind">{entry.kind === 'implementation' ? 'Implementation' : 'Deployment report'}</span>
            </div>
          )}
        </Entry>
      </li>
    );
  })}
</ul>

<style>
  .field-examples {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    line-height: 1.45;
  }
  .field-examples li { margin: 0; }
  .field-examples li + li { margin-top: 1rem; }
  .field-example-list .field-example-name { margin: 0; font-size: 1rem; }
  .field-example-cards { margin: 0; }
  .field-example-cards li {
    display: grid;
    break-inside: avoid;
  }
  .field-example-cards li + li { margin-top: 0; }
  .field-example-kind-inline { margin-top: 0.3rem; }
  .field-example-role,
  .field-example-qualification {
    display: block;
    margin: 0.1rem 0 0;
  }
  .field-example-cards .field-example-role {
    margin: 0;
    font: 500 0.7rem/1.35 var(--font-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .field-example-summary,
  .field-example-qualification {
    max-width: 65ch;
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .field-example-summary { margin: 0.4rem 0 0; }
  .field-example-qualification { margin-top: 0.35rem; }
  .field-example-list { line-height: var(--body-leading); }
  .field-example-list .field-example-role {
    margin: 0.12rem 0 0.5rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
  }
  .field-example-list .field-example-summary {
    margin-top: 0.45rem;
    font-size: 1rem;
    line-height: inherit;
    color: var(--fg);
  }
  .field-example-list .field-example-qualification {
    margin-top: 0.45rem;
    font-size: 0.95rem;
    line-height: inherit;
  }
</style>
