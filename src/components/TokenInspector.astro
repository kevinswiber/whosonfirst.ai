---
/**
 * Annotated token examples. Each claim line is a native <details> element, so
 * the explanations work without JavaScript. Every example stays in the page;
 * the links jump to an example without hiding the others.
 */
import { tokens, CAT_LABEL, CAT_TONE } from "../data/tokens";
import type { ClaimCat } from "../data/tokens";
import { hasStd, std } from "../data/standards";
import { inline } from "../lib/md";
import { must } from "../lib/must";

interface Props {
  /** Limit to these token ids, in this order. */
  only?: string[];
}
const { only } = Astro.props;
const list = only
  ? only.map((id) =>
      must(
        tokens.find((t) => t.id === id),
        `token "${id}"`,
      ),
    )
  : tokens;
const cats = Object.keys(CAT_LABEL).filter((c) => c !== "meta") as ClaimCat[];
---

<token-inspector class="ti">
  <nav class="ti-tabs" aria-label="Token examples">
    {list.map((t) => <a href={`#ti-${t.id}`}>{t.name}</a>)}
  </nav>

  {
    list.map((t) => (
      <section class="ti-panel" id={`ti-${t.id}`} aria-labelledby={`ti-heading-${t.id}`}>
        <header>
          <h3 id={`ti-heading-${t.id}`}>{t.name}</h3>
          <p class="ti-path">{t.path}</p>
          <p set:html={inline(t.intro)} />
        </header>
        <div class="ti-code">
          {t.lines.map((l, i) =>
            l.note ? (
              <details class={`claim tone-${CAT_TONE[l.cat ?? 'meta']}`} name={`ti-${t.id}`} open={i === t.lines.findIndex((line) => line.note)}>
                <summary style={`--indent:${l.indent ?? 0}`}>
                  <code>{l.text}</code>
                </summary>
                <div class="claim-note" style={`--indent:${l.indent ?? 0}`}>
                  <span class="claim-cat">{CAT_LABEL[l.cat ?? 'meta']}</span>
                  <p set:html={inline(l.note)} />
                </div>
              </details>
            ) : (
              <div class="plain" style={`--indent:${l.indent ?? 0}`}>
                <code>{l.text}</code>
              </div>
            ),
          )}
        </div>
        <p class="ti-sources">
          {t.flow && (
            <a class="btn small" href={`/flows/${t.flow}/`}>
              See the flow →
            </a>
          )}
          <span class="chips">
            {t.standards.filter(hasStd).map((id) => (
              <a class="chip" href={`/standards/#${id}`}>
                {std(id).ref}
              </a>
            ))}
          </span>
        </p>
      </section>
    ))
  }

  <ul class="ti-legend" aria-label="Color key">
    {
      cats.map((c) => (
        <li class={`tone-${CAT_TONE[c]}`}>
          <span class="swatch" />
          {CAT_LABEL[c]}
        </li>
      ))
    }
  </ul>
</token-inspector>

<style>
  .ti {
    display: block;
    --tone: var(--fg-subtle);
  }
  .ti-tabs {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1.5px solid var(--fg);
    /* more links than fit: a shadow at the edge they run off, as on a wide table */
    background:
      linear-gradient(to right, var(--bg) 40%, transparent) left / 2.4rem 100% no-repeat local,
      linear-gradient(to left, var(--bg) 40%, transparent) right / 2.4rem 100% no-repeat local,
      linear-gradient(to right, color-mix(in srgb, var(--fg) 30%, transparent), transparent) left / 0.8rem 100%
        no-repeat scroll,
      linear-gradient(to left, color-mix(in srgb, var(--fg) 30%, transparent), transparent) right / 0.8rem 100%
        no-repeat scroll;
  }
  /* the strip clips what is drawn outside a link, so its focus ring is drawn inside */
  .ti-tabs a:focus-visible {
    outline-offset: -3px;
  }
  .ti-tabs a {
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.65rem 0.85rem;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    background: transparent;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .ti-tabs a:hover {
    color: var(--fg);
    background: var(--bg-sunken);
  }
  .ti-panel {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem 1.1rem;
    margin-bottom: 1rem;
  }
  .ti-panel header h3 {
    margin: 0 0 0.2rem;
  }
  .ti-path {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.6rem;
  }
  .ti-panel header p:last-child {
    max-width: 46rem;
    font-size: 0.97rem;
    margin-bottom: 1rem;
  }

  .ti-code {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.7rem 0;
    font-size: 0.86rem;
  }
  .ti-code code {
    font-size: 0.8rem;
    background: none;
    border: 0;
    padding: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .plain,
  .claim summary {
    padding: 0.14rem 1rem 0.14rem calc(1rem + var(--indent) * 1.3rem);
  }
  .plain code {
    color: var(--fg-subtle);
  }
  .claim summary {
    list-style: none;
    cursor: pointer;
    border-left: 3px solid var(--tone);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .claim summary::-webkit-details-marker {
    display: none;
  }
  .claim summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-subtle);
    flex: none;
  }
  .claim[open] summary::after {
    content: '–';
  }
  .claim summary:hover,
  .claim[open] summary {
    background: color-mix(in srgb, var(--tone) 12%, transparent);
  }
  .claim-note {
    border-left: 3px solid var(--tone);
    background: color-mix(in srgb, var(--tone) 7%, transparent);
    padding: 0.5rem 1rem 0.7rem calc(1rem + var(--indent) * 1.3rem);
    font-family: var(--font-body);
  }
  .claim-note p {
    margin: 0;
    font-size: 0.93rem;
    max-width: 44rem;
  }
  .claim-cat {
    display: block;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tone);
    margin-bottom: 0.2rem;
  }

  .tone-red {
    --tone: var(--red);
  }
  .tone-blue {
    --tone: var(--blue);
  }
  .tone-green {
    --tone: var(--green);
  }
  .tone-violet {
    --tone: var(--violet);
  }
  .tone-amber {
    --tone: var(--amber);
  }
  .tone-neutral {
    --tone: var(--fg-subtle);
  }

  .ti-panel .ti-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
  }
  /* a specification's name can be longer than a phone is wide */
  .ti-panel .ti-sources .chips {
    min-width: 0;
  }
  .ti-panel .ti-sources .chip {
    min-width: 0;
    line-height: 1.4;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .ti-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--fg-muted);
  }
  .ti-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
  }
  .swatch {
    width: 0.3rem;
    height: 0.95rem;
    background: var(--tone);
    border-radius: 1px;
  }
</style>
