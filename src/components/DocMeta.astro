---
/**
 * Facts about the page itself. Two are worth a reader's first glance and sit
 * on one line: the specification the page is based on, with its status and
 * revision, and when the guide was last reviewed. They are different facts
 * and are labeled as such. Everything else (the kind of document, the count
 * of sources, how it was checked) is one disclosure away.
 */
export interface MetaItem {
  label: string;
  value: string;
  href?: string;
  /** Second line, in smaller type. */
  note?: string;
  noteHref?: string;
}
interface Props {
  /** The specification, or specifications, the page says the flow implements. */
  based?: {
    /** The label, when "Based on" would claim too much: e.g. "Diagram based on". */
    key?: string;
    refs: { ref: string; href: string }[];
    status: string;
    revision?: string;
  };
  /** A leading fact for pages that follow no single specification, e.g. "83 entries". */
  lead?: string;
  reviewed: string;
  /** What the review date is a review of: "Guide" on a flow page, "Tracker" on the standards page. */
  subject?: string;
  details?: MetaItem[];
  /** The disclosure's label. */
  more?: string;
}
const {
  based,
  lead,
  reviewed,
  subject,
  details = [],
  more = "Sources and review details",
} = Astro.props;
// dates such as 2026-07-28 should not break across lines at their hyphens
const whole = (s: string) => s.replace(/(\d)-(?=\d)/g, "$1\u2011");
---

<div class="page-facts">
  <p class="doc-line">
    {
      based && (
        <span class="doc-fact">
          <span class="doc-key">{based.key ?? 'Based on'}:</span>{' '}
          {based.refs.map((r, i) => (
            <>
              {i > 0 && ' and '}
              <a href={r.href} class:list={{ nowrap: r.ref.length <= 32 }}>
                {r.ref}
              </a>
            </>
          ))}
          {' — '}<span class="doc-status">{[based.status, based.revision].filter(Boolean).join(', ')}.</span>
        </span>
      )
    }
    {' '}{lead && <span class="doc-fact">{lead}.</span>}{' '}
    <span class="doc-fact">
      <span class="doc-key">{subject ? `${subject} reviewed` : 'Reviewed'}:</span>{' '}
      {reviewed}.
    </span>
  </p>
  {
    details.length > 0 && (
      <details class="doc-details">
        <summary>{more}</summary>
        <dl>
          {details.map((it) => (
            <div>
              <dt>{it.label}</dt>
              <dd>
                {it.href ? <a href={it.href}>{it.value}</a> : it.value}
                {it.note && (
                  <span class="doc-note">{it.noteHref ? <a href={it.noteHref}>{it.note}</a> : whole(it.note)}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </details>
    )
  }
</div>
