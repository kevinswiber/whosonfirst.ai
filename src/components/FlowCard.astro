---
import type { Flow } from "../data/types";
import { HUMAN_LABEL, HUMAN_TONE } from "../data/types";
import { maturityLabel } from "../data/flows";

interface Props {
  flow: Flow;
}
const { flow: f } = Astro.props;
---

<a class="card flow-card" href={`/flows/${f.slug}/`}>
  <h3>{f.short}</h3>
  <p>{f.tagline}</p>
  <div class="chips">
    <span class="chip" data-tone={HUMAN_TONE[f.human]}>{HUMAN_LABEL[f.human]}</span>
    <span class="chip">{maturityLabel(f)}</span>
  </div>
</a>
