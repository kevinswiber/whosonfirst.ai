---
import type { Flow } from "../data/types";
import { maturityLabel } from "../data/flows";

interface Props {
  flow: Flow;
  headingLevel?: 3 | 4;
}
const { flow: f, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 4 ? "h4" : "h3";
---

<a class="card flow-card" href={`/flows/${f.slug}/`}>
  <Heading>{f.short}</Heading>
  <p>{f.tagline}</p>
  <div class="chips">
    <span class="chip">{maturityLabel(f)}</span>
  </div>
</a>
