---
import type { FlowReading } from "../data/types";
import { block, inline } from "../lib/md";
interface Props {
  brief: FlowReading["brief"];
}
const { brief } = Astro.props;
---
<section class="flow-brief" aria-labelledby="fit">
  <h2 id="fit">Does this flow fit?</h2>
  <div class="brief-columns">
    <dl class="brief-facts">
      <div><dt>Whose authority?</dt><dd set:html={block(brief.authority)} /></div>
      <div><dt>You gain</dt><dd set:html={block(brief.benefit)} /></div>
      <div><dt>You take on</dt><dd set:html={block(brief.cost)} /></div>
    </dl>
    <div class="prerequisites">
      <h3>This works if</h3>
      <ul>{brief.prerequisites.map((item) => <li set:html={inline(item)} />)}</ul>
    </div>
  </div>
  <div class="responsibility">
    <h3>Who enforces access?</h3>
    <div class="prose" set:html={block(brief.responsibilities)} />
  </div>
  {brief.alternatives.length > 0 && (
    <div class="alternatives">
      <h3>If that does not fit</h3>
      <ul>{brief.alternatives.map((item) => (
        <li><span>{item.condition}</span> <a href={item.href}>{item.label}</a></li>
      ))}</ul>
    </div>
  )}
</section>
<style>
  .flow-brief { margin-top: 1.75rem; padding-block: 1.3rem; border-block: 1px solid var(--border-strong); }
  h2 { margin: 0 0 1.1rem; font-size: 1.4rem; }
  h3, dt { font-family: var(--font-body); font-size: 1rem; font-weight: 600; margin: 0 0 0.35rem; }
  .brief-columns { display: grid; gap: 1.5rem 2.5rem; }
  .brief-facts, dd { margin: 0; }
  .brief-facts > div + div { margin-top: 1rem; }
  dd :global(p), .responsibility :global(p) { margin: 0; }
  ul { margin: 0; padding-left: 1.2rem; }
  li + li { margin-top: 0.65rem; }
  .responsibility { border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1.4rem; }
  .alternatives { margin-top: 1.2rem; }
  .alternatives li { max-width: var(--prose); }
  @media (min-width: 60rem) { .brief-columns { grid-template-columns: 1fr 1fr; } }
</style>
