---
import type { FieldProfile } from "../data/field";
import { fieldDate } from "../data/field";
import { fieldSnapshot } from "../lib/field";

interface Props {
  slug: string;
  profile?: FieldProfile;
}

const { slug, profile } = Astro.props;
const snapshot = profile && fieldSnapshot(profile);
---

<div class="field-summary" id="in-the-field" data-field-reviewed={profile ? '' : undefined}>
  <p class="field-summary-head">
    <strong><a href={profile ? `/field/${slug}/` : `/field/#${slug}`}>In the field</a></strong>
    {profile && (
      <span class="field-summary-date">Reviewed <time datetime={profile.reviewedOn}>{fieldDate(profile.reviewedOn)}</time></span>
    )}
  </p>
  {snapshot ? (
    <>
      <p class="field-summary-line">
        {snapshot.productExamples
          ? <><strong>{snapshot.optionsLabel}.</strong> {snapshot.products.length === 1 ? 'Example: ' : 'Examples: '}{snapshot.productExamples}</>
          : 'No implementation option found in reviewed sources.'}
      </p>
      <p class="field-summary-line">
        {snapshot.operator
          ? <><strong>{snapshot.operatorsLabel} in production reports.</strong> For example, {snapshot.operator}.</>
          : 'No production report found in reviewed sources.'}
      </p>
    </>
  ) : (
    <p class="field-summary-line">Field evidence for this flow has yet to be reviewed.</p>
  )}
</div>

<style>
  .field-summary {
    margin: 1rem 0 0;
    padding: 0.65rem 0 0.7rem 0.9rem;
    border-inline-start: 2px solid var(--border-strong);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .field-summary:target { border-inline-start-color: var(--accent); }
  .field-summary-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.8rem;
    margin: 0;
  }
  .field-summary-date {
    color: var(--fg-muted);
    font-size: 0.88rem;
  }
  .field-summary-line {
    margin: 0.3rem 0 0;
    color: var(--fg-muted);
  }
  .field-summary-line strong { color: var(--fg); }
</style>
