---
/**
 * Sequence diagram with a step-through panel.
 *
 * The SVG and every step's explanation are rendered at build time, so the page
 * reads fine without JavaScript (all steps listed in order). The script at the
 * bottom upgrades it to a stepper: one step at a time, with the matching arrow
 * highlighted and a snapshot of who holds which credential.
 *
 * Color means one thing here: the role of a participant. The kind of message
 * (direct call, response, through the browser, out of band) is carried by the
 * line style and named in the step. On a phone the steps read as a narrative
 * and the diagram opens on demand at full size.
 */
import { Code } from "astro:components";
import FlowDecisions from "./FlowDecisions.astro";
import type { Flow, StepKind } from "../data/types";
import { block, inline } from "../lib/md";
import { codeThemes } from "../lib/code-themes.mjs";

interface Props {
  flow: Flow;
}
const { flow } = Astro.props;
const P = flow.participants;
const steps = flow.steps;
const n = P.length;

// ---- geometry ----
// Sized so that a four-party diagram is about 660 units wide and is drawn at
// its natural size beside the step panel: labels render at 14px, not smaller.
const boxW = 150;
const boxH = 48;
const gap = n <= 3 ? 214 : n === 4 ? 162 : n === 5 ? 156 : 152;
const padX = boxW / 2 + 14;
const CHAR = 7.1; // approximate advance of the label face at 14px
const W = padX * 2 + gap * (n - 1);
const top = 8;
const y0 = top + boxH + 52;
const rowH = 64;
const LINE = 17; // line height of a two-line arrow label
const H = y0 + rowH * (steps.length - 1) + 40;
// The participant boxes are drawn in a strip of their own, so that it can stay
// in view while a long sequence scrolls beneath it.
const headH = top + boxH + 8;

const idx = (id: string) => {
  const i = P.findIndex((p) => p.id === id);
  if (i < 0) throw new Error(`[${flow.slug}] unknown participant "${id}"`);
  return i;
};
const xOf = (id: string) => padX + gap * idx(id);
const name = (id: string) => P[idx(id)].label;
const who = (id: string) => P[idx(id)];

const KIND_LABEL: Record<StepKind, string> = {
  back: "Direct call",
  front: "Via the user’s browser or device",
  resp: "Response",
  oob: "Out of band",
  self: "Local action",
};

// ---- per-step drawing data + credential snapshots ----
const held = new Map<string, string[]>(P.map((p) => [p.id, []]));

const rows = steps.map((s, i) => {
  const y = y0 + i * rowH;
  const to = s.to;
  const x1 = xOf(s.from);

  const spent = new Map<string, string[]>();
  for (const [id, what] of s.lose ?? []) {
    idx(id);
    held.set(
      id,
      (held.get(id) ?? []).filter((a) => a !== what),
    );
    spent.set(id, [...(spent.get(id) ?? []), what]);
  }
  const fresh = new Set<string>();
  for (const [id, what] of s.gain ?? []) {
    idx(id);
    const list = held.get(id) ?? [];
    if (!list.includes(what)) list.push(what);
    held.set(id, list);
    fresh.add(`${id}\u0000${what}`);
  }
  const snapshot = P.map((p) => ({
    ...p,
    items: (held.get(p.id) ?? []).map((text) => ({
      text,
      fresh: fresh.has(`${p.id}\u0000${text}`),
    })),
    spent: spent.get(p.id) ?? [],
  })).filter((p) => p.items.length > 0 || p.spent.length > 0);
  const from = who(s.from);

  // A step with no recipient, or addressed to its sender, is a local action.
  if (!to || to === s.from) {
    const w = Math.min(Math.max(118, s.label.length * CHAR + 54), W - 8);
    const nx = Math.min(Math.max(x1 - w / 2, 4), W - w - 4);
    return {
      s,
      i,
      y,
      self: true as const,
      x1,
      nx,
      w,
      snapshot,
      from,
      to: undefined,
      route: name(s.from),
    };
  }

  const x2 = xOf(to);
  const dir = x2 > x1 ? 1 : -1;
  const span = Math.abs(x2 - x1);
  // Labels that will not fit on one line are split into two balanced lines.
  const room = span - 26;
  let lines = [s.label];
  if (s.label.length * CHAR > room) {
    const words = s.label.split(" ");
    let best = lines;
    let bestLen = Infinity;
    for (let k = 1; k < words.length; k++) {
      const a = words.slice(0, k).join(" ");
      const b = words.slice(k).join(" ");
      const len = Math.max(a.length, b.length);
      if (len < bestLen) {
        bestLen = len;
        best = [a, b];
      }
    }
    lines = best;
    // a label may run past its arrow (it is clamped to the canvas below), but not by much
    if (Math.max(...lines.map((l) => l.length)) * CHAR > room + 70) {
      console.warn(
        `[${flow.slug}] step ${i + 1} label is too long for its arrow: "${s.label}"`,
      );
    }
  }
  const tip = x2 - dir * 3;
  const head = `${tip},${y} ${tip - dir * 9},${y - 4.6} ${tip - dir * 9},${y + 4.6}`;
  // a label may run a little past its arrow, but never off the canvas
  const half = (Math.max(...lines.map((l) => l.length)) * CHAR) / 2;
  const labelX = Math.min(
    Math.max((x1 + x2) / 2 + dir * 4, half + 6),
    W - half - 6,
  );
  return {
    s,
    i,
    y,
    self: false as const,
    x1,
    x2,
    dir,
    head,
    lineStart: x1 + dir * 12,
    lineEnd: tip - dir * 7,
    labelX,
    lines,
    snapshot,
    from,
    to: who(to),
    route: `${name(s.from)} → ${name(to)}`,
  };
});

const usedKinds = [...new Set(steps.map((s) => s.kind))];
---

<flow-diagram class="flow" data-count={steps.length} data-reading={flow.reading ? "" : undefined}>
  <details class="flow-stage" open>
    <summary>
      <span class="flow-stage-title">Sequence diagram</span>
      <span class="flow-stage-count">{n} participants, {steps.length} steps</span>
    </summary>
    <ul class="flow-legend" aria-label="Legend">
      {
        (['back', 'front', 'resp', 'oob', 'self'] as StepKind[])
          .filter((k) => usedKinds.includes(k))
          .map((k) => (
            <li class={`kind-${k}`}>
              <svg width="34" height="10" viewBox="0 0 34 10" aria-hidden="true">
                {k === 'self' ? (
                  <rect class="note" x="1" y="1" width="32" height="8" rx="4" />
                ) : (
                  <>
                    <line class="arrow" x1="0" y1="5" x2="26" y2="5" />
                    <polygon class="head" points="34,5 25,0.8 25,9.2" />
                  </>
                )}
              </svg>
              {KIND_LABEL[k]}
            </li>
          ))
      }
    </ul>
    <p class="flow-hint">Drag to see every party and step. Tap a step to jump to its explanation.</p>
    <div class="flow-canvas" tabindex="0" role="group" aria-label={`Sequence diagram: ${flow.title}`}>
      <div class="flow-sheet" style={`--natural: ${W}px`}>
      <svg class="flow-heads" viewBox={`0 0 ${W} ${headH}`} width={W} height={headH} aria-hidden="true">
        {
          P.map((p) => {
            const x = xOf(p.id);
            return (
              <g class={`actor role-${p.role}`} data-actor={p.id}>
                <line class="lifeline" x1={x} y1={top + boxH} x2={x} y2={headH} />
                <rect class="actor-box" x={x - boxW / 2} y={top} width={boxW} height={boxH} rx="4" />
                <text class="actor-label" x={x} y={top + (p.sub ? 21 : 29)} text-anchor="middle">
                  {p.label}
                </text>
                {p.sub && (
                  <text class="actor-sub" x={x} y={top + 37} text-anchor="middle">
                    {p.sub}
                  </text>
                )}
              </g>
            );
          })
        }
      </svg>
      <svg
        class="flow-lines"
        viewBox={`0 ${headH} ${W} ${H - headH}`}
        width={W}
        height={H - headH}
        role="img"
        aria-label={`${flow.title}: ${steps.length} steps between ${P.map((p) => p.label).join(', ')}. Each step is described in the list that follows.`}
      >
        {
          P.map((p) => (
            <g class={`actor role-${p.role}`} data-actor={p.id}>
              <line class="lifeline" x1={xOf(p.id)} y1={headH} x2={xOf(p.id)} y2={H - 6} />
            </g>
          ))
        }

        {
          rows.map((r) =>
            r.self ? (
              <g class={`step kind-self role-${r.from.role}`} data-step={r.i} data-actors={r.s.from}>
                <rect class="hit" x="0" y={r.y - rowH / 2} width={W} height={rowH} />
                <rect class="note" x={r.nx} y={r.y - 15} width={r.w} height="30" rx="15" />
                <circle class="badge" cx={r.nx + 16} cy={r.y} r="11" />
                <text class="badge-num" x={r.nx + 16} y={r.y + 4.4} text-anchor="middle">
                  {r.i + 1}
                </text>
                <text class="note-label" x={r.nx + 32 + (r.w - 44) / 2} y={r.y + 4.8} text-anchor="middle">
                  {r.s.label}
                </text>
              </g>
            ) : (
              <g class={`step kind-${r.s.kind} role-${r.from.role}`} data-step={r.i} data-actors={`${r.s.from} ${r.s.to}`}>
                <rect class="hit" x="0" y={r.y - rowH / 2} width={W} height={rowH} />
                <line class="arrow" x1={r.lineStart} y1={r.y} x2={r.lineEnd} y2={r.y} />
                <polygon class="head" points={r.head} />
                <circle class="badge" cx={r.x1} cy={r.y} r="11" />
                <text class="badge-num" x={r.x1} y={r.y + 4.4} text-anchor="middle">
                  {r.i + 1}
                </text>
                {r.lines.map((line, k) => (
                  <rect
                    class="label-bg"
                    x={r.labelX - (line.length * CHAR) / 2 - 4}
                    y={r.y - 13 - (r.lines.length - 1 - k) * LINE - 13}
                    width={line.length * CHAR + 8}
                    height={LINE + 1}
                  />
                ))}
                {r.lines.map((line, k) => (
                  <text
                    class="arrow-label"
                    x={r.labelX}
                    y={r.y - 13 - (r.lines.length - 1 - k) * LINE}
                    text-anchor="middle"
                  >
                    {line}
                  </text>
                ))}
              </g>
            ),
          )
        }
      </svg>
      </div>
    </div>
    <p class="flow-back">
      <button class="btn small" type="button" data-act="close">Back to the steps</button>
    </p>
  </details>

  <div class="flow-panel">
    <div class="flow-bar">
    <div class="flow-controls" hidden>
      <button class="btn small" type="button" data-act="prev"><span aria-hidden="true">←</span> Previous</button>
      <button class="btn small primary" type="button" data-act="next">Next <span aria-hidden="true">→</span></button>
      <button class="btn small ghost" type="button" data-act="play" aria-pressed="false">Play</button>
      <button class="btn small ghost" type="button" data-act="all" aria-pressed="false">All steps</button>
      <span class="flow-count" aria-live="polite"></span>
    </div>
    <div class="flow-progress" aria-hidden="true" hidden>
      {steps.map((_, i) => <button type="button" tabindex="-1" data-goto={i} />)}
    </div>
    </div>

    <ol class="flow-steps">
      {
        rows.map((r) => (
          <li class={`flow-step kind-${r.s.kind}`} data-step={r.i} id={`step-${r.i + 1}`}>
            {flow.reading?.phases?.filter((phase) => r.i + 1 >= phase.start && r.i + 1 <= phase.end).map((phase) => (
              <div class="phase-context" data-phase-start={r.i + 1 === phase.start ? "" : undefined}>
                <p><strong>{phase.title}</strong></p>
                <p set:html={inline(phase.summary)} />
              </div>
            ))}
            <p class="step-meta">
              <span class={`step-num role-${r.from.role}`}>{r.i + 1}</span>
              <span class="step-route">
                <span class={`who role-${r.from.role}`}>{r.from.label}</span>
                {r.to && (
                  <>
                    <span class="to" aria-hidden="true">→</span>
                    <span class="visually-hidden"> to </span>
                    <span class={`who role-${r.to.role}`}>{r.to.label}</span>
                  </>
                )}
              </span>
              <span class="step-kind">{KIND_LABEL[r.s.kind]}</span>
            </p>
            <h3 set:html={inline(r.s.title)} />
            <div class="step-body" set:html={block(r.s.body)} />
            {r.s.code && (
              <Code
                code={r.s.code.text.trim()}
                lang={r.s.code.lang as any}
                themes={codeThemes as any}
                defaultColor={false}
              />
            )}
            {flow.reading?.decisions?.presentation === "inline" && <FlowDecisions decisions={flow.reading.decisions} atStep={r.i + 1} />}
            {flow.reading?.decisions?.presentation === "table" && flow.reading.decisions.items.some((item) => item.atStep === r.i + 1) && (
              <p class="decision-link"><a href="#decisions">Choices at this step: {flow.reading.decisions.items.filter((item) => item.atStep === r.i + 1).map((item) => item.title.toLowerCase()).join('; ')}</a></p>
            )}
            {r.snapshot.length > 0 && (
              <div class="held">
                <p class="held-title">Who holds what after this step</p>
                <dl>
                  {r.snapshot.map((p) => (
                    <div class={`role-${p.role}`}>
                      <dt>{p.label}</dt>
                      <dd>
                        {p.items.map((it) => (
                          <span class:list={['held-chip', { fresh: it.fresh }]}>
                            {it.fresh && <span class="held-flag">new</span>}
                            {it.text}
                          </span>
                        ))}
                        {p.spent.map((text) => (
                          <span class="held-chip spent">
                            <span class="held-flag">used up</span>
                            <s>{text}</s>
                          </span>
                        ))}
                      </dd>
                    </div>
                  ))}
                </dl>
                <p class="held-note">Parties not listed hold none of this flow’s credentials at this point.</p>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</flow-diagram>

<script>
  class FlowDiagram extends HTMLElement {
    index = 0;
    count = 0;
    all = false;
    /** On a phone the steps read as one narrative and the diagram opens on demand. */
    narrative = false;
    timer: number | undefined;
    narrow = window.matchMedia('(max-width: 47.99rem)');

    connectedCallback() {
      this.count = Number(this.dataset.count ?? 0);
      this.dataset.js = '';
      this.querySelector<HTMLElement>('.flow-controls')!.hidden = false;
      this.querySelector<HTMLElement>('.flow-progress')!.hidden = false;

      this.addEventListener('click', (e) => {
        const t = e.target as Element;
        const act = t.closest<HTMLElement>('[data-act]')?.dataset.act;
        if (act === 'prev') return this.go(this.index - 1, true);
        if (act === 'next') return this.go(this.index + 1, true);
        if (act === 'play') return this.togglePlay();
        if (act === 'all') return this.toggleAll();
        if (act === 'close') {
          const stage = this.querySelector<HTMLDetailsElement>('.flow-stage')!;
          const summary = stage.querySelector<HTMLElement>('summary')!;
          stage.open = false;
          summary.scrollIntoView({ block: 'center' });
          summary.focus({ preventScroll: true });
          return;
        }
        const goto = t.closest<HTMLElement>('[data-goto]')?.dataset.goto;
        if (goto != null) return this.go(Number(goto), true);
        const step = t.closest<SVGGElement>('svg .step');
        if (step) {
          const i = Number(step.dataset.step);
          if (this.narrative) {
            // the diagram is a map of the narrative: jump to that step's text
            this.querySelector(`#step-${i + 1}`)?.scrollIntoView({ block: 'start' });
            history.replaceState(null, '', `#step-${i + 1}`);
            return;
          }
          if (this.all) this.toggleAll();
          this.go(i, true);
        }
      });

      this.addEventListener('keydown', (e) => {
        if (this.narrative || (e.target as Element).closest('pre, input, textarea, summary')) return;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.go(this.index + 1, true);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.go(this.index - 1, true);
        }
      });

      window.addEventListener('hashchange', this.fromHash);
      this.narrow.addEventListener('change', this.setMode);
      this.setMode();
      this.go(0, false);
      this.selectHash(false);
    }

    fromHash = () => this.selectHash(true);

    selectHash(changed: boolean) {
      const m = /^#step-(\d+)$/.exec(location.hash);
      if (!m) return;
      const index = Number(m[1]) - 1;
      this.go(index, false);
      if (!this.hasAttribute('data-reading') || index < 0 || index >= this.count) return;
      this.stop();
      // Select before scrolling: the browser cannot place a fragment on a hidden step.
      requestAnimationFrame(() => {
        // A later hash may have won while this callback waited for layout.
        if (location.hash !== `#step-${index + 1}`) return;
        const target = this.querySelector<HTMLElement>(`#step-${index + 1}`)!;
        const box = target.getBoundingClientRect();
        if (changed || box.top < 70 || box.top > window.innerHeight - 120) {
          target.scrollIntoView({ block: 'start', behavior: 'instant' });
        }
      });
    }

    setMode = () => {
      this.narrative = this.narrow.matches;
      this.toggleAttribute('data-narrative', this.narrative);
      // closed on a phone until asked for; always open beside the panel
      this.querySelector<HTMLDetailsElement>('.flow-stage')!.open = !this.narrative;
      if (this.narrative) this.stop();
      this.render();
    };

    go(i: number, user: boolean) {
      if (user) this.stop();
      const was = this.index;
      this.index = Math.max(0, Math.min(this.count - 1, i));
      this.render(user);
      // a new step is read from its top, even if the last one was scrolled
      if (this.index !== was) this.querySelector<HTMLElement>('.flow-panel')!.scrollTop = 0;
    }

    render(reveal = false) {
      const i = this.index;
      const all = this.all || this.narrative;
      let actors: string[] = [];
      this.querySelectorAll<SVGGElement>('svg .step').forEach((g) => {
        const s = Number(g.dataset.step);
        g.classList.toggle('is-active', !all && s === i);
        g.classList.toggle('is-done', !all && s < i);
        g.classList.toggle('is-todo', !all && s > i);
        if (s === i) actors = (g.dataset.actors ?? '').split(' ');
      });
      this.querySelectorAll<SVGGElement>('svg .actor').forEach((g) => {
        g.classList.toggle('is-active', !all && actors.includes(g.dataset.actor ?? ''));
      });
      this.querySelectorAll<HTMLElement>('.flow-step').forEach((li) => {
        li.hidden = !all && Number(li.dataset.step) !== i;
      });
      this.querySelectorAll<HTMLElement>('.flow-progress button').forEach((b, s) => {
        b.classList.toggle('is-active', s === i);
        b.classList.toggle('is-done', s < i);
      });
      const prev = this.querySelector<HTMLButtonElement>('[data-act="prev"]')!;
      const next = this.querySelector<HTMLButtonElement>('[data-act="next"]')!;
      // a button that is about to be disabled hands its focus to its neighbor, so the keyboard is never stranded
      const held = document.activeElement;
      prev.disabled = all || i === 0;
      next.disabled = all || i === this.count - 1;
      if (held === next && next.disabled && !prev.disabled) prev.focus({ preventScroll: true });
      if (held === prev && prev.disabled && !next.disabled) next.focus({ preventScroll: true });
      this.querySelector('.flow-count')!.textContent = all ? `${this.count} steps` : `Step ${i + 1} of ${this.count}`;

      if (reveal && !all) {
        const canvas = this.querySelector<HTMLElement>('.flow-canvas')!;
        const g = this.querySelector<SVGGElement>(`svg .step[data-step="${i}"] .hit`);
        if (g) {
          // keep the active row visible inside the scrollable canvas without moving the page
          const row = g.getBoundingClientRect();
          const box = canvas.getBoundingClientRect();
          if (row.top < box.top + 60 || row.bottom > box.bottom - 8) {
            canvas.scrollTop += row.top - box.top - box.height / 2 + row.height / 2;
          }
          const mark = g.parentElement?.querySelector('.arrow, .note')?.getBoundingClientRect();
          if (mark && (mark.left < box.left + 8 || mark.right > box.right - 8)) {
            canvas.scrollLeft += mark.left + mark.width / 2 - (box.left + box.width / 2);
          }
          // Beside the panel the diagram is as tall as its sequence and the page scrolls it.
          // Move the page just far enough to keep the current row below the pinned
          // participant strip and above the bottom of the window.
          if (canvas.scrollHeight <= canvas.clientHeight + 1) {
            const now = g.getBoundingClientRect();
            const heads = this.querySelector('.flow-heads')!.getBoundingClientRect();
            const upper = Math.max(heads.bottom, 0) + 8;
            const lower = window.innerHeight - 16;
            const by = now.top < upper ? now.top - upper : now.bottom > lower ? now.bottom - lower : 0;
            if (by) {
              const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              window.scrollBy({ top: by, behavior: calm ? 'auto' : 'smooth' });
            }
          }
        }
        history.replaceState(null, '', `#step-${i + 1}`);
      }
    }

    toggleAll() {
      this.stop();
      this.all = !this.all;
      this.querySelector('[data-act="all"]')!.setAttribute('aria-pressed', String(this.all));
      this.toggleAttribute('data-all', this.all);
      this.render();
    }

    togglePlay() {
      if (this.timer) return this.stop();
      if (this.all) this.toggleAll();
      if (this.index >= this.count - 1) this.index = -1;
      const btn = this.querySelector('[data-act="play"]')!;
      btn.setAttribute('aria-pressed', 'true');
      btn.textContent = 'Pause';
      const tick = () => {
        if (this.index >= this.count - 1) return this.stop();
        this.index += 1;
        this.render(true);
      };
      tick();
      this.timer = window.setInterval(tick, 2600);
    }

    stop() {
      if (this.timer) window.clearInterval(this.timer);
      this.timer = undefined;
      const btn = this.querySelector('[data-act="play"]');
      if (btn) {
        btn.setAttribute('aria-pressed', 'false');
        btn.textContent = 'Play';
      }
    }

    disconnectedCallback() {
      this.stop();
      this.narrow.removeEventListener('change', this.setMode);
      window.removeEventListener('hashchange', this.fromHash);
    }
  }
  customElements.define('flow-diagram', FlowDiagram);
</script>

<style>
  .phase-context { border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin-bottom: 1rem; }
  .phase-context p { margin: 0; }
  .phase-context p + p { margin-top: 0.3rem; }
  .flow:is([data-all], [data-narrative], :not([data-js])) .phase-context:not([data-phase-start]) { display: none; }
  .decision-link { margin: 1rem 0 0; }

  .flow {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 68rem) {
    .flow {
      /* the diagram gets the room: it is drawn at its natural size here */
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 1.75rem;
