---
/**
 * Sequence diagram with a step-through panel.
 *
 * The SVG and every step's explanation are rendered at build time, so the page
 * reads fine without JavaScript (all steps listed in order). The script at the
 * bottom adds navigation: the current step and matching arrow are highlighted,
 * while every explanation remains available to readers and browser Reader modes.
 *
 * Color means one thing here: the role of a participant. The kind of message
 * (direct call, response, through the browser, out of band) is carried by the
 * line style and named in the step. On a phone the steps read as a narrative
 * and the diagram opens on demand at full size.
 */
import { Code } from "astro:components";
import type { Flow, StepKind } from "../data/types";
import { gloss } from "../lib/gloss";
import { block, inline } from "../lib/md";
import { codeThemes } from "../lib/code-themes.mjs";

interface Props {
  /** A flow, or anything with a flow's cast and steps: a lesson draws a shortened one. */
  flow: Pick<Flow, "slug" | "title" | "participants" | "steps"> &
    Pick<Partial<Flow>, "phases">;
}
const { flow } = Astro.props;
const P = flow.participants;
const steps = flow.steps;
const n = P.length;

// ---- geometry ----
// Sized so that a four-party diagram is about 660 units wide and is drawn at
// its natural size beside the step panel: labels render at 14px, not smaller.
const boxW = 150;
const boxH = 48;
const gap = n <= 3 ? 214 : n === 4 ? 162 : n === 5 ? 156 : 152;
const padX = boxW / 2 + 14;
const CHAR = 7.1; // approximate advance of the label face at 14px
const W = padX * 2 + gap * (n - 1);
const top = 8;
const y0 = top + boxH + 52;
const rowH = 64;
const LINE = 17; // line height of a two-line arrow label
// The participant boxes are drawn in a strip of their own, so that it can stay
// in view while a long sequence scrolls beneath it.
const headH = top + boxH + 8;

const idx = (id: string) => {
  const i = P.findIndex((p) => p.id === id);
  if (i < 0) throw new Error(`[${flow.slug}] unknown participant "${id}"`);
  return i;
};
const xOf = (id: string) => padX + gap * idx(id);
const name = (id: string) => P[idx(id)].label;
const who = (id: string) => P[idx(id)];

/**
 * Each step's label as it is drawn: on one line, or, on an arrow too short
 * for that, split into two balanced lines. A local action's is never split.
 */
const labelLines = steps.map((s, i) => {
  if (!s.to || s.to === s.from) return [s.label];
  const room = Math.abs(xOf(s.to) - xOf(s.from)) - 26;
  if (s.label.length * CHAR <= room) return [s.label];
  const words = s.label.split(" ");
  let best = [s.label];
  let bestLen = Infinity;
  for (let k = 1; k < words.length; k++) {
    const a = words.slice(0, k).join(" ");
    const b = words.slice(k).join(" ");
    const len = Math.max(a.length, b.length);
    if (len < bestLen) {
      bestLen = len;
      best = [a, b];
    }
  }
  // a label may run past its arrow (it is clamped to the canvas below), but not by much
  if (Math.max(...best.map((l) => l.length)) * CHAR > room + 70) {
    console.warn(
      `[${flow.slug}] step ${i + 1} label is too long for its arrow: "${s.label}"`,
    );
  }
  return best;
});

// A flow's phases divide the sequence into bands, each under a heading of its own.
const phases = flow.phases ?? [];
const phaseH = phases.length ? 34 : 0;
/** The phase a step belongs to, both counting from 0. -1 where there are no phases. */
const phaseAt = (i: number) => phases.findLastIndex((p) => i + 1 >= p.from);
// A label's second line rises into the room the row above leaves free. The row
// that opens a phase has the phase's heading there instead, so that row is one
// label line taller: the heading is as far above a two-line label as a one-line one.
const lift = steps.map((_, i) =>
  phases[phaseAt(i)]?.from === i + 1 && labelLines[i].length > 1 ? LINE : 0,
);
let lifted = 0;
const rowY = steps.map((_, i) => {
  lifted += lift[i];
  return y0 + i * rowH + (phaseAt(i) + 1) * phaseH + lifted;
});
const yOf = (i: number) => rowY[i];
const H = yOf(steps.length - 1) + 40;

const KIND_LABEL: Record<StepKind, string> = {
  back: "Direct call",
  front: "Via the user’s browser or device",
  resp: "Response",
  oob: "Out of band",
  self: "Local action",
};

// ---- per-step drawing data + credential snapshots ----
const held = new Map<string, string[]>(P.map((p) => [p.id, []]));

const bands = phases.map((p, k) => {
  const first = p.from - 1;
  const last = (phases[k + 1]?.from ?? steps.length + 1) - 2;
  const text = `${k + 1}  ${p.title}`;
  if (text.length * 7 > W - 24)
    console.warn(
      `[${flow.slug}] phase ${k + 1} title is too long for the diagram: "${p.title}"`,
    );
  return {
    k,
    title: p.title,
    first,
    last,
    // the band sits directly above its first step's row
    y: yOf(first) - rowH / 2 - lift[first] - phaseH + 6,
  };
});

const rows = steps.map((s, i) => {
  const y = yOf(i);
  const to = s.to;
  const x1 = xOf(s.from);

  const spent = new Map<string, string[]>();
  for (const [id, what] of s.lose ?? []) {
    idx(id);
    held.set(
      id,
      (held.get(id) ?? []).filter((a) => a !== what),
    );
    spent.set(id, [...(spent.get(id) ?? []), what]);
  }
  const fresh = new Set<string>();
  for (const [id, what] of s.gain ?? []) {
    idx(id);
    const list = held.get(id) ?? [];
    if (!list.includes(what)) list.push(what);
    held.set(id, list);
    fresh.add(`${id}\u0000${what}`);
  }
  const phase = phaseAt(i);
  const part =
    phase >= 0
      ? {
          n: phase + 1,
          of: phases.length,
          title: phases[phase].title,
          start: phases[phase].from === i + 1,
        }
      : undefined;
  const snapshot = P.map((p) => ({
    ...p,
    items: (held.get(p.id) ?? []).map((text) => ({
      text,
      fresh: fresh.has(`${p.id}\u0000${text}`),
    })),
    spent: spent.get(p.id) ?? [],
  })).filter((p) => p.items.length > 0 || p.spent.length > 0);
  const from = who(s.from);

  // the band a pointer or the current step lights up: the whole of the row
  const hit = { y: y - rowH / 2 - lift[i], h: rowH + lift[i] };

  // A step with no recipient, or addressed to its sender, is a local action.
  if (!to || to === s.from) {
    const w = Math.min(Math.max(118, s.label.length * CHAR + 54), W - 8);
    const nx = Math.min(Math.max(x1 - w / 2, 4), W - w - 4);
    return {
      s,
      i,
      y,
      hit,
      self: true as const,
      x1,
      nx,
      w,
      snapshot,
      part,
      from,
      to: undefined,
      route: name(s.from),
    };
  }

  const x2 = xOf(to);
  const dir = x2 > x1 ? 1 : -1;
  const lines = labelLines[i];
  const tip = x2 - dir * 3;
  const head = `${tip},${y} ${tip - dir * 9},${y - 4.6} ${tip - dir * 9},${y + 4.6}`;
  // a label may run a little past its arrow, but never off the canvas
  const half = (Math.max(...lines.map((l) => l.length)) * CHAR) / 2;
  const labelX = Math.min(
    Math.max((x1 + x2) / 2 + dir * 4, half + 6),
    W - half - 6,
  );
  return {
    s,
    i,
    y,
    hit,
    self: false as const,
    x1,
    x2,
    dir,
    head,
    lineStart: x1 + dir * 12,
    lineEnd: tip - dir * 7,
    labelX,
    lines,
    snapshot,
    part,
    from,
    to: who(to),
    route: `${name(s.from)} → ${name(to)}`,
  };
});

const usedKinds = [...new Set(steps.map((s) => s.kind))];
---

<flow-diagram class="flow" data-count={steps.length}>
  <aside class="flow-visual" aria-label="Sequence diagram">
  <details class="flow-stage" open>
    <summary>
      <span class="flow-stage-title">Sequence diagram</span>
      <span class="flow-stage-count">{n} participants, {steps.length} steps</span>
    </summary>
    <div class="flow-figure">
    <ul class="flow-legend" aria-label="Legend">
      {
        (['back', 'front', 'resp', 'oob', 'self'] as StepKind[])
          .filter((k) => usedKinds.includes(k))
          .map((k) => (
            <li class={`kind-${k}`}>
              <svg width="34" height="10" viewBox="0 0 34 10" aria-hidden="true">
                {k === 'self' ? (
                  <rect class="note" x="1" y="1" width="32" height="8" rx="4" />
                ) : (
                  <>
                    <line class="arrow" x1="0" y1="5" x2="26" y2="5" />
                    <polygon class="head" points="34,5 25,0.8 25,9.2" />
                  </>
                )}
              </svg>
              {KIND_LABEL[k]}
            </li>
          ))
      }
    </ul>
    <p class="flow-hint">Drag to see every party and step. Tap a step to jump to its explanation.</p>
    <div class="flow-canvas" tabindex="0" role="group" aria-label={`Sequence diagram: ${flow.title}`}>
      <div class="flow-sheet" style={`--natural: ${W}px; --aspect: ${(W / H).toFixed(4)}`}>
      <svg class="flow-heads" viewBox={`0 0 ${W} ${headH}`} width={W} height={headH} aria-hidden="true">
        {
          P.map((p) => {
            const x = xOf(p.id);
            return (
              <g class={`actor role-${p.role}`} data-actor={p.id}>
                <line class="lifeline" x1={x} y1={top + boxH} x2={x} y2={headH} />
                <rect class="actor-box" x={x - boxW / 2} y={top} width={boxW} height={boxH} rx="4" />
                <text class="actor-label" x={x} y={top + (p.sub ? 21 : 29)} text-anchor="middle">
                  {p.label}
                </text>
                {p.sub && (
                  <text class="actor-sub" x={x} y={top + 37} text-anchor="middle">
                    {p.sub}
                  </text>
                )}
              </g>
            );
          })
        }
      </svg>
      <svg
        class="flow-lines"
        viewBox={`0 ${headH} ${W} ${H - headH}`}
        width={W}
        height={H - headH}
        role="img"
        aria-label={`${flow.title}: ${steps.length} steps between ${P.map((p) => p.label).join(', ')}. Each step is described in the list that follows.`}
      >
        {
          P.map((p) => (
            <g class={`actor role-${p.role}`} data-actor={p.id}>
              <line class="lifeline" x1={xOf(p.id)} y1={headH} x2={xOf(p.id)} y2={H - 6} />
            </g>
          ))
        }

        {
          bands.map((b) => (
            <g class="phase" data-phase={b.k} data-first={b.first} data-last={b.last}>
              <rect class="phase-band" x="0" y={b.y} width={W} height={phaseH - 10} rx="2" />
              <text class="phase-num" x="12" y={b.y + (phaseH - 10) / 2 + 4.6}>
                {b.k + 1}
              </text>
              <text class="phase-title" x="30" y={b.y + (phaseH - 10) / 2 + 4.6}>
                {b.title}
              </text>
            </g>
          ))
        }

        {
          rows.map((r) =>
            r.self ? (
              <g class={`step kind-self role-${r.from.role}`} data-step={r.i} data-actors={r.s.from}>
                <rect class="hit" x="0" y={r.hit.y} width={W} height={r.hit.h} />
                <rect class="note" x={r.nx} y={r.y - 15} width={r.w} height="30" rx="15" />
                <circle class="badge" cx={r.nx + 16} cy={r.y} r="11" />
                <text class="badge-num" x={r.nx + 16} y={r.y + 4.4} text-anchor="middle">
                  {r.i + 1}
                </text>
                <text class="note-label" x={r.nx + 32 + (r.w - 44) / 2} y={r.y + 4.8} text-anchor="middle">
                  {r.s.label}
                </text>
              </g>
            ) : (
              <g class={`step kind-${r.s.kind} role-${r.from.role}`} data-step={r.i} data-actors={`${r.s.from} ${r.s.to}`}>
                <rect class="hit" x="0" y={r.hit.y} width={W} height={r.hit.h} />
                <line class="arrow" x1={r.lineStart} y1={r.y} x2={r.lineEnd} y2={r.y} />
                <polygon class="head" points={r.head} />
                <circle class="badge" cx={r.x1} cy={r.y} r="11" />
                <text class="badge-num" x={r.x1} y={r.y + 4.4} text-anchor="middle">
                  {r.i + 1}
                </text>
                {r.lines.map((line, k) => (
                  <rect
                    class="label-bg"
                    x={r.labelX - (line.length * CHAR) / 2 - 4}
                    y={r.y - 13 - (r.lines.length - 1 - k) * LINE - 13}
                    width={line.length * CHAR + 8}
                    height={LINE + 1}
                  />
                ))}
                {r.lines.map((line, k) => (
                  <text
                    class="arrow-label"
                    x={r.labelX}
                    y={r.y - 13 - (r.lines.length - 1 - k) * LINE}
                    text-anchor="middle"
                  >
                    {line}
                  </text>
                ))}
              </g>
            ),
          )
        }
      </svg>
      </div>
    </div>
    </div>
    <p class="flow-back">
      <button class="btn small" type="button" data-act="close">Back to the steps</button>
    </p>
  </details>
  </aside>

  <div class="flow-panel">
    <aside class="flow-bar" aria-label="Step navigation">
    <div class="flow-controls" hidden>
      <button class="btn small" type="button" data-act="prev"><span aria-hidden="true">←</span> Previous</button>
      <button class="btn small primary" type="button" data-act="next">Next <span aria-hidden="true">→</span></button>
      <button class="btn small ghost" type="button" data-act="play" aria-pressed="false">Play</button>
      <button class="btn small ghost" type="button" data-act="all" aria-pressed="false">Expand steps</button>
      <span class="flow-count" aria-live="polite"></span>
    </div>
    <div class="flow-progress" aria-hidden="true" hidden>
      {steps.map((_, i) => <button type="button" tabindex="-1" data-goto={i} />)}
    </div>
    </aside>

    <ol class="flow-steps">
      {
        rows.map((r) => (
          <li class:list={['flow-step', `kind-${r.s.kind}`, { 'phase-start': r.part?.start }]} data-step={r.i} id={`step-${r.i + 1}`}>
            {r.part && (
              <p class="step-phase">
                <span class="step-phase-n">Part {r.part.n} of {r.part.of} </span>
                {r.part.title}
              </p>
            )}
            <p class="step-meta">
              <span class={`step-num role-${r.from.role}`}>{r.i + 1} </span>
              <span class="step-route">
                <span class={`who role-${r.from.role}`}>{r.from.label} </span>
                {r.to && (
                  <>
                    <span class="to" aria-hidden="true"> → </span>
                    <span class="visually-hidden"> to </span>
                    <span class={`who role-${r.to.role}`}> {r.to.label}</span>
                  </>
                )}
              </span>
              <span class="step-kind"> — {KIND_LABEL[r.s.kind]}</span>
            </p>
            <h3 set:html={inline(r.s.title)} />
            {/* each step can be linked to directly, so it marks glossary terms afresh */}
            <div class="step-body" set:html={block(r.s.body, gloss(Astro.url.pathname))} />
            {r.s.code && (
              <Code
                code={r.s.code.text.trim()}
                lang={r.s.code.lang as any}
                themes={codeThemes as any}
                defaultColor={false}
              />
            )}
            {r.snapshot.length > 0 && (
              <div class="held">
                <p class="held-title">Who holds what after this step</p>
                <dl>
                  {r.snapshot.map((p) => (
                    <div class={`role-${p.role}`}>
                      <dt>{p.label}</dt>
                      <dd>
                        {p.items.map((it) => (
                          <span class:list={['held-chip', { fresh: it.fresh }]}>
                            {it.fresh && <span class="held-flag">new </span>}
                            {it.text}{' '}
                          </span>
                        ))}
                        {p.spent.map((text) => (
                          <span class="held-chip spent">
                            <span class="held-flag">used up </span>
                            <s>{text}</s>
                          </span>
                        ))}
                      </dd>
                    </div>
                  ))}
                </dl>
                <p class="held-note">Parties not listed hold none of this flow’s credentials at this point.</p>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</flow-diagram>

<script>
  class FlowDiagram extends HTMLElement {
    index = 0;
    count = 0;
    all = false;
    /** On a phone the steps read as one narrative and the diagram opens on demand. */
    narrative = false;
    timer: number | undefined;
    narrow = window.matchMedia('(max-width: 47.99rem)');

    connectedCallback() {
      this.count = Number(this.dataset.count ?? 0);
      this.dataset.js = '';
      this.querySelector<HTMLElement>('.flow-controls')!.hidden = false;
      this.querySelector<HTMLElement>('.flow-progress')!.hidden = false;

      this.addEventListener('click', (e) => {
        const t = e.target as Element;
        const act = t.closest<HTMLElement>('[data-act]')?.dataset.act;
        if (act === 'prev') return this.go(this.index - 1, true);
        if (act === 'next') return this.go(this.index + 1, true);
        if (act === 'play') return this.togglePlay();
        if (act === 'all') return this.toggleAll();
        if (act === 'close') {
          const stage = this.querySelector<HTMLDetailsElement>('.flow-stage')!;
          const summary = stage.querySelector<HTMLElement>('summary')!;
          stage.open = false;
          summary.scrollIntoView({ block: 'center' });
          summary.focus({ preventScroll: true });
          return;
        }
        const goto = t.closest<HTMLElement>('[data-goto]')?.dataset.goto;
        if (goto != null) return this.go(Number(goto), true);
        // a band's heading stands for its first step
        const step = t.closest<SVGGElement>('svg .step, svg .phase');
        if (step) {
          const i = Number(step.dataset.step ?? step.dataset.first);
          if (this.narrative) {
            // the diagram is a map of the narrative: jump to that step's text
            this.querySelector(`#step-${i + 1}`)?.scrollIntoView({ block: 'start' });
            // keeps the entry that opening the diagram added
            history.replaceState(history.state, '', `#step-${i + 1}`);
            this.reached = `step-${i + 1}`;
            return;
          }
          if (this.all) this.toggleAll();
          this.go(i, true);
        }
      });

      this.addEventListener('keydown', (e) => {
        if (this.narrative || (e.target as Element).closest('pre, input, textarea, summary')) return;
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        this.go(this.index + (e.key === 'ArrowRight' ? 1 : -1), true);
        // Keyboard navigation can scroll the focused link out of the panel.
        // Keep Tab near the selected step rather than returning to the old one.
        if (!this.all && document.activeElement?.closest('.flow-step:not(.is-current)')) {
          (
            this.querySelector<HTMLButtonElement>('[data-act="next"]:not(:disabled)') ??
            this.querySelector<HTMLButtonElement>('[data-act="prev"]:not(:disabled)')
          )?.focus({ preventScroll: true });
        }
      });

      const fromHash = () => {
        const m = /^#step-(\d+)$/.exec(location.hash);
        if (!m) return;
        this.go(Number(m[1]) - 1, false);
        this.revealText();
        // Deep links align both the explanation and the matching diagram row.
        // A late step can sit a screen or more below the first.
        if (!this.narrative && !this.all) {
          const panel = this.querySelector<HTMLElement>('.flow-panel')!;
          if (panel.scrollHeight > panel.clientHeight + 1) this.scrollIntoView({ block: 'start', behavior: 'instant' });
          this.reveal(true);
          // The page settles after the jump (the header's height, the pinned strip),
          // and the row can slip back out; look again once it has.
          const again = () => requestAnimationFrame(() => requestAnimationFrame(() => this.reveal(true)));
          again();
          if (document.readyState !== 'complete') window.addEventListener('load', again, { once: true });
        }
      };
      window.addEventListener('hashchange', fromHash);
      this.narrow.addEventListener('change', this.setMode);
      this.setMode();
      this.go(0, false);
      fromHash();
      this.keepHistory();
    }

    /** Set while the diagram, opened on a phone, has an entry of its own in the history. */
    shown = false;
    /** How many links to a step the reader has followed since that entry. */
    above = 0;
    /** Set while closing the diagram with its own control takes those entries back off. */
    closing = false;
    /** The step last pressed in the open diagram, which Back returns the reader to. */
    reached: string | null = null;

    /**
     * On a phone the diagram opens like a sheet: opening it adds one entry to the
     * history, and Back closes it and leaves the reader where they were, at the
     * step they had reached. Closing it with its own control takes the entry back,
     * with any links to a step followed while it was open, so the next Back leaves
     * the page. Beside the panel the diagram is always open, and none of this applies.
     */
    keepHistory() {
      const stage = this.querySelector<HTMLDetailsElement>('.flow-stage')!;
      const step = () => (/^#step-\d+$/.test(location.hash) ? location.hash.slice(1) : null);
      // A reload with the diagram open keeps it open, so Back still has something
      // to close. The count is restored at any width; beside the panel it is open anyway.
      const { diagram, above } = history.state ?? {};
      if (diagram || above) {
        this.shown = true;
        this.above = above ?? 0;
        this.reached = step();
        if (this.narrative) stage.open = true;
      }
      stage.addEventListener('toggle', () => {
        if (!this.narrative) return;
        if (stage.open && !this.shown) {
          // Mark the entry underneath too. Following a link to another step
          // also fires popstate, and only a return to this entry is Back.
          const { diagram, under, above, ...rest } = history.state ?? {};
          history.replaceState({ ...rest, under: true }, '', location.href);
          history.pushState({ ...rest, diagram: true }, '', location.href);
          this.shown = true;
          this.above = 0;
          this.reached = null;
        } else if (!stage.open && this.shown) {
          // the address keeps the step the reader is on
          this.reached = step() ?? this.reached;
          this.closing = true;
          history.go(-(this.above + 1));
        }
      });
      window.addEventListener('popstate', this.popped);
    }

    popped = () => {
      const stage = this.querySelector<HTMLDetailsElement>('.flow-stage')!;
      const state = history.state;
      // The count of entries is kept whatever the width, so that narrowing the
      // window again and closing the diagram steps back the right distance.
      if (state?.diagram) {
        // Forward into the open diagram, or Back past a link followed inside it
        this.shown = true;
        this.above = 0;
        if (this.narrative) stage.open = true;
        return;
      }
      if (!this.shown) return;
      if (!state?.under) {
        // A link to another step, followed with the diagram open: it stays open,
        // and the entry is counted, so that closing the diagram takes it back too.
        // Back and Forward among those entries read the count each one carries.
        this.above = state?.above ?? this.above + 1;
        if (state?.above == null) history.replaceState({ ...state, above: this.above }, '', location.href);
        return;
      }
      const { closing, reached } = this;
      this.shown = this.closing = false;
      this.above = 0;
      const step = reached ? this.querySelector<HTMLElement>(`#${reached}`) : null;
      // the entry from before the diagram opened takes the step the reader reached
      if (step) history.replaceState(state, '', `#${reached}`);
      // widened since it opened, the diagram sits beside the panel and stays open
      if (!this.narrative) return;
      stage.open = false;
      const summary = stage.querySelector<HTMLElement>('summary')!;
      // after the browser has put back its own scroll position for this entry
      requestAnimationFrame(() => {
        if (step && !closing) return step.scrollIntoView({ block: 'start' });
        summary.scrollIntoView({ block: closing ? 'center' : 'nearest' });
        summary.focus({ preventScroll: true });
      });
    };

    setMode = () => {
      this.narrative = this.narrow.matches;
      this.toggleAttribute('data-narrative', this.narrative);
      // closed on a phone until asked for; always open beside the panel
      this.querySelector<HTMLDetailsElement>('.flow-stage')!.open = !this.narrative;
      if (this.narrative) this.stop();
      this.render();
    };

    go(i: number, user: boolean) {
      if (user) this.stop();
      const was = this.index;
      this.index = Math.max(0, Math.min(this.count - 1, i));
      this.render(user);
      // The panel contains the whole narrative. Navigation scrolls it rather
      // than hiding the explanations a browser Reader needs to extract.
      if (!user && this.index !== was) this.revealText();
    }

    render(reveal = false) {
      const i = this.index;
      const all = this.all || this.narrative;
      let actors: string[] = [];
      this.querySelectorAll<SVGGElement>('svg .step').forEach((g) => {
        const s = Number(g.dataset.step);
        g.classList.toggle('is-active', !all && s === i);
        g.classList.toggle('is-done', !all && s < i);
        g.classList.toggle('is-todo', !all && s > i);
        if (s === i) actors = (g.dataset.actors ?? '').split(' ');
      });
      this.querySelectorAll<SVGGElement>('svg .phase').forEach((g) => {
        g.classList.toggle('is-active', !all && i >= Number(g.dataset.first) && i <= Number(g.dataset.last));
      });
      this.querySelectorAll<SVGGElement>('svg .actor').forEach((g) => {
        g.classList.toggle('is-active', !all && actors.includes(g.dataset.actor ?? ''));
      });
      this.querySelectorAll<HTMLElement>('.flow-step').forEach((li) => {
        li.classList.toggle('is-current', !all && Number(li.dataset.step) === i);
      });
      this.querySelectorAll<HTMLElement>('.flow-progress button').forEach((b, s) => {
        b.classList.toggle('is-active', s === i);
        b.classList.toggle('is-done', s < i);
      });
      const prev = this.querySelector<HTMLButtonElement>('[data-act="prev"]')!;
      const next = this.querySelector<HTMLButtonElement>('[data-act="next"]')!;
      // a button that is about to be disabled hands its focus to its neighbor, so the keyboard is never stranded
      const held = document.activeElement;
      prev.disabled = all || i === 0;
      next.disabled = all || i === this.count - 1;
      if (held === next && next.disabled && !prev.disabled) prev.focus({ preventScroll: true });
      if (held === prev && prev.disabled && !next.disabled) next.focus({ preventScroll: true });
      this.querySelector('.flow-count')!.textContent = all ? `${this.count} steps` : `Step ${i + 1} of ${this.count}`;

      if (reveal && !all) {
        this.revealText();
        this.reveal();
        // keeps the entries a phone added, should the window have been widened since
        history.replaceState(history.state, '', `#step-${i + 1}`);
      }
    }

    /** Scroll only the panel; all steps remain present and readable. */
    revealText() {
      if (this.all || this.narrative) return;
      const panel = this.querySelector<HTMLElement>('.flow-panel')!;
      const step = this.querySelector<HTMLElement>(`#step-${this.index + 1}`)!;
      const bar = this.querySelector<HTMLElement>('.flow-bar')!;
      if (panel.scrollHeight > panel.clientHeight + 1) {
        panel.scrollTop += step.getBoundingClientRect().top - panel.getBoundingClientRect().top - bar.offsetHeight - 8;
      } else {
        step.scrollIntoView({ block: 'nearest' });
      }
    }

    /** Brings the current step's row into view: inside the diagram's own frame where it has one, and on the page. */
    reveal(instant = false) {
      const canvas = this.querySelector<HTMLElement>('.flow-canvas')!;
      const g = this.querySelector<SVGGElement>(`svg .step[data-step="${this.index}"] .hit`);
      if (!g) return;
      // keep the active row visible inside the scrollable canvas without moving the page
      const row = g.getBoundingClientRect();
      const box = canvas.getBoundingClientRect();
      if (row.top < box.top + 60 || row.bottom > box.bottom - 8) {
        canvas.scrollTop += row.top - box.top - box.height / 2 + row.height / 2;
      }
      const mark = g.parentElement?.querySelector('.arrow, .note')?.getBoundingClientRect();
      if (mark && (mark.left < box.left + 8 || mark.right > box.right - 8)) {
        canvas.scrollLeft += mark.left + mark.width / 2 - (box.left + box.width / 2);
      }
      // Beside the panel the diagram is as tall as its sequence and the page scrolls it.
      // Move the page just far enough to keep the current row below the pinned
      // participant strip and above the bottom of the window.
      const panel = this.querySelector<HTMLElement>('.flow-panel')!;
      if (canvas.scrollHeight <= canvas.clientHeight + 1 && panel.scrollHeight > panel.clientHeight + 1) {
        const now = g.getBoundingClientRect();
        const heads = this.querySelector('.flow-heads')!.getBoundingClientRect();
        const upper = Math.max(heads.bottom, 0) + 8;
        const lower = window.innerHeight - 16;
        const by = now.top < upper ? now.top - upper : now.bottom > lower ? now.bottom - lower : 0;
        if (by) {
          // Arriving from an address is a jump, not a step: a smooth scroll begun
          // straight after the jump to the diagram is cut short by it.
          const calm = instant || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollBy({ top: by, behavior: calm ? 'instant' : 'smooth' });
        }
      }
    }

    toggleAll() {
      this.stop();
      this.all = !this.all;
      this.querySelector('[data-act="all"]')!.setAttribute('aria-pressed', String(this.all));
      this.toggleAttribute('data-all', this.all);
      this.render();
    }

    togglePlay() {
      if (this.timer) return this.stop();
      if (this.all) this.toggleAll();
      if (this.index >= this.count - 1) this.index = -1;
      const btn = this.querySelector('[data-act="play"]')!;
      btn.setAttribute('aria-pressed', 'true');
      btn.textContent = 'Pause';
      const tick = () => {
        if (this.index >= this.count - 1) return this.stop();
        this.index += 1;
        this.render(true);
      };
      tick();
      this.timer = window.setInterval(tick, 2600);
    }

    stop() {
      if (this.timer) window.clearInterval(this.timer);
      this.timer = undefined;
      const btn = this.querySelector('[data-act="play"]');
      if (btn) {
        btn.setAttribute('aria-pressed', 'false');
        btn.textContent = 'Play';
      }
    }

    disconnectedCallback() {
      this.stop();
      this.narrow.removeEventListener('change', this.setMode);
      window.removeEventListener('popstate', this.popped);
    }
  }
  customElements.define('flow-diagram', FlowDiagram);
</script>

