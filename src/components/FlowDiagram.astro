    stroke-linejoin: round;
  }
  .note {
    fill: var(--bg-sunken);
    stroke: var(--border-strong);
    stroke-width: 1.1;
  }

  /* Steps before and after the current one stay readable: they step back to the
     muted ink, which is held to 4.5:1 on this surface, never to an opacity. */
  .step:is(.is-todo, .is-done) :is(.arrow-label, .note-label) {
    fill: var(--fg-muted);
  }
  .step:is(.is-todo, .is-done) .arrow {
    stroke: var(--fg-muted);
  }
  .step:is(.is-todo, .is-done) .head {
    fill: var(--fg-muted);
  }
  .step.is-done .badge {
    fill: var(--role-soft);
  }
  .step.is-active .arrow {
    stroke-width: 2.6;
  }
  .step.is-active .badge {
    fill: var(--role);
    stroke-width: 2;
  }
  .step.is-active .badge-num {
    fill: var(--bg-raised);
    font-weight: 600;
  }
  .step.is-active .arrow-label,
  .step.is-active .note-label {
    font-weight: 600;
  }
  .step.is-active .arrow-label {
    stroke: var(--bg-inset);
  }
  .step.is-active .note {
    fill: var(--bg-raised);
    stroke: var(--fg);
    stroke-width: 1.8;
  }
  .step.is-active :is(.hit, .label-bg) {
