        linear-gradient(to left, var(--bg-raised) 40%, transparent) right / 2.4rem 100% no-repeat local,
        linear-gradient(to right, color-mix(in srgb, var(--fg) 30%, transparent), transparent) left / 0.8rem 100% no-repeat scroll,
        linear-gradient(to left, color-mix(in srgb, var(--fg) 30%, transparent), transparent) right / 0.8rem 100% no-repeat scroll,
        var(--bg-raised);
