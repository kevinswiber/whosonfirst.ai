      min-width: 0;
    }
    .flow-heads {
      top: calc(3.5rem + 1px);
    }
  }
  @media (min-width: 48rem) and (max-width: 67.99rem) {
    /* stacked above the panel, the stepper keeps the diagram in a frame of its own */
    .flow[data-js]:not([data-all]) .flow-canvas {
      max-height: 62vh;
      overflow: auto;
    }
    .flow[data-js]:not([data-all]) .flow-heads {
