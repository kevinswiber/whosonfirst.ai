    stroke-linecap: round;
    stroke-width: 2;
  }
  .head {
    fill: var(--fg);
  }
  /* the number sits on the sender's lifeline and wears the sender's color */
  .badge {
    fill: var(--bg-raised);
    stroke: var(--role);
    stroke-width: 1.6;
  }
  .badge-num {
    font-family: var(--font-mono);
