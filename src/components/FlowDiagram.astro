  /* The participant strip stays in view while the sequence scrolls under it:
     pinned inside the frame where the frame scrolls, under the site header
     where the page does. */
  .flow-heads {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg-raised);
  }
  @media (min-width: 48rem) {
