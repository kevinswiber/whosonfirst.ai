---
import type { Standard } from "../data/types";
import { STATUS_LABEL, STATUS_TONE } from "../data/types";
import { inline } from "../lib/md";

interface Props {
  standard: Standard;
}
const { standard: s } = Astro.props;
---

<a class="card std" href={`/standards/#${s.id}`}>
  <h4>{s.name}</h4>
  <div class="std-meta">
    <span class="chip" data-tone={STATUS_TONE[s.status]}>{STATUS_LABEL[s.status]}</span>
    <span class="ref">{' · '}{s.ref}</span>
  </div>
  <p set:html={inline(s.agents)} />
</a>

<style>
  .std-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-bottom: 0.45rem;
  }
  .ref {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    word-break: break-word;
  }
</style>
