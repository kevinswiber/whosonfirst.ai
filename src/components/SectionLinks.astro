---
/**
 * What the links to a page's sections do and how they look. The links are in
 * the page already: src/lib/section-links.ts puts one beside each section
 * heading when the page is built, and pressing it puts that section's address
 * in the address bar, with or without this script. The script adds one thing:
 * the same press also copies the address, and says so.
 */
---

<style is:global>
  /* The link is the first thing in its heading, floated into the margin to the
     left of it, as GitHub sets its own. Its box is one em of the heading wide
     and pulled back by the same, so the text does not move and takes none of
     its room, and as high as the heading's first line, so the icon is level
     with it whatever the heading's padding. The icon has the box's right side,
     and the gap to the text is what is left. */
  .section-link {
    --hang: 1em;
    position: relative;
    float: left;
    box-sizing: border-box;
    width: var(--hang);
    height: 1lh;
    margin-inline-start: calc(-1 * var(--hang));
    white-space: nowrap;
  }
  /* The link is a small icon with room around it to press. The room is in the
     padding, which is taken back in the margin, so nothing is moved by it. */
  .section-link a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    padding: 0 0.3em;
    margin: 0 -0.3em;
    border-radius: var(--radius);
    color: var(--fg-subtle);
    text-decoration: none;
  }
  .section-link a:hover {
    color: var(--accent);
  }
  .section-link svg {
    flex: none;
    width: 0.65em;
    height: 0.65em;
    margin-inline-end: 0.35em;
  }
  @media (pointer: coarse) {
    .section-link svg {
      width: 0.75em;
      height: 0.75em;
      margin-inline-end: 0.25em;
    }
  }
  /* The margin of a narrow page is the page's own side padding, 1rem at least.
     The box is that wide, and the icon is a little smaller and in the middle
     of it, so that it clears the edge of the window as well as the text. */
  @media (max-width: 40rem) {
    .section-link {
      --hang: 1rem;
    }
    .section-link a {
      justify-content: center;
      padding: 0 0.5rem 0 0;
      margin: 0 -0.5rem 0 0;
    }
    .section-link svg {
      width: 0.8rem;
      height: 0.8rem;
      margin: 0;
    }
  }
  /* The word "Copied", said under the icon for a moment after a press that
     copied the address: out of the flow, so that it takes no room in the
     heading and cannot widen the page. It is only generated content: the
     polite status line says it to a screen reader. Nothing is said on hover or
     focus, since the icon says enough. */
  .section-link a::after {
    position: absolute;
    left: 0;
    top: calc(100% + 0.35rem);
    z-index: 2;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
    pointer-events: none;
    display: none;
  }
  .section-link[data-copied] a::after {
    content: "Copied";
    content: "Copied" / "";
    display: block;
  }
  /* With a pointer the icon waits until the heading is pointed at, reached by
     keyboard or arrived at. Where there is none to point with it is always
     there. */
  @media (hover: hover) {
    .section-link {
      opacity: 0;
    }
    :is(h2, h3):is(:hover, :focus-within, :target) > .section-link,
    .section-link[data-copied] {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .section-link {
      transition: opacity 0.12s;
    }
  }
  @media print {
    .section-link {
      display: none;
    }
  }
</style>

<script>
  // Without a clipboard, or when it refuses, the link is what it is without a
  // script: it goes to the section. A press with a modifier is left to the
  // browser, which opens it somewhere else.
  class SectionLink extends HTMLElement {
    private timer = 0;
    connectedCallback() {
      region();
      const link = this.querySelector('a');
      link?.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey)
          return;
        void this.copy(event.currentTarget as HTMLAnchorElement);
      });
    }
    private async copy(link: HTMLAnchorElement) {
      try {
        await navigator.clipboard.writeText(link.href);
      } catch {
        return;
      }
      this.toggleAttribute('data-copied', true);
      clearTimeout(this.timer);
      this.timer = window.setTimeout(() => this.removeAttribute('data-copied'), 2000);
      const name = this.closest('h2, h3')?.getAttribute('aria-label') ?? this.closest('h2, h3')?.textContent?.trim();
      say(name ? `Link to “${name}” copied.` : 'Link copied.');
    }
  }

  // One polite region for every link on the page. It is made when the first
  // link starts, well before a copy, because a region that appears in the
  // same moment as its words is not read.
  let status: HTMLElement | undefined;
  const region = () => {
    if (!status) {
      status = document.createElement('div');
      status.className = 'visually-hidden';
      status.setAttribute('role', 'status');
      document.body.append(status);
    }
    return status;
  };
  const say = (words: string) => {
    const el = region();
    el.textContent = '';
    setTimeout(() => {
      el.textContent = words;
    }, 60);
  };

  if (!customElements.get('section-link')) customElements.define('section-link', SectionLink);
</script>
