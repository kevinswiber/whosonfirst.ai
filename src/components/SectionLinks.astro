---
/**
 * What the links to a page's sections do and how they look. The links are in
 * the page already: src/lib/section-links.ts puts one beside each section
 * heading when the page is built, and pressing it puts that section's address
 * in the address bar, with or without this script. The script adds one thing:
 * the same press also copies the address, and says so.
 */
---

<style is:global>
  .section-link {
    position: relative;
    margin-inline-start: 0.4em;
    font-size: 0.65em;
    line-height: 1;
    white-space: nowrap;
  }
  /* The link is a small icon with room around it to press: the room is taken
     back in the margin, so the heading is no taller for it. */
  .section-link a {
    padding: 0.3em 0.5em;
    margin: -0.3em -0.5em;
    border-radius: var(--radius);
    color: var(--fg-subtle);
    text-decoration: none;
  }
  .section-link a:hover {
    color: var(--accent);
  }
  /* A little under the height of the heading's capitals, level with their middle */
  .section-link svg {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.1em;
  }
  /* What pressing it does, said beside it: to the right on the same line, or
     below it where the script finds no room, and out of the flow either way,
     so that it takes no room in the heading and cannot wrap it or widen the
     page. Without the script a press only goes to the section, and the icon
     says nothing more than its name. With it, a press copies. */
  .section-link a::after {
    position: absolute;
    left: calc(100% + 0.9rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    font-family: var(--font-mono);
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
    pointer-events: none;
    display: none;
  }
  .section-link[data-below] a::after {
    left: auto;
    right: 0;
    top: calc(100% + 0.8rem);
    transform: none;
  }
  @media (hover: hover) {
    .section-link[data-ready] a:is(:hover, :focus-visible)::after {
      content: "Copy link";
      content: "Copy link" / "";
      display: block;
    }
  }
  .section-link[data-copied][data-ready] a::after {
    content: "Copied";
    content: "Copied" / "";
    display: block;
  }
  /* With a pointer the mark waits until the heading is pointed at, reached by
     keyboard or arrived at. Where there is none to point with it is always
     there, and a little larger to press. */
  @media (hover: hover) {
    .section-link {
      opacity: 0;
    }
    :is(h2, h3):is(:hover, :focus-within, :target) > .section-link,
    .section-link[data-copied] {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .section-link {
      transition: opacity 0.12s;
    }
  }
  @media (pointer: coarse) {
    .section-link {
      font-size: 0.8em;
    }
    .section-link a {
      padding: 0.6em 0.7em;
      margin: -0.6em -0.7em;
    }
  }
  @media print {
    .section-link {
      display: none;
    }
  }
</style>

<script>
  // Without a clipboard, or when it refuses, the link is what it is without a
  // script: it goes to the section. A press with a modifier is left to the
  // browser, which opens it somewhere else.
  class SectionLink extends HTMLElement {
    private timer = 0;
    connectedCallback() {
      region();
      // from here a press copies, and the label beside the chain may say so
      this.toggleAttribute('data-ready', true);
      const link = this.querySelector('a');
      for (const type of ['pointerenter', 'focusin']) link?.addEventListener(type, () => this.place());
      link?.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey)
          return;
        void this.copy(event.currentTarget as HTMLAnchorElement);
      });
    }
    // The label goes to the right of the icon when the window has room for it
    // there, and below when it has not.
    private place() {
      const rem = Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
      this.toggleAttribute('data-below', document.documentElement.clientWidth - this.getBoundingClientRect().right < 9 * rem);
    }
    private async copy(link: HTMLAnchorElement) {
      try {
        await navigator.clipboard.writeText(link.href);
      } catch {
        return;
      }
      this.place();
      this.toggleAttribute('data-copied', true);
      clearTimeout(this.timer);
      this.timer = window.setTimeout(() => this.removeAttribute('data-copied'), 2000);
      const name = this.closest('h2, h3')?.getAttribute('aria-label') ?? this.closest('h2, h3')?.textContent?.trim();
      say(name ? `Link to “${name}” copied.` : 'Link copied.');
    }
  }

  // One polite region for every link on the page. It is made when the first
  // link starts, well before a copy, because a region that appears in the
  // same moment as its words is not read.
  let status: HTMLElement | undefined;
  const region = () => {
    if (!status) {
      status = document.createElement('div');
      status.className = 'visually-hidden';
      status.setAttribute('role', 'status');
      document.body.append(status);
    }
    return status;
  };
  const say = (words: string) => {
    const el = region();
    el.textContent = '';
    setTimeout(() => {
      el.textContent = words;
    }, 60);
  };

  if (!customElements.get('section-link')) customElements.define('section-link', SectionLink);
</script>
