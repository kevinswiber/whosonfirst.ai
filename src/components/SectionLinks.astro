---
/**
 * What the links to a page's sections do and how they look. The links are in
 * the page already: src/lib/section-links.ts puts one beside each section
 * heading when the page is built, and pressing it puts that section's address
 * in the address bar, with or without this script. The script adds one thing:
 * the same press also copies the address, and says so.
 *
 * The link is the last thing in its heading, and where the window is wider than
 * 40rem, as wide as the page's other layouts treat as a desk, it is set in the
 * margin to the left of the heading, as GitHub sets its own. Below that the
 * page's side padding is too narrow to hold it, and it stays after the text.
 */
---

<style is:global>
  .section-link {
    position: relative;
    margin-inline-start: 0.4em;
    font-size: 0.65em;
    line-height: 1;
    white-space: nowrap;
  }
  /* The link is a small icon with room around it to press: the room is taken
     back in the margin, so the heading is no taller for it. */
  .section-link a {
    padding: 0.3em 0.5em;
    margin: -0.3em -0.5em;
    border-radius: var(--radius);
    color: var(--fg-subtle);
    text-decoration: none;
  }
  .section-link a:hover {
    color: var(--accent);
  }
  /* A little under the height of the heading's capitals, level with their middle */
  .section-link svg {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.1em;
  }
  /* The word "Copied", said under the icon for a moment after a press that
     copied the address. It is out of the flow and ends where the icon does, so
     that it takes no room in the heading and cannot wrap it or widen the page.
     It is only generated content: the polite status line says it to a screen
     reader. Nothing is said on hover or focus, since the icon says enough. */
  .section-link a::after {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    z-index: 2;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
    pointer-events: none;
    display: none;
  }
  .section-link[data-copied] a::after {
    content: "Copied";
    content: "Copied" / "";
    display: block;
  }
  /* With a pointer the icon waits until the heading is pointed at or reached by
     keyboard. A heading that was linked to does not show it: where the link
     led is already plain. Where there is no pointer to point with, the icon is
     always there, and a little larger to press. */
  @media (hover: hover) {
    .section-link {
      opacity: 0;
    }
    :is(h2, h3):is(:hover, :focus-within) > .section-link,
    .section-link[data-copied] {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .section-link {
      transition: opacity 0.12s;
    }
  }
  @media (pointer: coarse) {
    .section-link {
      font-size: 0.8em;
    }
    .section-link a {
      padding: 0.6em 0.7em;
      margin: -0.6em -0.7em;
    }
  }
  /* From 40rem the margin of the page is wide enough to hold the icon. The
     heading becomes the box the link is set against, and the link is taken out
     of the flow: one em of the heading wide, ending where the heading begins,
     and as high as its first line, so that the text does not move and loses no
     room, and no layout moves with the window's width. The icon has the right
     of that box and the gap to the text is what is left. --section-link-top is
     what a heading has above its first line, which only a few have. */
  @media (min-width: 40.01rem) {
    :is(h2, h3):has(> .section-link) {
      position: relative;
    }
    .section-link {
      position: absolute;
      right: 100%;
      top: var(--section-link-top, 0px);
      box-sizing: border-box;
      width: 1em;
      height: 1lh;
      margin: 0;
      font-size: 1em;
      line-height: inherit;
    }
    .section-link a {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      height: 100%;
      padding: 0 0.3em;
      margin: 0 -0.3em;
    }
    .section-link svg {
      flex: none;
      width: 0.65em;
      height: 0.65em;
      margin-inline-end: 0.3em;
      vertical-align: baseline;
    }
    .section-link a::after {
      right: auto;
      left: 0;
      top: calc(100% + 0.35rem);
    }
  }
  @media (min-width: 40.01rem) and (pointer: coarse) {
    .section-link svg {
      width: 0.75em;
      height: 0.75em;
      margin-inline-end: 0.2em;
    }
  }
  @media print {
    .section-link {
      display: none;
    }
  }
</style>

<script>
  // Without a clipboard, or when it refuses, the link is what it is without a
  // script: it goes to the section. A press with a modifier is left to the
  // browser, which opens it somewhere else.
  class SectionLink extends HTMLElement {
    private timer = 0;
    connectedCallback() {
      region();
      const link = this.querySelector('a');
      link?.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey)
          return;
        void this.copy(event.currentTarget as HTMLAnchorElement);
      });
    }
    private async copy(link: HTMLAnchorElement) {
      try {
        await navigator.clipboard.writeText(link.href);
      } catch {
        return;
      }
      this.toggleAttribute('data-copied', true);
      clearTimeout(this.timer);
      this.timer = window.setTimeout(() => this.removeAttribute('data-copied'), 2000);
      const name = this.closest('h2, h3')?.getAttribute('aria-label') ?? this.closest('h2, h3')?.textContent?.trim();
      say(name ? `Link to “${name}” copied.` : 'Link copied.');
    }
  }

  // One polite region for every link on the page. It is made when the first
  // link starts, well before a copy, because a region that appears in the
  // same moment as its words is not read.
  let status: HTMLElement | undefined;
  const region = () => {
    if (!status) {
      status = document.createElement('div');
      status.className = 'visually-hidden';
      status.setAttribute('role', 'status');
      document.body.append(status);
    }
    return status;
  };
  const say = (words: string) => {
    const el = region();
    el.textContent = '';
    setTimeout(() => {
      el.textContent = words;
    }, 60);
  };

  if (!customElements.get('section-link')) customElements.define('section-link', SectionLink);
</script>
