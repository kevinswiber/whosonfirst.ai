---
/**
 * A scenario with nothing to choose: every variation is a row, every question
 * a column, and each cell is a verdict. It is for a place where the comparison
 * is the point and the reader has not yet decided to read, as on the home page.
 * The lesson that owns the scenario shows it in full, one variation at a time,
 * with the reasons; this figure leads there.
 *
 * The cells are tinted by their verdict, so the grid reads as a pattern before
 * any of it is read as words: the last row here is the one with no gap in it.
 * Each cell still says its verdict as a word, with a mark of its own shape.
 *
 * Under each variation's name is the one line that sets its request apart: the
 * first line of its first listing that no other variation's listing has.
 *
 * The sentence above the table stands in for the lesson's drawing of who is
 * involved. Each party is tinted there as its box is in the drawing, where the
 * sentence first names it.
 */
import type { Scenario } from "../data/learn/types";
import { VERDICT_WORD } from "../data/learn/types";
import { inline } from "../lib/md";

interface Props {
  scenario: Scenario;
  title: string;
  /** The situation, in a sentence or two, naming each of the scenario's cast. md-lite. */
  setup: string;
  /** What the table adds up to. md-lite. */
  so: string;
  /** The way on, to where the reasons are, and how long that takes. */
  more: { href: string; text: string; note?: string };
}
const { scenario: s, title, setup, so, more } = Astro.props;

const lines = (o: (typeof s.options)[number]) =>
  (o.exhibits?.[0]?.text ?? "").trim().split("\n");
const rows = s.options.map((o) => {
  if (o.findings.some((f) => !f.verdict))
    throw new Error(
      `scenario "${s.id}", option "${o.id}": a glance needs a verdict for every question`,
    );
  const others = s.options.filter((p) => p !== o).flatMap(lines);
  return { o, sends: lines(o).find((l) => l && !others.includes(l)) };
});

let told = inline(setup);
for (const a of s.cast) {
  const name = new RegExp(
    `\\b${a.label.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\b`,
    "i",
  );
  if (!name.test(told))
    throw new Error(
      `scenario "${s.id}": the glance's setup does not name "${a.label}"`,
    );
  told = told.replace(
    name,
    (m) => `<span class="ag-who role-${a.role}">${m}</span>`,
  );
}
---

<figure class="ag">
  <p class="ag-title">{title}</p>
  <p class="ag-setup" set:html={told} />
  <table>
    <thead>
      <tr>
        <th scope="col">{s.legend}</th>
        {s.questions.map((q) => <th scope="col">{q}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ o, sends }) => (
          <tr>
            <th scope="row">
              <span class="ag-name">{o.name}</span>
              {sends && (
                <span class="ag-sends">
                  <code>{sends}</code>
                </span>
              )}
            </th>
            {o.findings.map((f, k) => (
              <td class={`is-${f.verdict}`} data-q={s.questions[k]}>
                <span class="ag-mark">{f.verdict && VERDICT_WORD[f.verdict]}</span>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="ag-so" set:html={inline(so)} />
  <p class="ag-more">
    <a class="btn primary" href={more.href}>{more.text}</a>
    {more.note && <span class="ag-note">{more.note}</span>}
  </p>
</figure>

<style>
  .ag {
    margin: 0;
    background: var(--bg-raised);
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    padding: 1.2rem 1.25rem 1.3rem;
    color: var(--fg);
  }
  /* a label, as the one over the page's title is: the title is the only heading here */
  .ag-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .ag-setup {
    margin: 0 0 1.1rem;
    max-width: 34rem;
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .ag-setup :global(.ag-who) {
    padding: 0.12em 0.4em;
    border: 1px solid var(--role);
    border-radius: var(--radius);
    background: var(--role-soft);
    font-weight: 500;
    white-space: nowrap;
  }

  /* One grid for the whole table, so every cell in a column is the same width
     and every cell in a row the same height. The rows and the two groups of
     rows lay nothing out themselves. */
  table {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(3, minmax(0, 6.4rem));
    gap: 0.3rem;
    margin: 0;
    width: 100%;
  }
  thead,
  tbody,
  tr {
    display: contents;
  }
  th,
  td {
    display: block;
    border: 0;
    padding: 0;
    min-width: 0;
  }
  thead th {
    align-self: end;
    padding: 0 0.6rem 0.3rem;
    white-space: normal;
    line-height: 1.25;
  }
  thead th:first-child {
    padding-left: 0;
  }
  /* the questions are the page's own, so they are set as words and not as labels */
  thead th + th {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
  }
  tbody th {
    align-self: center;
    padding: 0.55rem 0.8rem 0.55rem 0;
    font-family: var(--font-body);
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    white-space: normal;
  }
  .ag-name {
    display: block;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .ag-sends {
    display: block;
    margin-top: 0.15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  code {
    padding: 0;
    background: none;
    font-size: 0.76rem;
    font-weight: 400;
    color: var(--fg-muted);
    white-space: inherit;
    overflow-wrap: normal;
  }

  /* a verdict fills its cell with its own tint */
  tbody td {
    display: flex;
    align-items: center;
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius);
    background: var(--tint);
    color: var(--hue);
  }
  /* the verdict is a word first; shape and color repeat it */
  .ag-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ag-mark::before {
    content: '';
    width: 0.72em;
    height: 0.72em;
    flex: none;
    border-radius: 50%;
  }
  .is-yes {
    --hue: var(--green);
    --tint: var(--green-soft);
  }
  .is-yes .ag-mark::before {
    background: currentColor;
  }
  .is-no {
    --hue: var(--red);
    --tint: var(--red-soft);
  }
  .is-no .ag-mark::before {
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .is-partly {
    --hue: var(--amber);
    --tint: var(--amber-soft);
  }
  .is-partly .ag-mark::before {
    box-shadow: inset 0 0 0 1.5px currentColor;
    background: linear-gradient(to right, currentColor 50%, transparent 50%);
  }
  .is-skipped {
    --hue: var(--fg-muted);
    --tint: var(--bg-sunken);
  }
  .is-skipped .ag-mark::before {
    height: 1.5px;
    border-radius: 0;
    background: currentColor;
  }

  .ag-so {
    margin: 1.1rem 0 0;
    max-width: 38rem;
    font-size: 1.02rem;
  }
  .ag-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin: 0.9rem 0 0;
  }
  .ag-more .btn::after {
    content: '→';
  }
  .ag-note {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  /* On a phone four columns would crowd the names. So each variation is a block:
     its name, then every question on a tinted line of its own, beside its answer.
     The column headings are still there for a screen reader; each cell repeats its own. */
  @media (max-width: 34rem) {
    table {
      grid-template-columns: minmax(0, 1fr);
    }
    thead {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tbody th {
      padding: 0.9rem 0 0.25rem;
    }
    tbody tr:first-child th {
      padding-top: 0;
    }
    tbody td {
      justify-content: space-between;
      gap: 1rem;
      padding: 0.42rem 0.7rem;
    }
    tbody td::before {
      content: attr(data-q);
      font-size: 0.94rem;
      color: var(--fg);
    }
  }
</style>
