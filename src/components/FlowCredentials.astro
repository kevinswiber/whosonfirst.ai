---
import type { Flow } from "../data/types";
import type { Gloss } from "../lib/gloss";
import { inline } from "../lib/md";

interface Props {
  credentials: NonNullable<Flow["credentials"]>;
  gloss?: Gloss;
}
const { credentials, gloss } = Astro.props;
---

<section aria-labelledby="credentials" class="credentials">
  <h2 id="credentials">{credentials.title}</h2>
  <p class="prose" set:html={inline(credentials.intro, gloss)} />
  <div class="credential-grid">
    {credentials.items.map((item, index) => (
      <div class="credential">
        <p class="credential-number">{String(index + 1).padStart(2, '0')}</p>
        <h3>{item.name}</h3>
        <p class="token-type"><code>{item.type}</code></p>
        <p class="meaning" set:html={inline(item.meaning, gloss)} />
        <dl>
          <div><dt>Signed by</dt><dd>{item.issuer}</dd></div>
          <div><dt>Presented to</dt><dd>{item.recipient}</dd></div>
          <div><dt>Bound by</dt><dd>{item.binding}</dd></div>
        </dl>
      </div>
    ))}
  </div>
</section>

<style>
  .credentials { margin-top: clamp(2.5rem, 5vw, 3.75rem); }
  h2 { margin: 0 0 0.8rem; }
  .credential-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1.5px solid var(--fg);
    margin-top: 1.5rem;
  }
  .credential {
    padding: 1.25rem 1.5rem 1.5rem 0;
    border-bottom: 1px solid var(--border);
    min-width: 0;
  }
  .credential:nth-child(even) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }
  .credential-number {
    font-family: var(--font-mono);
    color: var(--fg-muted);
    margin: 0 0 0.35rem;
  }
  h3 { margin: 0; font-size: 1.2rem; }
  .token-type { margin: 0.35rem 0 0.75rem; overflow-wrap: anywhere; }
  .meaning { margin: 0 0 1rem; max-width: 65ch; }
  dl { margin: 0; }
  dl > div { margin-top: 0.6rem; }
  dt { font-weight: 600; }
  dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 44rem) {
    .credential-grid { grid-template-columns: minmax(0, 1fr); }
    .credential, .credential:nth-child(even) {
      padding: 1.25rem 0;
      border-left: 0;
    }
  }
</style>
